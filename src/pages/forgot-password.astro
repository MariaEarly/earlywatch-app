---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Early Watch — Mot de passe oublié">
  <p style="font-size:13px;color:var(--mute);line-height:1.6;margin-bottom:24px">
    Entrez votre email pour recevoir un lien de réinitialisation.
  </p>
  <form id="reset-form">
    <div class="ew-field">
      <label class="ew-label" for="email">Email</label>
      <input class="ew-input" type="email" id="email" autocomplete="email" required>
    </div>
    <button type="submit" class="ew-login-btn" id="btn">Envoyer le lien</button>
  </form>
  <div id="msg" style="font-size:13px;margin-top:16px;line-height:1.6;display:none"></div>
  <div style="margin-top:20px;text-align:center;font-size:12px">
    <a href={`${import.meta.env.BASE_URL}login`} style="color:var(--taupe);text-decoration:none">&larr; Retour à la connexion</a>
  </div>

  <script>
    import { API } from '../scripts/api';

    document.getElementById('reset-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn') as HTMLButtonElement;
      const msg = document.getElementById('msg')!;
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();

      btn.disabled = true;
      btn.textContent = 'Envoi\u2026';
      msg.style.display = 'none';

      try {
        await fetch(`${API}/api/v1/auth/forgot-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        msg.textContent = 'Si ce compte existe, un email de réinitialisation a été envoyé. Vérifiez votre boîte de réception.';
        msg.style.color = 'var(--taupe)';
        msg.style.display = 'block';
        document.getElementById('reset-form')!.style.display = 'none';

      } catch (ex) {
        msg.textContent = 'Erreur de connexion au serveur.';
        msg.style.color = 'var(--color-error)';
        msg.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Envoyer le lien';
      }
    });
  </script>
</AuthLayout>
