---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Early Watch — Procedures" activePage="procedure">
  <div class="flex">
    <div style="width:400px; min-width:400px; border-right:1.5px solid var(--noir, var(--color-border-tertiary)); height:calc(100vh - 52px); overflow-y:auto; padding:24px; background:var(--beige, var(--color-background-primary))">

      <div class="flex gap-4" style="margin-bottom:20px">
        <button id="tab-scratch" class="btn btn-sm" style="flex:1; border-radius:20px">
          Generer from scratch
        </button>
        <button id="tab-gap" class="btn btn-sm" style="flex:1; border-radius:20px">
          Mettre a jour
        </button>
      </div>

      <div id="form-scratch">
        <h2 style="margin-bottom:4px">Generer une procedure</h2>
        <p class="text-xs text-tertiary" style="margin-bottom:16px">
          Pas de procedure existante ? Repondez au questionnaire, on genere une procedure operationnelle complete.
        </p>

        <div style="margin-bottom:16px">
          <label for="textId">Identifiant Legifrance</label>
          <input id="textId" class="input" placeholder="ex: cmf, LEGITEXT000..." value="cmf">
          <p class="text-xs text-tertiary" style="margin-top:4px">
            <strong>cmf</strong> = Code monetaire et financier
          </p>
        </div>

        <div style="margin-bottom:16px">
          <label for="profile">Profil reglementaire</label>
          <select id="profile" class="select">
            <option value="banque">Banque (Etablissement de credit)</option>
            <option value="psp">PSP (Prestataire de services de paiement)</option>
            <option value="casp">CASP (Crypto-actifs / PSAN)</option>
          </select>
        </div>

        <div style="margin-bottom:16px">
          <label for="teamSize">Equipe compliance</label>
          <select id="teamSize" class="select">
            <option value="solo">1 personne (RCSI seul)</option>
            <option value="small">2-5 personnes</option>
            <option value="medium">6-15 personnes</option>
            <option value="large">16+ personnes</option>
          </select>
        </div>

        <div style="margin-bottom:16px">
          <label for="tools">Outils KYC / screening utilises</label>
          <input id="tools" class="input" placeholder="ex: Ondorse, ComplyAdvantage, World-Check...">
        </div>

        <div style="margin-bottom:16px">
          <label for="clientTypes">Types de clients</label>
          <select id="clientTypes" class="select">
            <option value="b2c">B2C (particuliers)</option>
            <option value="b2b">B2B (entreprises)</option>
            <option value="mixte">Mixte B2B + B2C</option>
          </select>
        </div>

        <div style="margin-bottom:16px">
          <label for="products">Produits / services proposes</label>
          <input id="products" class="input" placeholder="ex: paiement, credit, epargne, crypto...">
        </div>

        <div style="margin-bottom:20px">
          <label for="channel">Canal d'entree en relation</label>
          <select id="channel" class="select">
            <option value="digital">100% digital</option>
            <option value="face">Face a face</option>
            <option value="mixte">Mixte</option>
          </select>
        </div>

        <button class="btn btn-primary" id="generateBtn" style="width:100%; border-radius:20px">
          Generer la procedure
        </button>
      </div>

      <div id="form-gap" style="display:none">
        <h2 style="margin-bottom:4px">Mettre a jour une procedure</h2>
        <p class="text-xs text-tertiary" style="margin-bottom:16px">
          Uploadez votre procedure existante. On l'analyse vs les obligations reglementaires et on identifie les ecarts.
        </p>

        <div style="margin-bottom:16px">
          <label for="gapTextId">Identifiant Legifrance</label>
          <input id="gapTextId" class="input" placeholder="ex: cmf, LEGITEXT000..." value="cmf">
        </div>

        <div style="margin-bottom:16px">
          <label for="gapProfile">Profil reglementaire</label>
          <select id="gapProfile" class="select">
            <option value="banque">Banque (Etablissement de credit)</option>
            <option value="psp">PSP (Prestataire de services de paiement)</option>
            <option value="casp">CASP (Crypto-actifs / PSAN)</option>
          </select>
        </div>

        <div style="margin-bottom:20px">
          <label for="gapFile">Procedure existante (PDF, DOCX ou TXT)</label>
          <div id="drop-zone" style="border:1.5px dashed var(--noir, var(--color-border-primary)); border-radius:12px; padding:24px; text-align:center; cursor:pointer; transition: background 0.15s">
            <input id="gapFile" type="file" accept=".pdf,.docx,.doc,.txt" style="display:none">
            <div id="drop-label">
              <div style="font-size:24px; margin-bottom:8px">&#128196;</div>
              <p class="text-sm">Glissez un fichier ici ou <strong>cliquez</strong></p>
              <p class="text-xs text-tertiary">PDF, DOCX ou TXT &middot; Max 10 Mo</p>
            </div>
          </div>
        </div>

        <button class="btn btn-primary" id="gapBtn" style="width:100%; border-radius:20px" disabled>
          Lancer le gap analysis
        </button>
      </div>

      <div id="generate-error" style="display:none; margin-top:12px" class="warning-box"></div>

      <div style="margin-top:32px; padding-top:20px; border-top:1.5px solid var(--noir, var(--color-border-tertiary))">
        <h3 style="margin-bottom:12px">Procedures generees</h3>
        <div id="procedure-list">
          <div class="loading-overlay" style="padding:20px"><div class="spinner"></div></div>
        </div>
      </div>
    </div>

    <main class="content-main" id="result-area">
      <div class="empty-state" style="height:100%">
        <div class="icon">&#128221;</div>
        <p>Choisissez un mode et configurez les parametres</p>
        <p class="text-xs text-tertiary" style="margin-top:8px">
          <strong>From scratch</strong> &mdash; generation complete a partir de vos reponses<br>
          <strong>Mise a jour</strong> &mdash; gap analysis de votre procedure existante
        </p>
      </div>
    </main>
  </div>
</AppLayout>

<script>
  import { api, toast, statusBadge, renderMarkdown, initExpandables, formatDate, API } from '../scripts/api';

  let procedures: any[] = [];
  let mode: string = 'scratch';
  let selectedFile: File | null = null;

  function escHtml(s: string): string {
    if (!s) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function switchMode(m: string): void {
    mode = m;
    document.getElementById('form-scratch')!.style.display = m === 'scratch' ? 'block' : 'none';
    document.getElementById('form-gap')!.style.display = m === 'gap' ? 'block' : 'none';
    const tabS: HTMLElement = document.getElementById('tab-scratch')!;
    const tabG: HTMLElement = document.getElementById('tab-gap')!;
    if (m === 'scratch') {
      tabS.style.background = 'var(--kaki, var(--color-accent))';
      tabS.style.color = 'var(--beige, #fff)';
      tabS.style.border = '1.5px solid var(--noir, var(--color-accent))';
      tabG.style.background = 'transparent';
      tabG.style.color = 'var(--noir, var(--color-text-primary))';
      tabG.style.border = '1.5px solid var(--noir, var(--color-border-primary))';
    } else {
      tabG.style.background = 'var(--kaki, var(--color-accent))';
      tabG.style.color = 'var(--beige, #fff)';
      tabG.style.border = '1.5px solid var(--noir, var(--color-accent))';
      tabS.style.background = 'transparent';
      tabS.style.color = 'var(--noir, var(--color-text-primary))';
      tabS.style.border = '1.5px solid var(--noir, var(--color-border-primary))';
    }
  }

  // Tab switching
  document.getElementById('tab-scratch')!.addEventListener('click', () => switchMode('scratch'));
  document.getElementById('tab-gap')!.addEventListener('click', () => switchMode('gap'));

  // File handling
  function setFile(f: File): void {
    const allowed: string[] = ['.pdf', '.docx', '.doc', '.txt'];
    const ext: string = '.' + f.name.split('.').pop()!.toLowerCase();
    if (!allowed.includes(ext)) {
      toast('Format non support\u00e9. Utilisez PDF, DOCX ou TXT.', 'error');
      return;
    }
    if (f.size > 10 * 1024 * 1024) {
      toast('Fichier trop volumineux (max 10 Mo).', 'error');
      return;
    }
    selectedFile = f;
    document.getElementById('drop-label')!.innerHTML = `
      <div style="font-size:24px; margin-bottom:8px">&#9989;</div>
      <p class="text-sm fw-500">${escHtml(f.name)}</p>
      <p class="text-xs text-tertiary">${(f.size / 1024).toFixed(0)} Ko &middot; Cliquez pour changer</p>
    `;
    (document.getElementById('gapBtn') as HTMLButtonElement).disabled = false;
  }

  const dropZone: HTMLElement = document.getElementById('drop-zone')!;
  dropZone.addEventListener('click', () => document.getElementById('gapFile')!.click());
  dropZone.addEventListener('dragover', (e: DragEvent) => { e.preventDefault(); dropZone.style.background = 'var(--beige2, var(--color-background-tertiary))'; });
  dropZone.addEventListener('dragleave', () => { dropZone.style.background = ''; });
  dropZone.addEventListener('drop', (e: DragEvent) => { e.preventDefault(); dropZone.style.background = ''; if (e.dataTransfer?.files?.[0]) setFile(e.dataTransfer.files[0]); });
  document.getElementById('gapFile')!.addEventListener('change', (e: any) => { if (e.target.files?.[0]) setFile(e.target.files[0]); });

  // Procedure list
  async function loadProcedures(): Promise<void> {
    try {
      procedures = await api('/api/v1/procedures');
      renderProcedureList();
    } catch (e: any) {
      document.getElementById('procedure-list')!.innerHTML =
        `<p class="text-sm text-tertiary">${e.message}</p>`;
    }
  }

  function renderProcedureList(): void {
    const list: HTMLElement = document.getElementById('procedure-list')!;
    if (!procedures.length) {
      list.innerHTML = '<p class="text-sm text-tertiary">Aucune proc\u00e9dure</p>';
      return;
    }
    list.innerHTML = procedures.map((p: any) => `
      <div class="article-card" style="padding:10px 0; cursor:pointer" data-load-proc="${p.id}">
        <div class="flex items-center justify-between">
          <span class="text-sm fw-500">${escHtml(p.text_id)}</span>
          ${statusBadge(p.status)}
        </div>
        <div class="text-xs text-tertiary" style="margin-top:2px">
          ${escHtml(p.profile)} &middot; ${p.obligation_count} obligations &middot; ${formatDate(p.created_at)}
        </div>
      </div>
    `).join('');
    list.querySelectorAll('[data-load-proc]').forEach((el: any) => {
      el.addEventListener('click', () => loadProcedure(el.dataset.loadProc));
    });
  }

  // Generate from scratch
  document.getElementById('generateBtn')!.addEventListener('click', async () => {
    const btn: HTMLButtonElement = document.getElementById('generateBtn') as HTMLButtonElement;
    const errEl: HTMLElement = document.getElementById('generate-error')!;
    errEl.style.display = 'none';

    const textId: string = (document.getElementById('textId') as HTMLInputElement).value.trim();
    const profile: string = (document.getElementById('profile') as HTMLSelectElement).value;
    if (!textId) {
      errEl.innerHTML = '<span>&#9888;</span> Identifiant Legifrance requis';
      errEl.style.display = 'flex';
      return;
    }

    const teamSize: string = (document.getElementById('teamSize') as HTMLSelectElement).value;
    const tools: string = (document.getElementById('tools') as HTMLInputElement).value.trim();
    const clientTypes: string = (document.getElementById('clientTypes') as HTMLSelectElement).value;
    const products: string = (document.getElementById('products') as HTMLInputElement).value.trim();
    const channel: string = (document.getElementById('channel') as HTMLSelectElement).value;

    const contextParts: string[] = [];
    const teamLabels: any = { solo: '1 personne (RCSI seul)', small: '2-5 personnes', medium: '6-15 personnes', large: '16+ personnes' };
    contextParts.push(`\u00c9quipe compliance : ${teamLabels[teamSize]}`);
    if (tools) contextParts.push(`Outils KYC/screening : ${tools}`);
    const clientLabels: any = { b2c: 'B2C (particuliers)', b2b: 'B2B (entreprises)', mixte: 'Mixte B2B + B2C' };
    contextParts.push(`Types de clients : ${clientLabels[clientTypes]}`);
    if (products) contextParts.push(`Produits/services : ${products}`);
    const channelLabels: any = { digital: '100% digital', face: 'Face \u00e0 face', mixte: 'Mixte' };
    contextParts.push(`Canal d'entr\u00e9e en relation : ${channelLabels[channel]}`);
    const clientContext: string = contextParts.join('\n');

    btn.disabled = true;
    btn.innerHTML = '<div class="spinner" style="width:14px;height:14px;border-width:1.5px"></div> G\u00e9n\u00e9ration en cours...';
    showLoading('Extraction des obligations depuis Legifrance...');

    try {
      const body: any = { text_id: textId, tenant_profile: profile, client_context: clientContext };
      const result: any = await api('/api/v1/procedures/generate', { method: 'POST', body });
      renderResult(result);
      toast('Proc\u00e9dure g\u00e9n\u00e9r\u00e9e avec succ\u00e8s');
      loadProcedures();
    } catch (e: any) {
      showError(e.message, errEl);
    } finally {
      btn.disabled = false;
      btn.textContent = 'G\u00e9n\u00e9rer la proc\u00e9dure';
    }
  });

  // Generate gap analysis
  document.getElementById('gapBtn')!.addEventListener('click', async () => {
    const btn: HTMLButtonElement = document.getElementById('gapBtn') as HTMLButtonElement;
    const errEl: HTMLElement = document.getElementById('generate-error')!;
    errEl.style.display = 'none';

    if (!selectedFile) {
      errEl.innerHTML = '<span>&#9888;</span> Aucun fichier s\u00e9lectionn\u00e9';
      errEl.style.display = 'flex';
      return;
    }

    const textId: string = (document.getElementById('gapTextId') as HTMLInputElement).value.trim();
    const profile: string = (document.getElementById('gapProfile') as HTMLSelectElement).value;
    if (!textId) {
      errEl.innerHTML = '<span>&#9888;</span> Identifiant Legifrance requis';
      errEl.style.display = 'flex';
      return;
    }

    btn.disabled = true;
    btn.innerHTML = '<div class="spinner" style="width:14px;height:14px;border-width:1.5px"></div> Analyse en cours...';
    showLoading('Upload du document et analyse des \u00e9carts...');

    try {
      const formData: FormData = new FormData();
      formData.append('file', selectedFile);
      formData.append('text_id', textId);
      formData.append('profile', profile);

      const token: string | null = sessionStorage.getItem('ew_token');
      const r: Response = await fetch(`${API}/api/v1/gap-analysis/procedure`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
        body: formData,
      });
      if (!r.ok) {
        const errData: any = await r.json().catch(() => ({}));
        throw new Error(errData.detail || `Erreur ${r.status}`);
      }
      const result: any = await r.json();
      renderGapResult(result);
      toast('Gap analysis termin\u00e9');
    } catch (e: any) {
      showError(e.message, errEl);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Lancer le gap analysis';
    }
  });

  function showLoading(msg: string): void {
    document.getElementById('result-area')!.innerHTML = `
      <div class="loading-overlay" style="height:100%; flex-direction:column">
        <div class="spinner"></div>
        <p>${msg}</p>
        <p class="text-xs text-tertiary">Cela peut prendre 30 \u00e0 60 secondes</p>
      </div>`;
  }

  function showError(msg: string, errEl: HTMLElement): void {
    errEl.innerHTML = `<span>&#9888;</span> ${escHtml(msg)}`;
    errEl.style.display = 'flex';
    document.getElementById('result-area')!.innerHTML = `
      <div class="empty-state" style="height:100%">
        <div class="icon" style="color:var(--color-danger)">&#10007;</div>
        <p>${escHtml(msg)}</p>
      </div>`;
  }

  async function loadProcedure(id: string): Promise<void> {
    document.getElementById('result-area')!.innerHTML = `
      <div class="loading-overlay" style="height:50%"><div class="spinner"></div></div>`;
    try {
      const result: any = await api(`/api/v1/procedures/${id}`);
      renderResult(result);
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  function renderResult(proc: any): void {
    const content: string = proc.content || '';
    const sections: any[] = parseSections(content);
    const srcsCited: any[] = proc.sources_cited || [];

    document.getElementById('result-area')!.innerHTML = `
      <div style="padding:24px; max-width:800px; margin:0 auto">
        <div class="flex items-center justify-between" style="margin-bottom:20px">
          <div>
            <div class="flex items-center gap-8">
              <h1>Proc\u00e9dure g\u00e9n\u00e9r\u00e9e</h1>
              ${statusBadge(proc.status)}
            </div>
            <p class="text-sm text-secondary" style="margin-top:4px">
              ${proc.profile} &middot; ${proc.obligation_count} obligations &middot; ${proc.model_name || ''}
            </p>
          </div>
          ${proc.status === 'pending_validation' ? `
            <div class="flex gap-8">
              <button class="btn btn-success btn-sm" style="border-radius:20px" data-validate-proc="${proc.id}" data-decision="validated">Valider</button>
              <button class="btn btn-danger btn-sm" style="border-radius:20px" data-validate-proc="${proc.id}" data-decision="rejected">Rejeter</button>
            </div>` : ''}
        </div>

        <div style="margin-bottom:16px">
          <h3 class="text-xs text-tertiary" style="margin-bottom:8px; text-transform:uppercase; letter-spacing:0.5px">Articles cit\u00e9s</h3>
          <div class="flex gap-4" style="flex-wrap:wrap">
            ${srcsCited.map((s: any) => `
              <a href="${s.lien_legifrance || '#'}" target="_blank" rel="noopener"
                 class="badge badge-accent" style="text-decoration:none; cursor:pointer"
                 title="${s.legiarti_id || ''}">
                Art. ${escHtml(s.article_number)}
              </a>
            `).join('')}
          </div>
        </div>

        ${sections.map((sec: any, i: number) => `
          <div class="expandable ${i < 4 ? 'open' : ''}">
            <button class="expandable-header">
              <span>${escHtml(sec.title)}</span>
              <span class="arrow">&#9654;</span>
            </button>
            <div class="expandable-body">
              <div class="md-content">${renderMarkdown(sec.content)}</div>
            </div>
          </div>
        `).join('')}

        <div class="warning-box" style="margin-top:20px">
          <span>&#9888;</span>
          <div>
            <strong>Avertissement Compliance Officer</strong><br>
            Ce document est un PROJET g\u00e9n\u00e9r\u00e9 automatiquement par IA \u00e0 partir de sources Legifrance.
            Il DOIT \u00eatre valid\u00e9 par le Compliance Officer avant toute mise en application.
          </div>
        </div>
        <p class="text-xs text-tertiary" style="margin-top:12px">${escHtml(proc.provenance || '')}</p>
      </div>`;
    initExpandables();

    document.querySelectorAll('[data-validate-proc]').forEach((btn: any) => {
      btn.addEventListener('click', () => validateProc(btn.dataset.validateProc, btn.dataset.decision));
    });
  }

  function renderGapResult(report: any): void {
    const gaps: any[] = report.gaps || [];
    const covered: number = gaps.filter((g: any) => g.status === 'covered').length;
    const partial: number = gaps.filter((g: any) => g.status === 'partial').length;
    const absent: number = gaps.filter((g: any) => g.status === 'absent').length;

    document.getElementById('result-area')!.innerHTML = `
      <div style="padding:24px; max-width:800px; margin:0 auto">
        <div class="flex items-center justify-between" style="margin-bottom:20px">
          <div>
            <div class="flex items-center gap-8">
              <h1>Gap Analysis</h1>
              ${statusBadge(report.status || 'pending_validation')}
            </div>
            <p class="text-sm text-secondary" style="margin-top:4px">
              ${escHtml(report.text_id)} &middot; ${escHtml(report.profile)} &middot; ${gaps.length} obligations analys\u00e9es
            </p>
          </div>
        </div>

        <div class="flex gap-12" style="margin-bottom:24px">
          <div class="stat-card" style="flex:1; text-align:center">
            <div class="stat-value" style="color:var(--kaki, var(--color-success))">${covered}</div>
            <div class="stat-label">Couvertes</div>
          </div>
          <div class="stat-card" style="flex:1; text-align:center">
            <div class="stat-value" style="color:var(--terra, var(--color-warning))">${partial}</div>
            <div class="stat-label">Partielles</div>
          </div>
          <div class="stat-card" style="flex:1; text-align:center">
            <div class="stat-value" style="color:var(--color-danger)">${absent}</div>
            <div class="stat-label">Absentes</div>
          </div>
        </div>

        ${gaps.map((g: any, i: number) => {
          const icon: string = g.status === 'covered' ? '\u2705' : g.status === 'partial' ? '\u26a0\ufe0f' : '\u274c';
          return `
            <div class="expandable ${g.status !== 'covered' ? 'open' : ''}">
              <button class="expandable-header">
                <span>${icon} ${escHtml(g.obligation || g.article || 'Obligation ' + (i + 1))}</span>
                <span class="arrow">&#9654;</span>
              </button>
              <div class="expandable-body">
                <div class="md-content">${renderMarkdown(g.analysis || g.comment || '')}</div>
                ${g.recommendation ? `<div style="margin-top:8px; padding:8px 12px; background:var(--beige2, var(--color-background-tertiary)); border-radius:8px"><strong>Recommandation :</strong> ${escHtml(g.recommendation)}</div>` : ''}
              </div>
            </div>`;
        }).join('')}

        <div class="warning-box" style="margin-top:20px">
          <span>&#9888;</span>
          <div>
            <strong>Avertissement</strong><br>
            Cette analyse est g\u00e9n\u00e9r\u00e9e automatiquement. Elle doit \u00eatre revue par le Compliance Officer.
          </div>
        </div>
      </div>`;
    initExpandables();
  }

  function parseSections(md: string): any[] {
    const lines: string[] = md.split('\n');
    const sections: any[] = [];
    let current: any = null;
    for (const line of lines) {
      const m2: RegExpMatchArray | null = line.match(/^## \d*\.?\s*(.+)/);
      const m1: RegExpMatchArray | null = line.match(/^# (.+)/);
      if (m2) {
        if (current) sections.push(current);
        current = { title: m2[1], content: '' };
      } else if (m1 && !current) {
        if (current) sections.push(current);
        current = { title: m1[1], content: '' };
      } else if (current) {
        current.content += line + '\n';
      }
    }
    if (current) sections.push(current);
    if (sections.length === 0) sections.push({ title: 'Proc\u00e9dure', content: md });
    return sections;
  }

  async function validateProc(id: string, decision: string): Promise<void> {
    const comment: string | null = decision === 'rejected' ? prompt('Raison du rejet (optionnel):') : null;
    try {
      const body: any = { decision };
      if (comment) body.comment = comment;
      const result: any = await api(`/api/v1/procedures/${id}/validate`, { method: 'POST', body });
      renderResult(result);
      toast(decision === 'validated' ? 'Proc\u00e9dure valid\u00e9e' : 'Proc\u00e9dure rejet\u00e9e');
      loadProcedures();
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  switchMode('scratch');
