---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Early Watch — Procédures" activePage="procedure">
  <div class="proc-layout">
    <div class="proc-left">

      <!-- Two entry paths -->
      <div class="proc-tabs">
        <button id="tab-scratch" class="proc-tab active">Je pars de zéro</button>
        <button id="tab-gap" class="proc-tab">J'ai déjà une procédure</button>
      </div>

      <!-- PATH 1: From scratch -->
      <div id="form-scratch">

        <!-- Step 1 — Profile -->
        <div class="proc-step">
          <div class="proc-step-num">1</div>
          <div class="proc-step-label">Profil réglementaire</div>
        </div>
        <div class="proc-toggle-group" id="profile-toggle">
          <button class="proc-toggle" data-profile="PSP">PSP</button>
          <button class="proc-toggle" data-profile="Banque">Banque</button>
          <button class="proc-toggle" data-profile="CASP">CASP / PSAN</button>
        </div>

        <!-- Step 2 — Thematiques (dynamic) -->
        <div id="step2-wrap" style="display:none">
          <div class="proc-step">
            <div class="proc-step-num">2</div>
            <div class="proc-step-label">Thématiques</div>
          </div>
          <div id="thematiques-list" class="proc-checks"></div>
        </div>

        <!-- Step 3 — Templates -->
        <div id="step3-wrap" style="display:none">
          <div class="proc-step">
            <div class="proc-step-num">3</div>
            <div class="proc-step-label">Procédures à générer</div>
          </div>
          <div id="templates-list" class="proc-templates"></div>
          <button class="btn-generate" id="generateBtn" style="display:none">
            Générer ces procédures
          </button>
        </div>

        <div id="generate-error" class="proc-error" style="display:none"></div>
      </div>

      <!-- PATH 2: Gap analysis -->
      <div id="form-gap" style="display:none">

        <div class="proc-step">
          <div class="proc-step-num">1</div>
          <div class="proc-step-label">Profil réglementaire</div>
        </div>
        <div class="proc-toggle-group" id="gap-profile-toggle">
          <button class="proc-toggle" data-profile="PSP">PSP</button>
          <button class="proc-toggle" data-profile="Banque">Banque</button>
          <button class="proc-toggle" data-profile="CASP">CASP / PSAN</button>
        </div>

        <div class="proc-step" style="margin-top:20px">
          <div class="proc-step-num">2</div>
          <div class="proc-step-label">Procédure existante</div>
        </div>
        <div id="drop-zone" class="proc-dropzone">
          <input id="gapFile" type="file" accept=".pdf,.docx,.doc,.txt" style="display:none">
          <div id="drop-label">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B0ADA7" stroke-width="1.5" style="margin-bottom:8px">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="12" y1="18" x2="12" y2="12"/>
              <polyline points="9 15 12 12 15 15"/>
            </svg>
            <p class="proc-drop-main">Glissez un fichier ici ou <strong>cliquez</strong></p>
            <p class="proc-drop-sub">PDF, DOCX ou TXT &middot; Max 10 Mo</p>
          </div>
        </div>

        <button class="btn-generate" id="gapBtn" disabled style="margin-top:16px">
          Lancer le gap analysis
        </button>

        <div id="gap-error" class="proc-error" style="display:none"></div>
      </div>

      <!-- Procedure list -->
      <div class="proc-list-section">
        <h3 class="proc-list-title">Procédures générées</h3>
        <div id="procedure-list">
          <div class="loading-overlay" style="padding:20px"><div class="spinner"></div></div>
        </div>
      </div>
    </div>

    <main class="proc-right" id="result-area">
      <div class="proc-empty">
        <p class="proc-empty-text">Sélectionnez un mode pour commencer</p>
      </div>
    </main>
  </div>
</AppLayout>

<style>
  .proc-layout {
    display: flex;
    height: calc(100vh - 85px);
  }
  .proc-left {
    width: 420px;
    min-width: 420px;
    border-right: 1px solid #D5D2CB;
    overflow-y: auto;
    padding: 20px 24px;
    background: #EDEAE3;
  }
  .proc-right {
    flex: 1;
    overflow-y: auto;
    background: #EDEAE3;
  }

  /* Tabs */
  .proc-tabs {
    display: flex;
    margin-bottom: 24px;
  }
  .proc-tab {
    flex: 1;
    padding: 10px 12px;
    font-size: 13px;
    font-family: 'IBM Plex Sans', sans-serif;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #6B6860;
    transition: all 0.15s;
  }
  .proc-tab:first-child {
    border-right: 1px solid #D5D2CB;
  }
  .proc-tab.active {
    background: #E6E3DC;
    color: #1A1918;
    font-weight: 500;
  }

  /* Steps */
  .proc-step {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    margin-top: 20px;
  }
  .proc-step:first-child {
    margin-top: 0;
  }
  .proc-step-num {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #5C6347;
    color: #EDEAE3;
    font-size: 11px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .proc-step-label {
    font-size: 13px;
    font-weight: 500;
    color: #1A1918;
  }

  /* Profile toggles */
  .proc-toggle-group {
    display: flex;
    gap: 8px;
    margin-bottom: 4px;
  }
  .proc-toggle {
    flex: 1;
    padding: 8px 12px;
    font-size: 13px;
    font-family: 'IBM Plex Sans', sans-serif;
    border: 1px solid #D5D2CB;
    border-radius: 4px;
    background: transparent;
    color: #3D3B38;
    cursor: pointer;
    transition: all 0.15s;
  }
  .proc-toggle.active {
    background: #5C6347;
    color: #EDEAE3;
    border-color: #5C6347;
  }

  /* Checkboxes */
  .proc-checks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .proc-check-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 6px 8px;
    font-size: 13px;
    color: #3D3B38;
    cursor: pointer;
  }
  .proc-check-item input[type="checkbox"] {
    margin-top: 2px;
    accent-color: #5C6347;
  }
  .proc-check-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .proc-check-name {
    font-size: 13px;
    line-height: 1.3;
  }
  .badge-obligatoire {
    display: inline-block;
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 2px;
    background: #EEF0E8;
    color: #5C6347;
    font-weight: 500;
  }
  .badge-optionnel {
    display: inline-block;
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 2px;
    background: #E8E5DE;
    color: #6B6860;
    font-weight: 500;
  }

  /* Templates list */
  .proc-templates {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }
  .proc-template-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    background: #E8E5DE;
    border-radius: 4px;
  }
  .proc-template-code {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #5C6347;
    font-weight: 500;
    white-space: nowrap;
  }
  .proc-template-name {
    font-size: 13px;
    color: #3D3B38;
    flex: 1;
  }

  /* Generate button */
  .btn-generate {
    width: 100%;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 500;
    font-family: 'IBM Plex Sans', sans-serif;
    background: #5C6347;
    color: #EDEAE3;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .btn-generate:hover {
    opacity: 0.9;
  }
  .btn-generate:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Drop zone */
  .proc-dropzone {
    border: 1px dashed #D5D2CB;
    border-radius: 4px;
    padding: 24px;
    text-align: center;
    cursor: pointer;
    transition: background 0.15s;
  }
  .proc-dropzone:hover,
  .proc-dropzone.dragover {
    background: #E8E5DE;
  }
  .proc-drop-main {
    font-size: 13px;
    color: #3D3B38;
  }
  .proc-drop-sub {
    font-size: 11px;
    color: #B0ADA7;
    margin-top: 4px;
  }

  /* Error */
  .proc-error {
    margin-top: 12px;
    padding: 10px 12px;
    background: #FDF2F2;
    border: 1px solid #E5C5C5;
    border-radius: 4px;
    font-size: 12px;
    color: #8B3A3A;
  }

  /* Procedure list */
  .proc-list-section {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #D5D2CB;
  }
  .proc-list-title {
    font-size: 12px;
    font-weight: 500;
    color: #6B6860;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }

  /* Empty state */
  .proc-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }
  .proc-empty-text {
    font-size: 14px;
    color: #B0ADA7;
  }
</style>

<script>
  import { api, toast, statusBadge, renderMarkdown, initExpandables, formatDate, API } from '../scripts/api';

  // -------------------------------------------------------------------------
  //  State
  // -------------------------------------------------------------------------
  let mode = 'scratch';
  let selectedProfile = '';
  let gapProfile = '';
  let selectedFile: File | null = null;
  let mappingData: any = null;
  let checkedCodes: Set<string> = new Set();
  let procedures: any[] = [];

  const PROC_LABELS: Record<string, string> = {
    'EB-POL-001': 'Politique générale LCB-FT',
    'EB-RISK-001': 'Classification des risques',
    'EB-KYC-001': 'Entrée en relation — Personne physique',
    'EB-KYC-002': 'Entrée en relation — Personne morale',
    'EB-SCR-001': 'Criblage sanctions et PPE',
    'EB-MON-001': 'Monitoring transactionnel',
    'EB-TRC-001': 'Déclaration de soupçon Tracfin',
    'EB-CASP-001': 'LCB-FT spécifique CASP/PSAN',
    'EB-CTRL-001': 'Contrôle permanent LCB-FT',
    'EB-AGT-001': 'Agents et distributeurs',
    'EB-UBO-001': 'Bénéficiaires effectifs',
    'EB-EDD-001': 'Vigilance renforcée',
    'EB-PEP-001': 'Personnes politiquement exposées',
    'EB-SCR-002': 'Criblage sanctions avancé',
    'EB-GEL-001': 'Gel des avoirs',
    'EB-ARCH-001': 'Archivage',
    'EB-TRV-001': 'Transfert de fonds',
    'EB-CBK-001': 'Correspondance bancaire',
    'EB-FORM-001': 'Formation LCB-FT',
  };

  function escHtml(s: string): string {
    if (!s) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // -------------------------------------------------------------------------
  //  Tab switching
  // -------------------------------------------------------------------------
  function switchMode(m: string) {
    mode = m;
    document.getElementById('form-scratch')!.style.display = m === 'scratch' ? 'block' : 'none';
    document.getElementById('form-gap')!.style.display = m === 'gap' ? 'block' : 'none';
    document.querySelectorAll('.proc-tab').forEach(t => t.classList.remove('active'));
    document.getElementById(m === 'scratch' ? 'tab-scratch' : 'tab-gap')!.classList.add('active');
  }

  document.getElementById('tab-scratch')!.addEventListener('click', () => switchMode('scratch'));
  document.getElementById('tab-gap')!.addEventListener('click', () => switchMode('gap'));

  // -------------------------------------------------------------------------
  //  Profile toggle (scratch)
  // -------------------------------------------------------------------------
  document.querySelectorAll('#profile-toggle .proc-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#profile-toggle .proc-toggle').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedProfile = (btn as HTMLElement).dataset.profile || '';
      loadMapping(selectedProfile);
    });
  });

  // -------------------------------------------------------------------------
  //  Profile toggle (gap)
  // -------------------------------------------------------------------------
  document.querySelectorAll('#gap-profile-toggle .proc-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#gap-profile-toggle .proc-toggle').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      gapProfile = (btn as HTMLElement).dataset.profile || '';
    });
  });

  // -------------------------------------------------------------------------
  //  Step 2 — Load mapping from API
  // -------------------------------------------------------------------------
  async function loadMapping(profil: string) {
    console.log('[PROC] loadMapping called with profil:', profil);
    try {
      mappingData = await api(`/api/v1/procedures/mapping?profil=${profil}`);
      console.log('[PROC] mappingData received:', mappingData);
      renderThematiques();
    } catch (e: any) {
      console.error('[PROC] Mapping error:', e);
      document.getElementById('step2-wrap')!.style.display = 'none';
      document.getElementById('step3-wrap')!.style.display = 'none';
    }
  }

  function renderThematiques() {
    if (!mappingData) return;
    const wrap = document.getElementById('step2-wrap')!;
    const list = document.getElementById('thematiques-list')!;
    wrap.style.display = 'block';

    const allItems = [
      ...mappingData.obligatoires.map((o: any) => ({ ...o, type: 'obligatoire' })),
      ...mappingData.contextuels.map((o: any) => ({ ...o, type: 'optionnel' })),
    ];

    checkedCodes = new Set(mappingData.obligatoires.map((o: any) => o.code));

    list.innerHTML = allItems.map((item: any) => {
      const checked = item.type === 'obligatoire' ? 'checked' : '';
      const badge = item.type === 'obligatoire'
        ? '<span class="badge-obligatoire">Obligatoire</span>'
        : '<span class="badge-optionnel">Optionnel</span>';
      return `
        <label class="proc-check-item">
          <input type="checkbox" value="${item.code}" ${checked} data-type="${item.type}">
          <span class="proc-check-label">
            <span class="proc-check-name">${escHtml(item.label)}</span>
            ${badge}
          </span>
        </label>`;
    }).join('');

    // Listen to checkbox changes
    list.querySelectorAll('input[type="checkbox"]').forEach(cb => {
      cb.addEventListener('change', () => {
        updateCheckedCodes();
        renderTemplates();
      });
    });

    renderTemplates();
  }

  function updateCheckedCodes() {
    checkedCodes = new Set();
    document.querySelectorAll('#thematiques-list input[type="checkbox"]:checked').forEach(cb => {
      checkedCodes.add((cb as HTMLInputElement).value);
    });
  }

  // -------------------------------------------------------------------------
  //  Step 3 — Templates
  // -------------------------------------------------------------------------
  function renderTemplates() {
    const wrap = document.getElementById('step3-wrap')!;
    const list = document.getElementById('templates-list')!;
    const btn = document.getElementById('generateBtn')!;

    if (checkedCodes.size === 0) {
      wrap.style.display = 'none';
      return;
    }

    wrap.style.display = 'block';
    btn.style.display = 'block';

    const obligCodes = new Set(mappingData.obligatoires.map((o: any) => o.code));

    const sorted = [...checkedCodes].sort();
    list.innerHTML = sorted.map(code => {
      const label = PROC_LABELS[code] || code;
      const isOblig = obligCodes.has(code);
      const badge = isOblig
        ? '<span class="badge-obligatoire">Obligatoire</span>'
        : '<span class="badge-optionnel">Optionnel</span>';
      return `
        <div class="proc-template-item">
          <span class="proc-template-code">${code}</span>
          <span class="proc-template-name">${escHtml(label)}</span>
          ${badge}
        </div>`;
    }).join('');
  }

  // -------------------------------------------------------------------------
  //  Generate
  // -------------------------------------------------------------------------
  document.getElementById('generateBtn')!.addEventListener('click', async () => {
    const btn = document.getElementById('generateBtn') as HTMLButtonElement;
    const errEl = document.getElementById('generate-error')!;
    errEl.style.display = 'none';

    if (!selectedProfile) {
      errEl.textContent = 'Sélectionnez un profil réglementaire';
      errEl.style.display = 'block';
      return;
    }
    if (checkedCodes.size === 0) {
      errEl.textContent = 'Cochez au moins une thématique';
      errEl.style.display = 'block';
      return;
    }

    btn.disabled = true;
    btn.innerHTML = '<div class="spinner" style="width:14px;height:14px;border-width:1px;display:inline-block;vertical-align:middle;margin-right:8px"></div>Génération en cours\u2026';
    showLoading('Extraction des obligations depuis Legifrance\u2026');

    const thematiques = [...checkedCodes].map(code => PROC_LABELS[code] || code);
    const profileMap: Record<string,string> = { 'PSP': 'psp', 'Banque': 'banque', 'CASP': 'casp' };

    try {
      const body = {
        text_id: 'cmf',
        tenant_profile: profileMap[selectedProfile] || 'banque',
        client_context: `Profil: ${selectedProfile}\nThématiques sélectionnées: ${thematiques.join(', ')}`,
      };
      const result = await api('/api/v1/procedures/generate', { method: 'POST', body });
      renderResult(result);
      toast('Procédure générée avec succès');
      loadProcedures();
    } catch (e: any) {
      errEl.textContent = e.message;
      errEl.style.display = 'block';
      document.getElementById('result-area')!.innerHTML = `
        <div class="proc-empty">
          <p class="proc-empty-text" style="color:#8B3A3A">${escHtml(e.message)}</p>
        </div>`;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Générer ces procédures';
    }
  });

  // -------------------------------------------------------------------------
  //  File handling (gap analysis)
  // -------------------------------------------------------------------------
  function setFile(f: File) {
    const allowed = ['.pdf', '.docx', '.doc', '.txt'];
    const ext = '.' + f.name.split('.').pop()!.toLowerCase();
    if (!allowed.includes(ext)) { toast('Format non supporté. Utilisez PDF, DOCX ou TXT.', 'error'); return; }
    if (f.size > 10 * 1024 * 1024) { toast('Fichier trop volumineux (max 10 Mo).', 'error'); return; }
    selectedFile = f;
    document.getElementById('drop-label')!.innerHTML = `
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5C6347" stroke-width="2" style="margin-bottom:4px"><polyline points="20 6 9 17 4 12"/></svg>
      <p class="proc-drop-main" style="font-weight:500">${escHtml(f.name)}</p>
      <p class="proc-drop-sub">${(f.size / 1024).toFixed(0)} Ko &middot; Cliquez pour changer</p>`;
    (document.getElementById('gapBtn') as HTMLButtonElement).disabled = false;
  }

  const dropZone = document.getElementById('drop-zone')!;
  dropZone.addEventListener('click', () => document.getElementById('gapFile')!.click());
  dropZone.addEventListener('dragover', (e: DragEvent) => { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', (e: DragEvent) => { e.preventDefault(); dropZone.classList.remove('dragover'); if (e.dataTransfer?.files?.[0]) setFile(e.dataTransfer.files[0]); });
  document.getElementById('gapFile')!.addEventListener('change', (e: any) => { if (e.target.files?.[0]) setFile(e.target.files[0]); });

  // -------------------------------------------------------------------------
  //  Gap analysis
  // -------------------------------------------------------------------------
  document.getElementById('gapBtn')!.addEventListener('click', async () => {
    const btn = document.getElementById('gapBtn') as HTMLButtonElement;
    const errEl = document.getElementById('gap-error')!;
    errEl.style.display = 'none';

    if (!selectedFile) { errEl.textContent = 'Aucun fichier sélectionné'; errEl.style.display = 'block'; return; }
    if (!gapProfile) { errEl.textContent = 'Sélectionnez un profil'; errEl.style.display = 'block'; return; }

    btn.disabled = true;
    btn.innerHTML = '<div class="spinner" style="width:14px;height:14px;border-width:1px;display:inline-block;vertical-align:middle;margin-right:8px"></div>Analyse en cours\u2026';
    showLoading('Upload du document et analyse des écarts\u2026');

    const profileMap: Record<string,string> = { 'PSP': 'psp', 'Banque': 'banque', 'CASP': 'casp' };

    try {
      const formData = new FormData();
      formData.append('file', selectedFile);
      formData.append('text_id', 'cmf');
      formData.append('profile', profileMap[gapProfile] || 'banque');

      const token = sessionStorage.getItem('ew_token');
      const r = await fetch(`${API}/api/v1/gap-analysis/procedure`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
        body: formData,
      });
      if (!r.ok) {
        const errData = await r.json().catch(() => ({}));
        throw new Error(errData.detail || `Erreur ${r.status}`);
      }
      const result = await r.json();
      renderGapResult(result);
      toast('Gap analysis terminé');
    } catch (e: any) {
      errEl.textContent = e.message;
      errEl.style.display = 'block';
      document.getElementById('result-area')!.innerHTML = `
        <div class="proc-empty">
          <p class="proc-empty-text" style="color:#8B3A3A">${escHtml(e.message)}</p>
        </div>`;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Lancer le gap analysis';
    }
  });

  // -------------------------------------------------------------------------
  //  Rendering helpers
  // -------------------------------------------------------------------------
  function showLoading(msg: string) {
    document.getElementById('result-area')!.innerHTML = `
      <div style="display:flex; align-items:center; justify-content:center; height:100%; flex-direction:column; gap:12px">
        <div class="spinner"></div>
        <p style="font-size:13px; color:#3D3B38">${msg}</p>
        <p style="font-size:11px; color:#B0ADA7">Cela peut prendre 30 à 60 secondes</p>
      </div>`;
  }

  function renderResult(proc: any) {
    const content = proc.content || '';
    const sections = parseSections(content);
    const srcsCited = proc.sources_cited || [];

    document.getElementById('result-area')!.innerHTML = `
      <div style="padding:24px; max-width:800px; margin:0 auto">
        <div class="flex items-center justify-between" style="margin-bottom:20px">
          <div>
            <div class="flex items-center gap-8">
              <h1 style="font-size:18px">Procédure générée</h1>
              ${statusBadge(proc.status)}
            </div>
            <p style="font-size:12px; color:#6B6860; margin-top:4px">
              ${proc.profile} &middot; ${proc.obligation_count} obligations &middot; ${proc.model_name || ''}
            </p>
          </div>
          ${proc.status === 'pending_validation' ? `
            <div class="flex gap-8">
              <button class="btn btn-success btn-sm" data-validate-proc="${proc.id}" data-decision="validated">Valider</button>
              <button class="btn btn-danger btn-sm" data-validate-proc="${proc.id}" data-decision="rejected">Rejeter</button>
            </div>` : ''}
        </div>

        <div style="margin-bottom:16px">
          <h3 style="font-size:11px; color:#6B6860; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px">Articles cités</h3>
          <div class="flex gap-4" style="flex-wrap:wrap">
            ${srcsCited.map((s: any) => `
              <a href="${s.lien_legifrance || '#'}" target="_blank" rel="noopener"
                 class="badge badge-accent" style="text-decoration:none; cursor:pointer; font-size:11px"
                 title="${s.legiarti_id || ''}">
                Art. ${escHtml(s.article_number)}
              </a>
            `).join('')}
          </div>
        </div>

        ${sections.map((sec: any, i: number) => `
          <div class="expandable ${i < 4 ? 'open' : ''}">
            <button class="expandable-header">
              <span>${escHtml(sec.title)}</span>
              <span class="arrow">&#9654;</span>
            </button>
            <div class="expandable-body">
              <div class="md-content">${renderMarkdown(sec.content)}</div>
            </div>
          </div>
        `).join('')}

        <div class="warning-box" style="margin-top:20px">
          <span>&#9888;</span>
          <div>
            <strong>Avertissement Compliance Officer</strong><br>
            Ce document est un PROJET généré automatiquement par IA à partir de sources Legifrance.
            Il DOIT être validé par le Compliance Officer avant toute mise en application.
          </div>
        </div>
        <p style="font-size:11px; color:#B0ADA7; margin-top:12px">${escHtml(proc.provenance || '')}</p>

        <div style="display:flex; gap:8px; margin-top:16px">
          <button class="btn-generate" style="flex:1; font-size:12px; padding:8px 12px" onclick="toast('Export DOCX — bientôt disponible')">
            Télécharger DOCX
          </button>
          <button class="btn-generate" style="flex:1; font-size:12px; padding:8px 12px; background:#3D3B38" onclick="toast('Sauvegardé dans Mes Procédures')">
            Sauvegarder dans Mes Procédures
          </button>
        </div>
      </div>`;
    initExpandables();

    document.querySelectorAll('[data-validate-proc]').forEach((btn: any) => {
      btn.addEventListener('click', () => validateProc(btn.dataset.validateProc, btn.dataset.decision));
    });
  }

  function renderGapResult(report: any) {
    const gaps = report.gaps || [];
    const covered = gaps.filter((g: any) => g.status === 'covered').length;
    const partial = gaps.filter((g: any) => g.status === 'partial').length;
    const absent = gaps.filter((g: any) => g.status === 'absent').length;

    document.getElementById('result-area')!.innerHTML = `
      <div style="padding:24px; max-width:800px; margin:0 auto">
        <div style="margin-bottom:20px">
          <div class="flex items-center gap-8">
            <h1 style="font-size:18px">Gap Analysis</h1>
            ${statusBadge(report.status || 'pending_validation')}
          </div>
          <p style="font-size:12px; color:#6B6860; margin-top:4px">
            ${escHtml(report.text_id || 'CMF')} &middot; ${escHtml(report.profile || gapProfile)} &middot; ${gaps.length} obligations analysées
          </p>
        </div>

        <div style="display:flex; gap:12px; margin-bottom:24px">
          <div style="flex:1; text-align:center; padding:12px; background:#EEF0E8; border-radius:4px">
            <div style="font-size:20px; font-weight:600; color:#5C6347">${covered}</div>
            <div style="font-size:11px; color:#6B6860">Couvertes</div>
          </div>
          <div style="flex:1; text-align:center; padding:12px; background:#F5F0E0; border-radius:4px">
            <div style="font-size:20px; font-weight:600; color:#8B7A3A">${partial}</div>
            <div style="font-size:11px; color:#6B6860">Partielles</div>
          </div>
          <div style="flex:1; text-align:center; padding:12px; background:#FDF2F2; border-radius:4px">
            <div style="font-size:20px; font-weight:600; color:#8B3A3A">${absent}</div>
            <div style="font-size:11px; color:#6B6860">Absentes</div>
          </div>
        </div>

        ${gaps.map((g: any, i: number) => {
          const statusColor = g.status === 'covered' ? '#5C6347' : g.status === 'partial' ? '#8B7A3A' : '#8B3A3A';
          const statusLabel = g.status === 'covered' ? 'Couverte' : g.status === 'partial' ? 'Partielle' : 'Absente';
          return `
            <div class="expandable ${g.status !== 'covered' ? 'open' : ''}">
              <button class="expandable-header">
                <span style="display:flex; align-items:center; gap:8px">
                  <span style="width:8px; height:8px; border-radius:50%; background:${statusColor}; flex-shrink:0"></span>
                  ${escHtml(g.obligation || g.article || 'Obligation ' + (i + 1))}
                  <span style="font-size:10px; color:${statusColor}; font-weight:500">${statusLabel}</span>
                </span>
                <span class="arrow">&#9654;</span>
              </button>
              <div class="expandable-body">
                <div class="md-content">${renderMarkdown(g.analysis || g.comment || '')}</div>
                ${g.recommendation ? `<div style="margin-top:8px; padding:8px 12px; background:#EEF0E8; border-radius:4px; font-size:12px"><strong>Recommandation :</strong> ${escHtml(g.recommendation)}</div>` : ''}
              </div>
            </div>`;
        }).join('')}

        <div class="warning-box" style="margin-top:20px">
          <span>&#9888;</span>
          <div>
            <strong>Avertissement</strong><br>
            Cette analyse est générée automatiquement. Elle doit être revue par le Compliance Officer.
          </div>
        </div>
      </div>`;
    initExpandables();
  }

  function parseSections(md: string) {
    const lines = md.split('\n');
    const sections: any[] = [];
    let current: any = null;
    for (const line of lines) {
      const m2 = line.match(/^## \d*\.?\s*(.+)/);
      const m1 = line.match(/^# (.+)/);
      if (m2) {
        if (current) sections.push(current);
        current = { title: m2[1], content: '' };
      } else if (m1 && !current) {
        if (current) sections.push(current);
        current = { title: m1[1], content: '' };
      } else if (current) {
        current.content += line + '\n';
      }
    }
    if (current) sections.push(current);
    if (sections.length === 0) sections.push({ title: 'Procédure', content: md });
    return sections;
  }

  async function validateProc(id: string, decision: string) {
    const comment = decision === 'rejected' ? prompt('Raison du rejet (optionnel):') : null;
    try {
      const body: any = { decision };
      if (comment) body.comment = comment;
      const result = await api(`/api/v1/procedures/${id}/validate`, { method: 'POST', body });
      renderResult(result);
      toast(decision === 'validated' ? 'Procédure validée' : 'Procédure rejetée');
      loadProcedures();
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  // -------------------------------------------------------------------------
  //  Procedure list
  // -------------------------------------------------------------------------
  async function loadProcedures() {
    try {
      procedures = await api('/api/v1/procedures');
      renderProcedureList();
    } catch (e: any) {
      document.getElementById('procedure-list')!.innerHTML =
        `<p style="font-size:12px; color:#B0ADA7">${e.message}</p>`;
    }
  }

  function renderProcedureList() {
    const list = document.getElementById('procedure-list')!;
    if (!procedures.length) {
      list.innerHTML = '<p style="font-size:12px; color:#B0ADA7">Aucune procédure générée</p>';
      return;
    }
    list.innerHTML = procedures.map((p: any) => {
      const profileLabel = ({ psp: 'PSP', banque: 'Banque', casp: 'CASP' } as Record<string,string>)[p.profile?.toLowerCase()] || p.profile;
      const title = `Procédure LCB-FT — ${profileLabel}`;
      return `
        <div style="padding:8px 0; cursor:pointer; border-bottom:1px solid #E8E5DE" data-load-proc="${p.id}">
          <div style="display:flex; align-items:center; justify-content:space-between">
            <span style="font-size:13px; font-weight:500; color:#1A1918">${escHtml(title)}</span>
            ${statusBadge(p.status)}
          </div>
          <div style="font-size:11px; color:#6B6860; margin-top:2px">
            ${p.obligation_count} obligations &middot; ${formatDate(p.created_at)}
          </div>
        </div>`;
    }).join('');
    list.querySelectorAll('[data-load-proc]').forEach((el: any) => {
      el.addEventListener('click', () => loadProcedure(el.dataset.loadProc));
    });
  }

  async function loadProcedure(id: string) {
    showLoading('Chargement de la procédure\u2026');
    try {
      const result = await api(`/api/v1/procedures/${id}`);
      renderResult(result);
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  // -------------------------------------------------------------------------
  //  Init
  // -------------------------------------------------------------------------
  switchMode('scratch');
  loadProcedures();
</script>
