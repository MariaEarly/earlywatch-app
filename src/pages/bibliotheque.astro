---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Bibliothèque — Early Watch" activePage="bibliotheque">
  <div style="max-width:1100px;margin:0 auto;">
    <div class="bib-page-title">Bibliothèque de procédures LCB-FT</div>
    <div class="bib-page-sub">19 templates mis à jour — liés en temps réel à votre veille réglementaire</div>

    <div class="stats-bar">
      <div class="stat-item">
        <div class="stat-value" id="stat-total">--</div>
        <div class="stat-label">Templates</div>
      </div>
      <div class="stat-item">
        <div class="stat-value" id="stat-hot">--</div>
        <div class="stat-label">Potentiellement impactés (7 j)</div>
      </div>
      <div class="stat-item">
        <div class="stat-value" id="stat-warm">--</div>
        <div class="stat-label">Articles liés (30 j)</div>
      </div>
    </div>

    <div class="filters">
      <span class="filter-label">Profil :</span>
      <button class="filter-btn active" data-filter="profile" data-value="">Tous</button>
      <button class="filter-btn" data-filter="profile" data-value="Banque">Banque</button>
      <button class="filter-btn" data-filter="profile" data-value="PSP">PSP</button>
      <button class="filter-btn" data-filter="profile" data-value="CASP">CASP</button>

      <span class="filter-label" style="margin-left:8px">Domaine :</span>
      <button class="filter-btn active" data-filter="domain" data-value="">Tous</button>
      <button class="filter-btn" data-filter="domain" data-value="KYC">KYC</button>
      <button class="filter-btn" data-filter="domain" data-value="Sanctions">Sanctions</button>
      <button class="filter-btn" data-filter="domain" data-value="Monitoring">Monitoring</button>
      <button class="filter-btn" data-filter="domain" data-value="Tracfin">Tracfin</button>
      <button class="filter-btn" data-filter="domain" data-value="Crypto">Crypto</button>

      <input type="text" class="search-input" id="search-input" placeholder="Rechercher un template...">
    </div>

    <div id="grid" class="grid">
      <div class="bib-loading">Chargement des procédures...</div>
    </div>
  </div>
</AppLayout>

<style>
  .bib-page-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 4px; }
  .bib-page-sub   { font-size: 13px; color: var(--mute); margin-bottom: 28px; }

  .stats-bar {
    display: grid; grid-template-columns: repeat(3, 1fr);
    border: 0.5px solid var(--line); margin-bottom: 24px;
    background: var(--bg);
  }
  .stat-item {
    display: flex; flex-direction: column; gap: 2px;
    padding: 20px 24px; border-right: 0.5px solid var(--line);
  }
  .stat-item:last-child { border-right: none; }
  .stat-value { font-family: var(--font-mono); font-size: 32px; font-weight: 300; line-height: 1; color: var(--ink); }
  .stat-label { font-size: 12px; color: var(--mute); }

  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; align-items: center; }
  .filter-label { font-size: 12px; color: var(--mute); font-family: var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .filter-btn {
    padding: 5px 12px; border: 0.5px solid var(--line-strong);
    background: transparent; font-size: 12px; color: var(--taupe);
    cursor: pointer; font-family: inherit; transition: all 0.12s;
  }
  .filter-btn:hover { background: var(--bg-side); color: var(--ink); }
  .filter-btn.active { background: var(--ink); border-color: var(--ink); color: var(--bg); }

  .search-input {
    padding: 6px 12px; border: 0.5px solid var(--line-strong);
    font-size: 13px; font-family: inherit;
    width: 240px; color: var(--ink); background: var(--bg); outline: none;
    transition: border-color 0.15s;
  }
  .search-input:focus { border-color: var(--ink); }
  .search-input::placeholder { color: var(--ghost); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px; }
  .bib-loading { text-align: center; padding: 60px; color: var(--mute); font-size: 13px; }
</style>

<style is:global>
  .bib-card {
    background: var(--bg); border: 0.5px solid var(--line);
    padding: 20px; display: flex; flex-direction: column; gap: 14px;
    transition: border-color 0.12s;
  }
  .bib-card:hover { border-color: var(--line-strong); }

  .bib-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .bib-card-ref {
    font-family: var(--font-mono); font-size: 10px; color: var(--mute);
    background: var(--bg-side); padding: 3px 8px;
    border: 0.5px solid var(--line); white-space: nowrap;
  }

  .bib-freshness-badge {
    display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 500;
    padding: 3px 9px; white-space: nowrap; cursor: pointer;
    font-family: var(--font-mono); letter-spacing: 0.06em;
    border: 0.5px solid transparent;
  }
  .bib-freshness-badge.hot  { color: var(--moutarde); border-color: var(--moutarde); }
  .bib-freshness-badge.warm { color: var(--ink-soft); border-color: var(--ink-soft); }
  .bib-freshness-badge.ok   { color: var(--taupe); border-color: var(--line-strong); }
  .bib-freshness-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

  .bib-card-title    { font-size: 14px; font-weight: 500; color: var(--ink); line-height: 1.4; }
  .bib-card-subtitle { font-size: 13px; color: var(--mute); margin-top: 2px; }
  .bib-card-meta     { display: flex; gap: 12px; align-items: center; }
  .bib-card-domain   { font-size: 11px; color: var(--taupe); font-family: var(--font-mono); }
  .bib-card-version  { font-size: 11px; color: var(--mute); }
  .bib-card-profiles { display: flex; gap: 6px; flex-wrap: wrap; }
  .bib-profile-tag {
    font-size: 10px; padding: 2px 7px; border: 0.5px solid var(--line);
    color: var(--taupe); font-family: var(--font-mono);
  }

  .bib-linked-articles { border-top: 0.5px solid var(--line); padding-top: 14px; display: none; }
  .bib-linked-articles.open { display: block; }
  .bib-linked-articles-title { font-size: 11px; font-weight: 500; color: var(--mute); margin-bottom: 10px; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; }
  .bib-article-item { padding: 8px 10px; background: var(--bg-side); margin-bottom: 6px; display: flex; flex-direction: column; gap: 3px; }
  .bib-article-item-title { font-size: 13px; color: var(--ink); font-weight: 500; text-decoration: none; line-height: 1.3; }
  .bib-article-item-title:hover { color: var(--taupe); }
  .bib-article-item-meta { font-size: 11px; color: var(--mute); display: flex; gap: 8px; flex-wrap: wrap; }
  .bib-article-theme-tag { font-size: 10px; padding: 1px 5px; background: var(--bg-hover); color: var(--taupe); border: 0.5px solid var(--line); }
  .bib-no-articles { font-size: 13px; color: var(--mute); }

  .bib-card-actions { display: flex; gap: 10px; align-items: center; margin-top: auto; }
  .bib-btn-download {
    flex: 1; padding: 8px 14px; background: var(--ink); color: var(--bg);
    border: 0.5px solid var(--ink); font-size: 12px; font-weight: 500;
    cursor: pointer; text-decoration: none; text-align: center; font-family: inherit;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    transition: background 0.12s;
  }
  .bib-btn-download:hover { background: var(--ink-soft); border-color: var(--ink-soft); }
  .bib-btn-articles-toggle {
    padding: 8px 12px; background: transparent; color: var(--taupe);
    border: 0.5px solid var(--line-strong); font-size: 12px;
    cursor: pointer; font-family: inherit; transition: all 0.12s;
    display: flex; align-items: center; gap: 5px; white-space: nowrap;
  }
  .bib-btn-articles-toggle:hover { background: var(--bg-side); color: var(--ink); }
  .bib-btn-articles-toggle.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
</style>

<script>
  import { api } from '../scripts/api';

  let allProcedures: any[] = [];
  let filters: any = { profile: '', domain: '' };
  let searchQuery: string = '';
  let openArticles: Set<string> = new Set();

  async function loadProcedures(): Promise<void> {
    try {
      const data: any = await api('/api/v1/procedures-library');
      allProcedures = data.procedures || [];
      updateStats();
      renderGrid();
    } catch (e: any) {
      document.getElementById('grid')!.innerHTML =
        '<div class="bib-loading">Erreur de chargement. Vérifiez votre connexion.</div>';
    }
  }

  function updateStats(): void {
    const hot: number = allProcedures.filter((p: any) => p.freshness === 'hot').length;
    const warm: number = allProcedures.filter((p: any) => p.articles_count_30d > 0)
      .reduce((s: number, p: any) => s + p.articles_count_30d, 0);
    document.getElementById('stat-total')!.textContent = String(allProcedures.length);
    document.getElementById('stat-hot')!.textContent = String(hot);
    document.getElementById('stat-warm')!.textContent = String(warm);
  }

  function getFiltered(): any[] {
    return allProcedures.filter((p: any) => {
      const profileOk: boolean = !filters.profile || p.profile_tags.includes(filters.profile);
      const domainOk: boolean = !filters.domain || p.domain === filters.domain;
      const searchOk: boolean = !searchQuery ||
        p.title.toLowerCase().includes(searchQuery) ||
        p.reference.toLowerCase().includes(searchQuery) ||
        (p.subtitle || '').toLowerCase().includes(searchQuery);
      return profileOk && domainOk && searchOk;
    });
  }

  function renderGrid(): void {
    const procs: any[] = getFiltered();
    const grid: HTMLElement = document.getElementById('grid')!;
    if (!procs.length) {
      grid.innerHTML = '<div class="bib-loading">Aucun template trouvé pour ces filtres.</div>';
      return;
    }
    grid.innerHTML = procs.map((p: any) => renderCard(p)).join('');
    openArticles.forEach((ref: string) => {
      const panel: HTMLElement | null = document.getElementById(`bib-articles-${ref}`);
      if (panel) panel.classList.add('open');
    });
    bindEvents();
  }

  function freshnessBadge(p: any): string {
    if (p.freshness === 'hot') {
      return `<span class="bib-freshness-badge hot" data-toggle-articles="${p.reference}">
        <span class="bib-freshness-dot"></span>
        ${p.articles_count_7d} article${p.articles_count_7d > 1 ? 's' : ''} récent${p.articles_count_7d > 1 ? 's' : ''}
      </span>`;
    }
    if (p.freshness === 'warm') {
      return `<span class="bib-freshness-badge warm" data-toggle-articles="${p.reference}">
        <span class="bib-freshness-dot"></span>
        ${p.articles_count_30d} article${p.articles_count_30d > 1 ? 's' : ''} ce mois
      </span>`;
    }
    return `<span class="bib-freshness-badge ok">
      <span class="bib-freshness-dot"></span> À jour
    </span>`;
  }

  function renderCard(p: any): string {
    const badge: string = freshnessBadge(p);
    const profiles: string = p.profile_tags.map((t: string) =>
      `<span class="bib-profile-tag">${t}</span>`).join('');
    const isOpen: boolean = openArticles.has(p.reference);
    const btnClass: string = 'bib-btn-articles-toggle' + (isOpen ? ' active' : '');

    return `
    <div class="bib-card" id="bib-card-${p.reference}">
      <div class="bib-card-top">
        <span class="bib-card-ref">${p.reference}</span>
        ${badge}
      </div>
      <div>
        <div class="bib-card-title">${p.title}</div>
        <div class="bib-card-subtitle">${p.subtitle || ''}</div>
      </div>
      <div class="bib-card-meta">
        <span class="bib-card-domain">${p.domain}</span>
        <span class="bib-card-version">v${p.version}</span>
      </div>
      <div class="bib-card-profiles">${profiles}</div>
      <div class="bib-linked-articles ${isOpen ? 'open' : ''}" id="bib-articles-${p.reference}">
        <div class="bib-linked-articles-title">Articles réglementaires liés (30 derniers jours)</div>
        <div id="bib-articles-content-${p.reference}">
          <div class="bib-loading" style="padding:12px 0; font-size:13px">Chargement...</div>
        </div>
      </div>
      <div class="bib-card-actions">
        <a href="${p.file_url}" download class="bib-btn-download">Télécharger .docx</a>
        ${p.freshness !== 'ok' ? `
        <button class="${btnClass}" id="bib-btn-${p.reference}" data-toggle-articles="${p.reference}">
          Articles liés
        </button>` : ''}
      </div>
    </div>`;
  }

  function bindEvents(): void {
    document.querySelectorAll('[data-toggle-articles]').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        toggleArticles(btn.dataset.toggleArticles);
      });
    });
  }

  async function toggleArticles(ref: string): Promise<void> {
    const panel: HTMLElement | null = document.getElementById(`bib-articles-${ref}`);
    const btn: HTMLElement | null = document.getElementById(`bib-btn-${ref}`);

    if (openArticles.has(ref)) {
      openArticles.delete(ref);
      panel?.classList.remove('open');
      btn?.classList.remove('active');
      return;
    }

    openArticles.add(ref);
    panel?.classList.add('open');
    btn?.classList.add('active');

    const contentEl: any = document.getElementById(`bib-articles-content-${ref}`);
    if (contentEl.dataset.loaded) return;

    try {
      const data: any = await api(`/api/v1/procedures-library/${ref}/articles`);
      if (!data.articles || !data.articles.length) {
        contentEl.innerHTML = '<div class="bib-no-articles">Aucun article lié sur les 30 derniers jours.</div>';
      } else {
        contentEl.innerHTML = data.articles.map((a: any) => {
          const date: string = a.published_at
            ? new Date(a.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })
            : '';
          const tags: string = (a.common_themes || []).map((t: string) =>
            `<span class="bib-article-theme-tag">${t}</span>`).join('');
          return `
          <div class="bib-article-item">
            <a href="${a.url}" target="_blank" class="bib-article-item-title">${a.title}</a>
            <div class="bib-article-item-meta">
              <span>${a.source}</span><span>${date}</span>${tags}
            </div>
          </div>`;
        }).join('');
      }
      contentEl.dataset.loaded = '1';
    } catch (e: any) {
      contentEl.innerHTML = '<div class="bib-no-articles">Erreur de chargement des articles.</div>';
    }
  }

  // Filter UI
  document.querySelectorAll('.filter-btn').forEach((btn: any) => {
    btn.addEventListener('click', () => {
      const filterType: string = btn.dataset.filter;
      if (!filterType) return;
      document.querySelectorAll(`[data-filter="${filterType}"]`).forEach((b: any) => b.classList.remove('active'));
      btn.classList.add('active');
      filters[filterType] = btn.dataset.value;
      renderGrid();
    });
  });

  document.getElementById('search-input')!.addEventListener('input', (e: any) => {
    searchQuery = e.target.value.toLowerCase().trim();
    renderGrid();
  });

  loadProcedures();
</script>
