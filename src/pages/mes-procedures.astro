---
import SmartLayout from '../layouts/SmartLayout.astro';
const base = import.meta.env.BASE_URL;
---

<SmartLayout title="Mes Procédures — Early Watch" activePage="mes-procedures">
  <div class="mp-layout">
    <div class="mp-main">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px">
        <div>
          <div class="page-title">Mes procédures LCB-FT</div>
          <div class="page-subtitle">Vos procédures réglementaires — statut, articles liés et téléchargement</div>
          <div id="stats-summary" class="stats-summary" style="display:none"></div>
        </div>
        <button id="btn-export-pdf" class="btn-export-audit">
          Exporter piste d'audit PDF
        </button>
      </div>

      <div class="filters" id="filters-bar" style="display:none">
        <span class="filter-label">Statut :</span>
        <button class="filter-btn active" data-filter="status" data-value="">Tous</button>
        <button class="filter-btn" data-filter="status" data-value="a_valider">À valider</button>
        <button class="filter-btn" data-filter="status" data-value="en_cours">En cours</button>
        <button class="filter-btn" data-filter="status" data-value="valide">Validé</button>
        <button class="filter-btn" data-filter="status" data-value="obsolete">Obsolète</button>

        <span class="filter-label" style="margin-left:8px">Domaine :</span>
        <button class="filter-btn active" data-filter="domain" data-value="">Tous</button>
        <button class="filter-btn" data-filter="domain" data-value="KYC">KYC</button>
        <button class="filter-btn" data-filter="domain" data-value="Sanctions">Sanctions</button>
        <button class="filter-btn" data-filter="domain" data-value="Monitoring">Monitoring</button>
        <button class="filter-btn" data-filter="domain" data-value="Tracfin">Tracfin</button>
      </div>

      <div id="grid" class="grid">
        <div class="loading">Chargement...</div>
      </div>
    </div>
  </div>
</SmartLayout>

<style>
  .mp-layout { min-height: 100vh; display: flex; flex-direction: column; }
  .mp-main { flex: 1; max-width: 1200px; margin: 0 auto; padding: 32px 24px; width: 100%; }
  .page-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 4px; }
  .page-subtitle { font-size: 14px; color: var(--mute); margin-bottom: 4px; }
  .stats-summary { font-size: 13px; color: var(--mute); margin-bottom: 24px; }

  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; align-items: center; }
  .filter-label { font-size: 12px; color: var(--mute); font-weight: 500; }
  .filter-btn {
    padding: 5px 12px; border-radius: var(--radius); border: 0.5px solid #D5D2CB;
    background: transparent; font-size: 12px; color: #666;
    cursor: pointer; font-family: inherit; transition: all 0.15s;
  }
  .filter-btn:hover { background: var(--bg-side); color: var(--ink); }
  .filter-btn.active { background: rgba(92,99,71,0.12); border-color: #5C6347; color: #5C6347; }

  .btn-export-audit {
    background: var(--ink); color: var(--bg); font-weight: 500;
    padding: 8px 18px; margin-top: 4px; border-radius: var(--radius);
    border: 1px solid var(--ink); font-size: 13px; cursor: pointer;
    font-family: inherit; transition: background 0.15s;
  }
  .btn-export-audit:hover { background: var(--ink-soft); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 16px; }
  .loading { text-align: center; padding: 60px; color: var(--mute); font-size: 14px; }
  .disabled-msg { text-align: center; padding: 80px 40px; }
  .disabled-msg h2 { font-size: 20px; color: var(--ink); margin-bottom: 8px; }
  .disabled-msg p { font-size: 14px; color: var(--mute); }
</style>

<style is:global>
  .mp-card {
    background: var(--bg); border: 0.5px solid var(--line-strong); border-radius: var(--radius);
    padding: 20px; display: flex; flex-direction: column; gap: 12px;
    box-shadow: none; transition: border-color 0.15s;
  }
  .mp-card:hover { border-color: var(--line-strong); }
  .mp-card.alert-border { border-color: var(--moutarde); }

  .card-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .card-top-left { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; min-width: 0; }
  .card-ref {
    font-family: var(--font-mono); font-size: 11px; color: var(--taupe);
    background: var(--bg-side); padding: 3px 8px; border-radius: var(--radius);
    border: 0.5px solid var(--line-strong); white-space: nowrap;
  }
  .card-meta-inline {
    font-family: var(--font-mono); font-size: 10px; color: var(--taupe);
    white-space: nowrap; letter-spacing: .02em;
  }

  .mp-card.is-obsolete .card-title { color: var(--taupe); }

  .alert-ribbon {
    font-size: 11px; font-weight: 500; color: var(--moutarde); background: rgba(234,179,8,0.08);
    padding: 6px 10px; border-radius: var(--radius); border: 1px solid var(--moutarde);
    display: flex; align-items: center; gap: 6px;
  }

  .freshness-badge {
    display: flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 500;
    padding: 4px 10px; border-radius: var(--radius); white-space: nowrap; cursor: pointer;
    border: 1px solid transparent;
  }
  .freshness-badge.hot { background: rgba(234,179,8,0.15); color: var(--moutarde); border-color: var(--moutarde); }
  .freshness-badge.warm { background: rgba(234,179,8,0.08); color: var(--moutarde); border-color: var(--moutarde); }
  .freshness-badge.ok { background: var(--bg-side); color: var(--ink-soft); border-color: var(--line-strong); }
  .freshness-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  .card-title { font-size: 15px; font-weight: 500; color: var(--ink); line-height: 1.4; }
  .card-subtitle { font-size: 13px; color: var(--mute); margin-top: 2px; }

  .status-selector {
    display: flex; gap: 6px; flex-wrap: wrap; padding-top: 10px;
    border-top: 0.5px solid var(--line-strong);
  }
  .status-opt {
    padding: 4px 11px; border-radius: var(--radius); border: 0.5px solid #D5D2CB;
    background: transparent; font-size: 12px; cursor: pointer;
    font-family: inherit; transition: all 0.15s; color: #666;
  }
  .status-opt:hover { background: var(--bg-side); color: var(--ink); }
  .status-opt.active        { background: rgba(92,99,71,0.12); color: #5C6347; border-color: #5C6347; }
  .status-opt.active-valide  { background: rgba(92,99,71,0.12); color: #5C6347; border-color: #5C6347; }
  .status-opt.active-obsolete { background: rgba(92,99,71,0.12); color: #5C6347; border-color: #5C6347; }

  .linked-articles { border-top: 0.5px solid var(--line-strong); padding-top: 12px; display: none; }
  .linked-articles.open { display: block; }
  .linked-articles-title { font-size: 12px; font-weight: 500; color: var(--ink-soft); margin-bottom: 10px; }
  .article-item { padding: 8px 10px; border-radius: var(--radius); background: var(--bg); margin-bottom: 6px; display: flex; flex-direction: column; gap: 3px; }
  .article-item-title { font-size: 13px; color: var(--ink); font-weight: 500; text-decoration: none; line-height: 1.3; }
  .article-item-title:hover { color: var(--ink); }
  .article-item-meta { font-size: 11px; color: var(--mute); display: flex; gap: 8px; flex-wrap: wrap; }
  .article-theme-tag { font-size: 10px; padding: 1px 5px; border-radius: var(--radius); background: var(--bg-side); color: var(--taupe); border: 0.5px solid var(--line-strong); }
  .no-articles { font-size: 13px; color: var(--mute); font-style: italic; }

  .card-actions { display: flex; gap: 10px; align-items: center; margin-top: auto; }
  .btn-download {
    flex: 1; padding: 8px 16px; background: #5C6347; color: var(--bg);
    border: 1px solid #5C6347; border-radius: var(--radius); font-size: 13px; font-weight: 500;
    cursor: pointer; text-decoration: none; text-align: center; font-family: inherit;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    transition: background 0.15s; box-shadow: none;
  }
  .btn-download:hover { background: #4a5038; border-color: #4a5038; }
  .btn-toggle {
    padding: 8px 14px; background: var(--bg); color: var(--ink);
    border: 0.5px solid var(--line-strong); border-radius: var(--radius); font-size: 13px;
    cursor: pointer; font-family: inherit; transition: all 0.15s;
    display: flex; align-items: center; gap: 5px; white-space: nowrap;
    box-shadow: none;
  }
  .btn-toggle:hover { background: var(--bg-side); }
  .btn-toggle.active { background: rgba(92,99,71,0.12); color: #5C6347; border-color: #5C6347; }
</style>

<script>
  import { api, toast, API, isImpersonating } from '../scripts/api';

  if (isImpersonating()) {
    const btn = document.getElementById('btn-export-pdf');
    if (btn) btn.style.display = 'none';
  }

  let allProcedures: any[] = [];
  let filters: any = { status: '', domain: '' };
  let openArticles: Set<string> = new Set();

  function sanitizeTitle(t: string): string {
    return t
      .replace(/\bControle\b/g, 'Contrôle').replace(/\bcontrole\b/g, 'contrôle')
      .replace(/\bSelection\b/g, 'Sélection').replace(/\bselection\b/g, 'sélection')
      .replace(/\bMaitrise\b/g, 'Maîtrise').replace(/\bmaitrise\b/g, 'maîtrise')
      .replace(/\bEntree\b/g, 'Entrée').replace(/\bentree\b/g, 'entrée')
      .replace(/\bbeneficiaire\b/g, 'bénéficiaire').replace(/\bBeneficiaire\b/g, 'Bénéficiaire')
      .replace(/\bverification\b/g, 'vérification').replace(/\bVerification\b/g, 'Vérification')
      .replace(/\bCompetences\b/g, 'Compétences').replace(/\bcompetences\b/g, 'compétences');
  }

  async function loadProcedures(): Promise<void> {
    try {
      const data: any = await api('/api/v1/my-procedures');

      if (!data.enabled) {
        document.getElementById('grid')!.innerHTML = `
          <div class="disabled-msg">
            <h2>Module Procédures non activé</h2>
            <p>Contactez votre administrateur pour activer l'accès aux procédures LCB-FT.</p>
          </div>`;
        return;
      }

      allProcedures = data.procedures || [];
      document.getElementById('filters-bar')!.style.display = 'flex';
      updateStats();
      renderGrid();
    } catch (e: any) {
      document.getElementById('grid')!.innerHTML =
        '<div class="loading">Erreur de chargement.</div>';
    }
  }

  function updateStats(): void {
    const valide: number = allProcedures.filter((p: any) => p.status === 'valide').length;
    const alert: number = allProcedures.filter((p: any) => p.status_alert).length;
    const n = allProcedures.length;
    const el = document.getElementById('stats-summary');
    if (el) {
      el.textContent = `${n} procédure${n > 1 ? 's' : ''} attribuée${n > 1 ? 's' : ''} · ${valide} validée${valide > 1 ? 's' : ''} · ${alert} alerte${alert > 1 ? 's' : ''} active${alert > 1 ? 's' : ''}`;
      el.style.display = 'block';
    }
  }

  function getFiltered(): any[] {
    return allProcedures.filter((p: any) => {
      const statusOk: boolean = !filters.status || p.status === filters.status;
      const domainOk: boolean = !filters.domain || p.domain === filters.domain;
      return statusOk && domainOk;
    });
  }

  function renderGrid(): void {
    const procs: any[] = getFiltered();
    const grid: HTMLElement = document.getElementById('grid')!;
    if (!procs.length) {
      grid.innerHTML = '<div class="loading">Aucune procédure pour ces filtres.</div>';
      return;
    }
    grid.innerHTML = procs.map(renderCard).join('');
    openArticles.forEach((ref: string) => {
      const panel: HTMLElement | null = document.getElementById(`articles-${ref}`);
      if (panel) panel.classList.add('open');
    });
    bindCardEvents();
  }

  function renderCard(p: any): string {
    const isOpen: boolean = openArticles.has(p.reference);
    const hasArticles: boolean = p.freshness !== 'ok';

    let freshBdg: string = '';
    if (p.freshness === 'hot') {
      freshBdg = `<span class="freshness-badge hot" data-toggle-articles="${p.reference}">
        <span class="freshness-dot"></span>${p.articles_count_7d} article${p.articles_count_7d > 1 ? 's' : ''} récent${p.articles_count_7d > 1 ? 's' : ''}
      </span>`;
    } else if (p.freshness === 'warm') {
      freshBdg = `<span class="freshness-badge warm" data-toggle-articles="${p.reference}">
        <span class="freshness-dot"></span>${p.articles_count_30d} ce mois
      </span>`;
    }

    const alertRibbon: string = p.status_alert
      ? `<div class="alert-ribbon">Nouveaux articles détectés — révision recommandée</div>`
      : '';

    const statuses: string[] = ['a_valider', 'en_cours', 'valide', 'obsolete'];
    const statusLabels: any = { a_valider: 'À valider', en_cours: 'En cours', valide: 'Validé', obsolete: 'Obsolète' };
    const statusSelector: string = statuses.map((s: string) => {
      let cls: string = 'status-opt';
      if (s === p.status) {
        if (s === 'valide') cls += ' active-valide';
        else if (s === 'obsolete') cls += ' active-obsolete';
        else cls += ' active';
      }
      return `<button class="${cls}" data-set-status="${p.reference}" data-new-status="${s}">${statusLabels[s]}</button>`;
    }).join('');

    return `
    <div class="mp-card ${p.status_alert ? 'alert-border' : ''} ${p.status === 'obsolete' ? 'is-obsolete' : ''}" id="card-${p.reference}">
      <div class="card-top">
        <div class="card-top-left">
          <span class="card-ref">${p.reference}</span>
          <span class="card-meta-inline">${p.domain} · v${p.version}</span>
        </div>
        ${freshBdg}
      </div>
      ${alertRibbon}
      <div>
        <div class="card-title">${sanitizeTitle(p.title)}</div>
        <div class="card-subtitle">${p.subtitle || ''}</div>
      </div>
      <div class="status-selector">${statusSelector}</div>
      <div class="linked-articles ${isOpen ? 'open' : ''}" id="articles-${p.reference}">
        <div class="linked-articles-title">Articles liés (30 jours)</div>
        <div id="articles-content-${p.reference}">
          <div class="loading" style="padding:12px 0;font-size:13px">Chargement...</div>
        </div>
      </div>
      <div class="card-actions">
        <a href="${p.file_url}" download class="btn-download">Télécharger .docx</a>
        ${hasArticles ? `<button class="btn-toggle ${isOpen ? 'active' : ''}" id="btn-${p.reference}" data-toggle-articles="${p.reference}">Articles</button>` : ''}
      </div>
    </div>`;
  }

  function bindCardEvents(): void {
    document.querySelectorAll('[data-set-status]').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        setStatus(btn.dataset.setStatus, btn.dataset.newStatus);
      });
    });
    document.querySelectorAll('[data-toggle-articles]').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        toggleArticles(btn.dataset.toggleArticles);
      });
    });
  }

  async function setStatus(ref: string, newStatus: string): Promise<void> {
    try {
      await api(`/api/v1/my-procedures/${ref}/status`, {
        method: 'POST',
        body: { status: newStatus },
      });
      const proc: any = allProcedures.find((p: any) => p.reference === ref);
      if (proc) {
        proc.status = newStatus;
        proc.status_label = ({ a_valider: 'À valider', en_cours: 'En cours', valide: 'Validé', obsolete: 'Obsolète' } as any)[newStatus] || newStatus;
        if (newStatus === 'valide') proc.status_alert = null;
      }
      updateStats();
      renderGrid();
      toast('Statut mis à jour', 'success');
    } catch (e: any) {
      toast(e.message || 'Erreur', 'error');
    }
  }

  async function toggleArticles(ref: string): Promise<void> {
    const panel: HTMLElement | null = document.getElementById(`articles-${ref}`);
    const btn: HTMLElement | null = document.getElementById(`btn-${ref}`);

    if (openArticles.has(ref)) {
      openArticles.delete(ref);
      panel?.classList.remove('open');
      btn?.classList.remove('active');
      return;
    }

    openArticles.add(ref);
    panel?.classList.add('open');
    btn?.classList.add('active');

    const contentEl: any = document.getElementById(`articles-content-${ref}`);
    if (contentEl.dataset.loaded) return;

    try {
      const data: any = await api(`/api/v1/my-procedures/${ref}/articles`);
      if (!data.articles || !data.articles.length) {
        contentEl.innerHTML = '<div class="no-articles">Aucun article lié sur les 30 derniers jours.</div>';
      } else {
        contentEl.innerHTML = data.articles.map((a: any) => {
          const date: string = a.published_at
            ? new Date(a.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })
            : '';
          const tags: string = (a.common_themes || []).map((t: string) =>
            `<span class="article-theme-tag">${t}</span>`).join('');
          return `
          <div class="article-item">
            <a href="${a.url}" target="_blank" class="article-item-title">${a.title}</a>
            <div class="article-item-meta">
              <span>${a.source}</span><span>${date}</span>${tags}
            </div>
          </div>`;
        }).join('');
      }
      contentEl.dataset.loaded = '1';
    } catch (e: any) {
      contentEl.innerHTML = '<div class="no-articles">Erreur de chargement.</div>';
    }
  }

  document.querySelectorAll('.filter-btn').forEach((btn: any) => {
    btn.addEventListener('click', () => {
      const filterType: string = btn.dataset.filter;
      if (!filterType) return;
      document.querySelectorAll(`[data-filter="${filterType}"]`).forEach((b: any) => b.classList.remove('active'));
      btn.classList.add('active');
      filters[filterType] = btn.dataset.value;
      renderGrid();
    });
  });

  document.getElementById('btn-export-pdf')!.addEventListener('click', async () => {
    const btn: HTMLButtonElement = document.getElementById('btn-export-pdf') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Génération en cours...';
    try {
      const token: string | null = sessionStorage.getItem('ew_token');
      const res: Response = await fetch(`${API}/api/v1/audit/export-pdf`, {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) {
        const err: any = await res.json().catch(() => ({}));
        throw new Error(err.detail || 'Erreur export');
      }
      const blob: Blob = await res.blob();
      const url: string = URL.createObjectURL(blob);
      const a: HTMLAnchorElement = document.createElement('a');
      a.href = url;
      a.download = `piste-audit-lcbft-${new Date().toISOString().slice(0,10)}.pdf`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      toast('PDF téléchargé', 'success');
    } catch (e: any) {
      toast(e.message || 'Erreur export PDF', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = "Exporter piste d'audit PDF";
    }
  });

  loadProcedures();
</script>
