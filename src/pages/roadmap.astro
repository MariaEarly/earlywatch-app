---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Roadmap Réglementaire — Early Watch" activePage="roadmap">
  <div style="max-width:1000px;margin:0 auto;">
    <div class="rm-page-title">Roadmap Réglementaire</div>
    <div class="rm-page-sub">Calendrier des échéances LCB-FT — AMLR · DORA · AI Act · MiCA</div>

    <div class="stats-row" id="stats-row"></div>

    <div class="legend">
      <div class="legend-item"><div class="legend-dot" style="background:var(--moutarde)"></div> Critique</div>
      <div class="legend-item"><div class="legend-dot" style="background:var(--ink-soft)"></div> Élevé</div>
      <div class="legend-item"><div class="legend-dot" style="background:var(--taupe)"></div> Moyen</div>
      <div class="legend-item"><div class="legend-dot" style="background:var(--ghost)"></div> Passé</div>
    </div>

    <div class="filters" id="filters">
      <button class="fbtn active" data-f="reg" data-v="">Toutes</button>
      <button class="fbtn" data-f="reg" data-v="AMLR">AMLR</button>
      <button class="fbtn" data-f="reg" data-v="DORA">DORA</button>
      <button class="fbtn" data-f="reg" data-v="AI Act">AI Act</button>
      <button class="fbtn" data-f="reg" data-v="MiCA">MiCA</button>
    </div>

    <div id="timeline" class="timeline">
      <div class="rm-loading">Chargement de la roadmap...</div>
    </div>
  </div>
</AppLayout>

<style>
  .rm-page-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 4px; }
  .rm-page-sub   { font-size: 13px; color: var(--mute); margin-bottom: 28px; }

  .stats-row { display: flex; gap: 12px; margin-bottom: 28px; }
  .legend    { display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--mute); }
  .legend-dot  { width: 8px; height: 8px; border-radius: 50%; }

  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
  .fbtn {
    padding: 5px 12px; border: 0.5px solid var(--line-strong);
    background: transparent; font-size: 12px; color: var(--taupe);
    cursor: pointer; font-family: inherit; transition: all 0.12s;
  }
  .fbtn:hover { background: var(--bg-side); color: var(--ink); }
  .fbtn.active { background: var(--ink); border-color: var(--ink); color: var(--bg); }

  .timeline { position: relative; padding-left: 28px; }
  .timeline::before {
    content: ''; position: absolute; left: 8px; top: 0; bottom: 0;
    width: 1.5px; background: var(--line);
  }

  .rm-loading { text-align: center; padding: 60px; color: var(--mute); font-size: 13px; }

  @media (max-width: 700px) {
    .stats-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  }
</style>

<style is:global>
  .rm-stat {
    flex: 1; background: var(--bg); border: 0.5px solid var(--line);
    padding: 16px 18px;
  }
  .rm-stat-val { font-family: var(--font-mono); font-size: 32px; font-weight: 300; line-height: 1; margin-bottom: 4px; color: var(--ink); }
  .rm-stat-lbl { font-size: 12px; color: var(--mute); }

  .tl-year {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.16em; color: var(--mute); text-transform: uppercase;
    margin: 28px 0 14px -28px;
  }

  .tl-item { position: relative; margin-bottom: 12px; }
  .tl-dot  {
    position: absolute; left: -24px; top: 18px;
    width: 10px; height: 10px; border-radius: 50%;
    border: 2px solid var(--bg); z-index: 1;
  }
  .tl-dot.critical { background: var(--moutarde); }
  .tl-dot.high     { background: var(--ink-soft); }
  .tl-dot.medium   { background: var(--taupe); }
  .tl-dot.low      { background: var(--taupe); }
  .tl-dot.passed   { background: var(--ghost); }

  .rm-card {
    background: var(--bg); border: 0.5px solid var(--line);
    padding: 18px 20px; transition: border-color 0.12s; cursor: pointer;
  }
  .rm-card:hover  { border-color: var(--line-strong); }
  .rm-card.passed { opacity: .55; }
  .rm-card.imminent { border-left: 2px solid var(--moutarde); }
  .rm-card.soon     { border-left: 2px solid var(--ink-soft); }

  .rm-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 10px; }
  .rm-card-left { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .rm-card-ref {
    font-family: var(--font-mono); font-size: 10px; color: var(--mute);
    background: var(--bg-side); padding: 3px 7px; border: 0.5px solid var(--line);
  }
  .rm-card-reg  { font-size: 12px; font-weight: 500; color: var(--ink); }
  .rm-card-type { font-family: var(--font-mono); font-size: 10px; color: var(--mute); }

  .rm-card-date { text-align: right; flex-shrink: 0; }
  .date-main    { font-family: var(--font-mono); font-size: 13px; font-weight: 500; color: var(--ink); }
  .date-delta   { font-size: 11px; margin-top: 2px; }
  .date-delta.imminent { color: var(--moutarde); }
  .date-delta.soon     { color: var(--ink-soft); }
  .date-delta.upcoming { color: var(--mute); }
  .date-delta.passed   { color: var(--mute); }

  .rm-card-title { font-size: 14px; font-weight: 500; line-height: 1.35; margin-bottom: 6px; color: var(--ink); }
  .rm-card-desc  { font-size: 13px; color: var(--taupe); line-height: 1.65; margin-bottom: 10px; display: none; }
  .rm-card.open .rm-card-desc { display: block; }

  .rm-card-bottom { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .proc-chip {
    font-family: var(--font-mono); font-size: 10px; padding: 2px 7px;
    background: var(--bg-side); color: var(--taupe); border: 0.5px solid var(--line);
  }
  .fresh-badge { font-size: 11px; color: var(--mute); margin-left: auto; }
</style>

<script>
  import { api } from '../scripts/api';

  let allDeadlines: any[] = [];
  let regFilter: string = '';
  let openIds: Set<string> = new Set();

  async function load(): Promise<void> {
    try {
      const d: any = await api('/api/v1/deadlines?include_passed=true');
      allDeadlines = d.deadlines || [];
      renderStats(d.stats || {});
      render();
    } catch (e: any) {
      document.getElementById('timeline')!.innerHTML = '<div class="rm-loading">Erreur de chargement.</div>';
    }
  }

  function renderStats(s: any): void {
    document.getElementById('stats-row')!.innerHTML = `
      <div class="rm-stat"><div class="rm-stat-val">${s.critical || 0}</div><div class="rm-stat-lbl">Échéances critiques à venir</div></div>
      <div class="rm-stat"><div class="rm-stat-val">${s.imminent || 0}</div><div class="rm-stat-lbl">Dans les 30 prochains jours</div></div>
      <div class="rm-stat"><div class="rm-stat-val">${s.upcoming || 0}</div><div class="rm-stat-lbl">Échéances à venir</div></div>`;
  }

  function getFiltered(): any[] {
    return allDeadlines.filter((d: any) => !regFilter || d.regulation === regFilter);
  }

  function render(): void {
    const items: any[] = getFiltered();
    const tl: HTMLElement = document.getElementById('timeline')!;
    if (!items.length) { tl.innerHTML = '<div class="rm-loading">Aucune échéance pour ce filtre.</div>'; return; }
    const byYear: any = {};
    items.forEach((d: any) => {
      const yr: string = d.deadline_date.slice(0, 4);
      if (!byYear[yr]) byYear[yr] = [];
      byYear[yr].push(d);
    });
    let html: string = '';
    Object.keys(byYear).sort().forEach((yr: string) => {
      const isCurrent: boolean = yr === new Date().getFullYear().toString();
      html += `<div class="tl-year">${yr}${isCurrent ? ' \u2014 en cours' : ''}</div>`;
      byYear[yr].forEach((d: any) => { html += renderItem(d); });
    });
    tl.innerHTML = html;
    bindItemClicks();
  }

  function deltaLabel(d: any): string {
    if (d.status === 'passed') return `<span class="date-delta passed">Passée</span>`;
    const delta: number = d.delta_days;
    if (delta <= 0) return `<span class="date-delta imminent">Aujourd'hui</span>`;
    if (delta <= 30) return `<span class="date-delta imminent">Dans ${delta}j</span>`;
    if (delta <= 90) return `<span class="date-delta soon">Dans ${delta}j</span>`;
    return `<span class="date-delta upcoming">Dans ~${Math.round(delta / 30)} mois</span>`;
  }

  function renderItem(d: any): string {
    const isOpen: boolean = openIds.has(d.reference);
    const dotClass: string = d.status === 'passed' ? 'passed' : d.priority;
    const cardClass: string = d.status === 'passed' ? 'passed' : d.urgency === 'imminent' ? 'imminent' : d.urgency === 'soon' ? 'soon' : '';
    const dateStr: string = new Date(d.deadline_date + 'T00:00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    const procs: string = (d.impacted_procedures || []).slice(0, 4).map((p: string) => `<span class="proc-chip">${p}</span>`).join('');
    const fresh: string = d.articles_count_30d > 0 ? `<span class="fresh-badge">${d.articles_count_30d} article${d.articles_count_30d > 1 ? 's' : ''} récent${d.articles_count_30d > 1 ? 's' : ''}</span>` : '';
    const desc: string = isOpen && d.description
      ? `<div class="rm-card-desc" style="display:block">${d.description}${d.notes ? `<br><br><strong>Note :</strong> ${d.notes}` : ''}${d.source_url ? `<br><a href="${d.source_url}" target="_blank" style="color:var(--moutarde);font-size:12px;">Source officielle</a>` : ''}</div>`
      : `<div class="rm-card-desc">${d.description || ''}</div>`;
    return `
    <div class="tl-item">
      <div class="tl-dot ${dotClass}"></div>
      <div class="rm-card ${cardClass} ${isOpen ? 'open' : ''}" data-toggle-item="${d.reference}">
        <div class="rm-card-top">
          <div class="rm-card-left">
            <span class="rm-card-ref">${d.reference}</span>
            <span class="rm-card-reg">${d.regulation}</span>
            <span class="rm-card-type">${d.deadline_type_label || d.deadline_type}</span>
          </div>
          <div class="rm-card-date">
            <div class="date-main">${dateStr}</div>
            ${deltaLabel(d)}
          </div>
        </div>
        <div class="rm-card-title">${d.title}</div>
        ${desc}
        <div class="rm-card-bottom">${procs}${fresh}</div>
      </div>
    </div>`;
  }

  function bindItemClicks(): void {
    document.querySelectorAll('[data-toggle-item]').forEach((card: any) => {
      card.addEventListener('click', () => {
        toggleItem(card.dataset.toggleItem);
      });
    });
  }

  function toggleItem(ref: string): void {
    if (openIds.has(ref)) openIds.delete(ref);
    else openIds.add(ref);
    render();
  }

  document.querySelectorAll('.fbtn').forEach((btn: any) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-f="reg"]').forEach((b: any) => b.classList.remove('active'));
      btn.classList.add('active');
      regFilter = btn.dataset.v;
      render();
    });
  });

  load();
</script>
