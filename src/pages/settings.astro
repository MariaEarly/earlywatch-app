---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Parametres — Early Watch" activePage="settings">
  <div class="st-layout">
    <div class="st-main">
      <div class="page-title">Parametres</div>
      <div class="page-subtitle">Profil d'assujetti, preferences d'alertes et utilisateurs</div>

      <div id="content">
        <div class="loading">Chargement des parametres...</div>
      </div>

      <div class="save-bar" id="save-bar">
        <button class="btn-save" id="btn-save">Enregistrer les modifications</button>
      </div>
    </div>
  </div>
</AppLayout>

<style>
  .st-layout { min-height: 100vh; display: flex; flex-direction: column; }
  .st-main { flex: 1; max-width: 900px; margin: 0 auto; padding: 32px 24px; width: 100%; }
  .page-title { font-size: 15px; font-weight: 500; color: var(--noir); margin-bottom: 4px; }
  .page-subtitle { font-size: 14px; color: var(--color-text-tertiary); margin-bottom: 28px; }

  .save-bar {
    position: sticky; bottom: 0; padding: 16px 0; background: rgba(255,255,255,0.95);
    border-top: 1px solid var(--color-border); text-align: right; display: none;
  }
  :global(.save-bar.visible) { display: block; }
  .btn-save {
    padding: 10px 28px; background: #F43F5E; color: white;
    border: none; border-radius: 8px; font-size: 14px;
    font-weight: 500; cursor: pointer; font-family: inherit;
    box-shadow: none; transition: all 0.15s;
  }
  .btn-save:hover { }
  .loading { padding: 40px; text-align: center; color: var(--color-text-tertiary); font-size: 14px; }
</style>

<style is:global>
  .st-section {
    background: white; border: 0.5px solid #E4E4E2; border-radius: 8px;
    box-shadow: none; margin-bottom: 20px; overflow: hidden;
  }
  .st-section-header {
    padding: 14px 20px; font-size: 14px; font-weight: 500; color: var(--noir);
    border-bottom: 0.5px solid #E4E4E2; display: flex;
    justify-content: space-between; align-items: center;
  }
  .st-section-body { padding: 20px; }

  .st-form-row { display: flex; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }
  .st-form-group { flex: 1; min-width: 200px; }
  .st-form-group label {
    display: block; font-size: 12px; font-weight: 500; color: var(--noir);
    margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.1em;
  }
  .st-form-group input, .st-form-group select {
    width: 100%; padding: 8px 12px; border: 0.5px solid #DDDDD9;
    border-radius: 8px; font-size: 13px; font-family: inherit; background: white; color: var(--noir);
  }
  .st-form-group input:focus, .st-form-group select:focus {
    outline: none; border-color: #F43F5E; box-shadow: none;
  }

  .toggle-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 0; border-bottom: 1px solid var(--color-border);
  }
  .toggle-row:last-child { border-bottom: none; }
  .toggle-label { font-size: 13px; color: var(--noir); }
  .toggle-desc { font-size: 11px; color: var(--color-text-tertiary); margin-top: 1px; }
  .toggle { position: relative; width: 44px; height: 24px; cursor: pointer; }
  .toggle input { opacity: 0; width: 0; height: 0; }
  .toggle-slider {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: var(--color-border); border-radius: 12px; transition: 0.2s; border: 0.5px solid #DDDDD9;
  }
  .toggle-slider::before {
    content: ''; position: absolute; height: 18px; width: 18px;
    left: 2px; bottom: 2px; background: white; border-radius: 50%;
    transition: 0.2s;
  }
  .toggle input:checked + .toggle-slider { background: #F43F5E; }
  .toggle input:checked + .toggle-slider::before { transform: translateX(20px); }

  .st-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
  .st-chip {
    padding: 4px 12px; border-radius: 4px; border: 1px solid var(--border-medium);
    font-size: 12px; cursor: pointer; font-family: inherit;
    background: var(--beige); color: var(--noir); transition: all 0.15s;
  }
  .st-chip.active { background: #F43F5E; color: white; }
  .st-chip:hover { background: #F4F4F3; }
  .st-chip.active:hover { background: #F43F5E; opacity: 0.9; }

  .users-table { width: 100%; font-size: 13px; }
  .users-table th {
    text-align: left; font-size: 11px; font-weight: 500; color: #A8A8A4;
    text-transform: uppercase; letter-spacing: 0.08em; padding: 6px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .users-table td { padding: 8px 0; border-bottom: 1px solid var(--color-border); color: var(--noir); }
  .role-badge { font-size: 10px; padding: 2px 8px; border-radius: 0; font-family: 'IBM Plex Mono', monospace; font-weight: 400; letter-spacing: 0.06em; }
  .role-admin { background: #F4F4F3; color: #737370; }
  .role-user { background: #F4F4F3; color: #737370; }
  .role-compliance_officer { background: #F4F4F3; color: #737370; }

  .st-plan-badge { padding: 4px 12px; border-radius: 20px; font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 400; letter-spacing: 0.06em; }
  .st-plan-demo { background: #F4F4F3; color: #737370; border: 1px solid #E4E4E2; }
  .st-plan-starter { background: #F4F4F3; color: #737370; border: 1px solid #E4E4E2; }
  .st-plan-pro { background: #F4F4F3; color: #737370; border: 1px solid #E4E4E2; }

  /* Wizard progress bar */
  .wiz-progress { display: flex; align-items: center; gap: 0; margin-bottom: 8px; }
  .wiz-dot {
    width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--border-medium);
    background: var(--beige); font-size: 12px; font-weight: 600; color: var(--color-text-tertiary);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    transition: all 0.2s; font-family: inherit;
  }
  .wiz-dot.active { background: #F43F5E; color: #fff; border-color: #F43F5E; }
  .wiz-dot.done { background: #FFF5F7; color: #C0304A; border-color: #FBBCC7; }
  .wiz-line { flex: 1; height: 2px; background: var(--border-medium); }
  .wiz-step-label {
    font-size: 12px; font-weight: 500; color: #F43F5E; margin-bottom: 16px;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .wiz-step { min-height: 120px; }

  /* Wizard radios */
  .wiz-radios { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
  .wiz-radio {
    padding: 8px 16px; border: 1px solid var(--border-medium); border-radius: 4px;
    font-size: 13px; cursor: pointer; transition: all 0.15s; background: var(--beige);
    color: var(--noir); font-family: inherit;
  }
  .wiz-radio input { display: none; }
  .wiz-radio.selected { background: #F43F5E; color: #fff; border-color: #F43F5E; }
  .wiz-radio:hover { border-color: #F43F5E; }

  /* Wizard navigation */
  .wiz-nav { display: flex; gap: 12px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--color-border); }
  .wiz-btn {
    padding: 8px 24px; border-radius: 4px; font-size: 13px; font-weight: 500;
    cursor: pointer; font-family: inherit; border: 1px solid var(--border-medium);
    transition: all 0.15s;
  }
  .wiz-btn-prev { background: var(--beige); color: var(--noir); }
  .wiz-btn-next { background: #F43F5E; color: #fff; border-color: #F43F5E; }
  .wiz-btn-save { background: #F43F5E; color: #fff; border-color: #F43F5E; }
  .wiz-btn:hover { opacity: 0.9; }

  /* Services fournis */
  .svc-group-title {
    font-size: 11px; font-weight: 600; color: #737370; text-transform: uppercase;
    letter-spacing: 0.06em; margin: 12px 0 8px; padding-bottom: 4px;
    border-bottom: 1px solid var(--color-border);
  }
  .svc-check {
    display: flex; align-items: center; gap: 8px; padding: 6px 0;
    font-size: 13px; color: var(--noir); cursor: pointer;
  }
  .svc-check input[type="checkbox"] {
    width: 16px; height: 16px; accent-color: #F43F5E; cursor: pointer;
  }
  .svc-check.disabled { opacity: 0.7; cursor: default; }
  .svc-check.disabled input { cursor: default; }
  .svc-legal-ref {
    font-size: 11px; font-style: italic; color: var(--color-text-tertiary);
    margin-top: 8px;
  }
  .svc-separator {
    margin: 14px 0 6px; padding-top: 10px;
    border-top: 1px dashed var(--color-border);
  }
</style>

<script>
  import { api, toast } from '../scripts/api';

  let settingsData: any = {};
  let hasChanges: boolean = false;

  const ENTITY_TYPES: any[] = [
    { value: 'EC', label: 'Etablissement de credit' },
    { value: 'PSP', label: 'Prestataire de services de paiement' },
    { value: 'EME', label: 'Etablissement de monnaie electronique' },
    { value: 'SGP', label: 'Societe de gestion de portefeuille' },
    { value: 'CASP', label: 'Prestataire de services sur actifs numeriques' },
    { value: 'CIF', label: 'Conseiller en investissement financier' },
    { value: 'IFP', label: 'Intermediaire en financement participatif' },
    { value: 'OTHER', label: 'Autre' },
  ];

  // ═══ Services fournis — listes CMF par type d'entité ═══
  const PSP_SERVICES: any[] = [
    { code: 'psp_versement_retrait', label: 'Versement / retrait d\'especes sur compte de paiement' },
    { code: 'psp_prelevement', label: 'Prelevement' },
    { code: 'psp_paiement_carte', label: 'Paiement par carte' },
    { code: 'psp_virement', label: 'Virement' },
    { code: 'psp_emission_instrument', label: 'Emission d\'instrument de paiement' },
    { code: 'psp_acquisition', label: 'Acquisition d\'operations de paiement' },
    { code: 'psp_transmission_fonds', label: 'Transmission de fonds' },
    { code: 'psp_initiation', label: 'Initiation de paiement (DSP2)' },
    { code: 'psp_information_comptes', label: 'Information sur les comptes (DSP2)' },
  ];
  const CASP_OBLIGATOIRE: any[] = [
    { code: 'casp_conservation', label: 'Conservation pour compte de tiers d\'actifs numeriques' },
    { code: 'casp_achat_vente', label: 'Achat / vente d\'actifs numeriques contre monnaie legale' },
    { code: 'casp_echange', label: 'Echange d\'actifs numeriques contre d\'autres actifs numeriques' },
    { code: 'casp_plateforme', label: 'Exploitation d\'une plateforme de negociation' },
  ];
  const CASP_AGREMENT: any[] = [
    { code: 'casp_rto', label: 'Reception et transmission d\'ordres pour compte de tiers' },
    { code: 'casp_gestion_portefeuille', label: 'Gestion de portefeuille d\'actifs numeriques pour compte de tiers' },
    { code: 'casp_conseil', label: 'Conseil aux souscripteurs d\'actifs numeriques' },
    { code: 'casp_prise_ferme', label: 'Prise ferme / placement garanti / placement non garanti' },
  ];

  const REG_PRESELECTION: any = {
    PSP: ['LCB-FT', 'DSP2', 'DORA'],
    EME: ['LCB-FT', 'DSP2', 'DORA'],
    Banque: ['LCB-FT', 'DORA', 'AMLR'],
    CASP: ['LCB-FT', 'MiCA', 'AMLR'],
  };

  function renderServicesSection(entityType: string, currentServices: string[]): string {
    if (!entityType) return '';
    let html = '<label style="display:block;font-size:12px;font-weight:500;color:var(--noir);margin-bottom:4px;text-transform:uppercase;letter-spacing:0.1em">Services fournis</label>';

    if (entityType === 'Banque') {
      // Two toggles only
      const creditChecked = currentServices.includes('banque_credit') || !currentServices.length;
      const corrChecked = currentServices.includes('banque_correspondance');
      html += `
        <div class="toggle-row" style="margin:4px 0">
          <div><div class="toggle-label">Activite de credit</div></div>
          <label class="toggle"><input type="checkbox" class="svc-banque-toggle" data-svc="banque_credit" ${creditChecked ? 'checked' : ''}><span class="toggle-slider"></span></label>
        </div>
        <div class="toggle-row" style="margin:4px 0">
          <div><div class="toggle-label">Correspondance bancaire</div></div>
          <label class="toggle"><input type="checkbox" class="svc-banque-toggle" data-svc="banque_correspondance" ${corrChecked ? 'checked' : ''}><span class="toggle-slider"></span></label>
        </div>
        <div class="svc-legal-ref">Les operations de banque (reception de fonds, credit, paiement) sont presumees pour tout etablissement de credit agree — Article L.311-1 CMF</div>
      `;
      return html;
    }

    if (entityType === 'PSP') {
      html += PSP_SERVICES.map(s =>
        `<label class="svc-check"><input type="checkbox" class="svc-cb" data-svc="${s.code}" ${currentServices.includes(s.code) ? 'checked' : ''}> ${s.label}</label>`
      ).join('');
      html += '<div class="svc-legal-ref">Article L.314-1 II CMF</div>';
      return html;
    }

    if (entityType === 'EME') {
      // Fixed non-décochable
      html += `<label class="svc-check disabled"><input type="checkbox" class="svc-cb" data-svc="eme_emission_gestion" checked disabled> Emission et gestion de monnaie electronique</label>`;
      html += '<hr style="margin:8px 0;border:none;border-top:1px solid var(--color-border)">';
      html += PSP_SERVICES.map(s =>
        `<label class="svc-check"><input type="checkbox" class="svc-cb" data-svc="${s.code}" ${currentServices.includes(s.code) ? 'checked' : ''}> ${s.label}</label>`
      ).join('');
      html += '<div class="svc-legal-ref">Articles L.315-1 et L.526-1 CMF</div>';
      return html;
    }

    if (entityType === 'CASP') {
      html += '<div class="svc-group-title">Services necessitant un enregistrement obligatoire (1° a 4°)</div>';
      html += CASP_OBLIGATOIRE.map(s =>
        `<label class="svc-check"><input type="checkbox" class="svc-cb" data-svc="${s.code}" ${currentServices.includes(s.code) ? 'checked' : ''}> ${s.label}</label>`
      ).join('');
      html += '<div class="svc-separator"></div>';
      html += '<div class="svc-group-title">Services necessitant un agrement optionnel (5°)</div>';
      html += CASP_AGREMENT.map(s =>
        `<label class="svc-check"><input type="checkbox" class="svc-cb" data-svc="${s.code}" ${currentServices.includes(s.code) ? 'checked' : ''}> ${s.label}</label>`
      ).join('');
      html += '<div class="svc-legal-ref">Article L.54-10-2 CMF</div>';
      return html;
    }

    return '';
  }

  const ALL_REGULATIONS: string[] = ['LCB-FT', 'DORA', 'DSP2', 'MiCA', 'AI Act', 'AMLR', 'PSD3', 'RGPD'];
  const SEVERITIES: string[] = ['critical', 'high', 'medium', 'low'];
  const SEV_LABELS: any = { critical: 'Critique', high: 'Eleve', medium: 'Moyen', low: 'Faible' };

  async function loadSettings(): Promise<void> {
    try {
      const data: any = await api('/api/v1/settings');
      settingsData = data;
      renderSettings(data);
    } catch (e: any) {
      document.getElementById('content')!.innerHTML = `<div class="loading">Erreur : ${e.message}</div>`;
    }
  }

  function renderSettings(data: any): void {
    const t: any = data.tenant || {};
    const s: any = data.settings || {};
    const p: any = data.profile || {};
    const users: any[] = data.users || [];
    const counts: any = data.counts || {};

    const entityOpts: string = ENTITY_TYPES.map((et: any) =>
      `<option value="${et.value}" ${et.value === (s.entity_type || '') ? 'selected' : ''}>${et.label}</option>`
    ).join('');

    const regChips: string = ALL_REGULATIONS.map((r: string) => {
      const active: string = (s.regulations || []).includes(r) ? 'active' : '';
      return `<button class="st-chip ${active}" data-reg="${r}">${r}</button>`;
    }).join('');

    const sevChips: string = SEVERITIES.map((sv: string) => {
      const active: string = (s.alert_severities || ['critical', 'high']).includes(sv) ? 'active' : '';
      return `<button class="st-chip ${active}" data-sev="${sv}">${SEV_LABELS[sv]}</button>`;
    }).join('');

    // Organisation profile data — v2 keys (with v1 fallbacks)
    const profil_v2: any = s.profil || {};
    const conf: any = s.conformite || {};
    const outils: any = s.outils || {};
    const perim: any = s.perimetre || {};
    // v1 legacy fallbacks
    const org: any = s.organisation || {};
    const sys_: any = s.systemes || {};
    const seuils: any = s.seuils || {};
    // Resolve entity_type: v2 > root > v1
    const resolvedEntityType: string = profil_v2.entity_type || s.entity_type || '';
    const resolvedNom: string = profil_v2.nom_etablissement || org.nom_etablissement || t.name || '';

    const CLIENT_TYPES: string[] = ['Particuliers', 'Entreprises', 'Institutionnels'];
    const GEO_ZONES: string[] = ['France uniquement', 'Union europeenne', 'International'];

    const clientChips: string = CLIENT_TYPES.map((ct: string) => {
      const active: string = (perim.types_clients || []).includes(ct) ? 'active' : '';
      return `<button class="st-chip ${active}" data-client="${ct}">${ct}</button>`;
    }).join('');

    const zoneChips: string = GEO_ZONES.map((z: string) => {
      const active: string = (perim.zones_geographiques || []).includes(z) ? 'active' : '';
      return `<button class="st-chip ${active}" data-zone="${z}">${z}</button>`;
    }).join('');

    const planCls: string = t.plan === 'pro' ? 'st-plan-pro' : t.plan === 'starter' ? 'st-plan-starter' : 'st-plan-demo';

    const usersRows: string = users.map((u: any) => {
      const roleCls: string = u.role === 'admin' ? 'role-admin' : u.role === 'compliance_officer' ? 'role-compliance_officer' : 'role-user';
      const lastLogin: string = u.last_login_at ? new Date(u.last_login_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Jamais';
      return `<tr>
        <td>${u.first_name || ''} ${u.last_name || ''}</td>
        <td>${u.email}</td>
        <td><span class="role-badge ${roleCls}">${u.role}</span></td>
        <td>${lastLogin}</td>
        <td>${u.is_active ? 'Actif' : 'Inactif'}</td>
      </tr>`;
    }).join('');

    document.getElementById('content')!.innerHTML = `
      <div class="st-section">
        <div class="st-section-header">
          Profil d'assujetti
          <span class="st-plan-badge ${planCls}">${t.plan || 'demo'}</span>
        </div>
        <div class="st-section-body">
          <div class="st-form-row">
            <div class="st-form-group">
              <label>Nom de l'etablissement</label>
              <input type="text" id="f-name" value="${t.name || ''}">
            </div>
            <div class="st-form-group">
              <label>Type d'entite</label>
              <select id="f-entity-type">${entityOpts}</select>
            </div>
          </div>
          <div class="st-form-row">
            <div class="st-form-group">
              <label>N ACPR / AMF</label>
              <input type="text" id="f-acpr" value="${s.acpr_number || ''}" placeholder="Ex: 12345">
            </div>
          </div>
          <div class="st-form-group">
            <label>Reglementations applicables</label>
            <div class="st-chips" id="chips-reg">${regChips}</div>
          </div>
        </div>
      </div>

      <!-- ═══ PROFIL ORGANISATION v2 — Wizard 4 étapes ═══ -->
      <div class="st-section" id="wizard-org">
        <div class="st-section-header">Profil organisation</div>
        <div class="st-section-body">
          <!-- Progress bar -->
          <div class="wiz-progress">
            <button class="wiz-dot active" data-wstep="1">1</button>
            <div class="wiz-line"></div>
            <button class="wiz-dot" data-wstep="2">2</button>
            <div class="wiz-line"></div>
            <button class="wiz-dot" data-wstep="3">3</button>
            <div class="wiz-line"></div>
            <button class="wiz-dot" data-wstep="4">4</button>
          </div>
          <div class="wiz-step-label" id="wiz-step-label">Etape 1 — Etablissement</div>

          <!-- Step 1: Etablissement -->
          <div class="wiz-step" id="wiz-step-1">
            <div class="st-form-group" style="margin-bottom:16px">
              <label>Nom de l'etablissement *</label>
              <input type="text" id="f-profil-nom" value="${resolvedNom}" required>
            </div>
            <div class="st-form-group">
              <label>Type d'entite *</label>
              <div class="wiz-radios" id="wiz-entity-radios">
                <label class="wiz-radio ${resolvedEntityType === 'PSP' ? 'selected' : ''}"><input type="radio" name="wiz-entity" value="PSP" ${resolvedEntityType === 'PSP' ? 'checked' : ''}> PSP</label>
                <label class="wiz-radio ${resolvedEntityType === 'Banque' || resolvedEntityType === 'EC' ? 'selected' : ''}"><input type="radio" name="wiz-entity" value="Banque" ${resolvedEntityType === 'Banque' || resolvedEntityType === 'EC' ? 'checked' : ''}> Banque</label>
                <label class="wiz-radio ${resolvedEntityType === 'CASP' ? 'selected' : ''}"><input type="radio" name="wiz-entity" value="CASP" ${resolvedEntityType === 'CASP' ? 'checked' : ''}> CASP</label>
                <label class="wiz-radio ${resolvedEntityType === 'EME' ? 'selected' : ''}"><input type="radio" name="wiz-entity" value="EME" ${resolvedEntityType === 'EME' ? 'checked' : ''}> EME</label>
              </div>
            </div>
            <!-- Services fournis (conditionnel selon entity_type) -->
            <div id="services-section" style="margin-top:16px;${resolvedEntityType ? '' : 'display:none'}">
              <div id="services-content"></div>
            </div>
          </div>

          <!-- Step 2: Equipe conformite -->
          <div class="wiz-step" id="wiz-step-2" style="display:none">
            <div class="st-form-row">
              <div class="st-form-group"><label>Responsable LCB-FT — Nom *</label><input type="text" id="f-conf-lcbft-nom" value="${conf.responsable_lcbft_nom || ''}"></div>
              <div class="st-form-group"><label>Responsable LCB-FT — Fonction *</label><input type="text" id="f-conf-lcbft-fn" value="${conf.responsable_lcbft_fonction || ''}"></div>
            </div>
            <div class="st-form-row">
              <div class="st-form-group"><label>Suppleant — Nom</label><input type="text" id="f-conf-suppleant" value="${conf.responsable_lcbft_suppleant || ''}"></div>
            </div>
            <div class="toggle-row" style="margin:12px 0">
              <div><div class="toggle-label">Le declarant Tracfin est le responsable LCB-FT</div></div>
              <label class="toggle"><input type="checkbox" id="f-conf-declarant-est-resp" ${conf.declarant_est_responsable ? 'checked' : ''}><span class="toggle-slider"></span></label>
            </div>
