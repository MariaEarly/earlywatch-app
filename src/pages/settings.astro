  function markChanged(): void {
    hasChanges = true;
    document.getElementById('save-bar')!.classList.add('visible');
  }

  function collectServices(entityType: string): string[] {
    if (entityType === 'Banque') {
      // Banque: collect toggle values as service codes
      const svcs: string[] = [];
      document.querySelectorAll('.svc-banque-toggle').forEach((el: any) => {
        if (el.checked) svcs.push(el.dataset.svc);
      });
      return svcs;
    }
    // PSP, EME, CASP: collect checked checkboxes
    const svcs: string[] = [];
    document.querySelectorAll('.svc-cb').forEach((el: any) => {
      if (el.checked) svcs.push(el.dataset.svc);
    });
    // EME: always include eme_emission_gestion (disabled checkbox)
    if (entityType === 'EME' && !svcs.includes('eme_emission_gestion')) {
      svcs.unshift('eme_emission_gestion');
    }
    return svcs;
  }

  async function saveAll(): Promise<void> {
    try {
      const regs: string[] = Array.from(document.querySelectorAll('#chips-reg .st-chip.active')).map((c: any) => c.dataset.reg);
      const sevs: string[] = Array.from(document.querySelectorAll('#chips-sev .st-chip.active')).map((c: any) => c.dataset.sev);

      const clients: string[] = Array.from(document.querySelectorAll('#chips-clients .st-chip.active')).map((c: any) => c.dataset.client);
      const zones: string[] = Array.from(document.querySelectorAll('#chips-zones .st-chip.active')).map((c: any) => c.dataset.zone);

      // Build entity type from wizard
      const wizEntity: string = (document.querySelector('input[name="wiz-entity"]:checked') as HTMLInputElement)?.value || '';
      const declarantEstResp: boolean = (document.getElementById('f-conf-declarant-est-resp') as HTMLInputElement)?.checked || false;
      const respNom: string = (document.getElementById('f-conf-lcbft-nom') as HTMLInputElement)?.value || '';
      const respFn: string = (document.getElementById('f-conf-lcbft-fn') as HTMLInputElement)?.value || '';

      await api('/api/v1/settings', {
        method: 'PUT',
        body: {
          name: (document.getElementById('f-name') as HTMLInputElement).value,
          entity_type: wizEntity || (document.getElementById('f-entity-type') as HTMLSelectElement).value,
          acpr_number: (document.getElementById('f-acpr') as HTMLInputElement).value,
          regulations: regs,
          alert_email_enabled: (document.getElementById('f-alert-email') as HTMLInputElement).checked,
          alert_severities: sevs,
          alert_digest: (document.getElementById('f-digest') as HTMLSelectElement).value,
          procedures_enabled: (document.getElementById('f-mod-procs') as HTMLInputElement).checked,
          country_risk_enabled: (document.getElementById('f-mod-country') as HTMLInputElement).checked,
          roadmap_enabled: (document.getElementById('f-mod-roadmap') as HTMLInputElement).checked,
          situations_enabled: (document.getElementById('f-mod-situations') as HTMLInputElement).checked,
          // v2 profil organisation
          profil: {
            nom_etablissement: (document.getElementById('f-profil-nom') as HTMLInputElement)?.value || '',
            entity_type: wizEntity,
            services: collectServices(wizEntity),
          },
          conformite: {
            responsable_lcbft_nom: respNom,
            responsable_lcbft_fonction: respFn,
            responsable_lcbft_suppleant: (document.getElementById('f-conf-suppleant') as HTMLInputElement)?.value || '',
            declarant_tracfin_nom: declarantEstResp ? respNom : ((document.getElementById('f-conf-tracfin-nom') as HTMLInputElement)?.value || ''),
            declarant_tracfin_fonction: declarantEstResp ? respFn : ((document.getElementById('f-conf-tracfin-fn') as HTMLInputElement)?.value || ''),
            declarant_est_responsable: declarantEstResp,
            controle_periodique: (document.querySelector('input[name="wiz-controle"]:checked') as HTMLInputElement)?.value || 'interne',
            controle_periodique_prestataire: (document.getElementById('f-conf-prestataire') as HTMLInputElement)?.value || '',
          },
          outils: {
            screening: (document.getElementById('f-outils-screening') as HTMLSelectElement)?.value || '',
            screening_autre: (document.getElementById('f-outils-screening-autre') as HTMLInputElement)?.value || '',
            kyc: (document.getElementById('f-outils-kyc') as HTMLSelectElement)?.value || '',
            kyc_autre: (document.getElementById('f-outils-kyc-autre') as HTMLInputElement)?.value || '',
            monitoring: (document.querySelector('input[name="wiz-monitoring"]:checked') as HTMLInputElement)?.value || 'interne',
            monitoring_outil: (document.getElementById('f-outils-monitoring-outil') as HTMLInputElement)?.value || '',
            signalement_interne: (document.getElementById('f-outils-signalement') as HTMLSelectElement)?.value || '',
            blockchain_analytics: (document.getElementById('f-outils-blockchain') as HTMLSelectElement)?.value || '',
            blockchain_analytics_autre: (document.getElementById('f-outils-blockchain-autre') as HTMLInputElement)?.value || '',
            blockchain_seuil: parseInt((document.getElementById('f-outils-blockchain-seuil') as HTMLInputElement)?.value) || 75,
          },
          perimetre: {
            types_clients: clients,
            zones_geographiques: zones,
            canal_entree_relation: (document.querySelector('input[name="wiz-canal"]:checked') as HTMLInputElement)?.value || '',
            transferts_fonds: (document.getElementById('f-per-transferts') as HTMLInputElement)?.checked || false,
            correspondance_bancaire: (document.getElementById('f-per-correspondance') as HTMLInputElement)?.checked || false,
            agents_distributeurs: (document.getElementById('f-per-agents') as HTMLInputElement)?.checked || false,
          },
        },
      });

      await api('/api/v1/settings/profile', {
        method: 'PUT',
        body: {
          first_name: (document.getElementById('f-firstname') as HTMLInputElement).value,
          last_name: (document.getElementById('f-lastname') as HTMLInputElement).value,
          email: (document.getElementById('f-email') as HTMLInputElement).value,
        },
      });

      hasChanges = false;
      document.getElementById('save-bar')!.classList.remove('visible');
      toast('Parametres enregistres', 'success');
    } catch (e: any) {
      toast(e.message || 'Erreur', 'error');
    }
  }

  document.getElementById('btn-save')!.addEventListener('click', saveAll);

  // ═══ Wizard step logic ═══
  const STEP_LABELS: string[] = ['', 'Etape 1 — Etablissement', 'Etape 2 — Equipe conformite', 'Etape 3 — Outils', 'Etape 4 — Perimetre'];
  let wizStep: number = 1;

  function showWizStep(step: number): void {
    wizStep = step;
    for (let i = 1; i <= 4; i++) {
      const el: HTMLElement | null = document.getElementById(`wiz-step-${i}`);
      if (el) el.style.display = i === step ? '' : 'none';
    }
    // Update dots
    document.querySelectorAll('.wiz-dot').forEach((dot: any) => {
      const s: number = parseInt(dot.dataset.wstep);
      dot.classList.remove('active', 'done');
      if (s === step) dot.classList.add('active');
      else if (s < step) dot.classList.add('done');
    });
    // Update label
    const label: HTMLElement | null = document.getElementById('wiz-step-label');
    if (label) label.textContent = STEP_LABELS[step] || '';
    // Update buttons
    const prev: HTMLElement | null = document.getElementById('wiz-prev');
    const next: HTMLElement | null = document.getElementById('wiz-next');
    const save: HTMLElement | null = document.getElementById('wiz-save');
    if (prev) prev.style.display = step > 1 ? '' : 'none';
    if (next) next.style.display = step < 4 ? '' : 'none';
    if (save) save.style.display = step === 4 ? '' : 'none';
  }

  function initWizard(): void {
    // Dot click navigation
    document.querySelectorAll('.wiz-dot').forEach((dot: any) => {
      dot.addEventListener('click', () => showWizStep(parseInt(dot.dataset.wstep)));
    });
    // Prev/Next
    document.getElementById('wiz-prev')?.addEventListener('click', () => { if (wizStep > 1) showWizStep(wizStep - 1); });
    document.getElementById('wiz-next')?.addEventListener('click', () => { if (wizStep < 4) showWizStep(wizStep + 1); });
    // Save button triggers main save
    document.getElementById('wiz-save')?.addEventListener('click', saveAll);

    // Radio button styling
    document.querySelectorAll('.wiz-radios').forEach((group: any) => {
      group.querySelectorAll('.wiz-radio').forEach((label: any) => {
        label.addEventListener('click', () => {
          group.querySelectorAll('.wiz-radio').forEach((l: any) => l.classList.remove('selected'));
          label.classList.add('selected');
          markChanged();
          // Entity type change → toggle conditional fields
          const radio: HTMLInputElement | null = label.querySelector('input[name="wiz-entity"]');
          if (radio) onEntityTypeChange(radio.value);
          // Controle periodique change
          const ctrlRadio: HTMLInputElement | null = label.querySelector('input[name="wiz-controle"]');
          if (ctrlRadio) {
            const el: HTMLElement | null = document.getElementById('controle-prestataire');
            if (el) el.style.display = ctrlRadio.value === 'externe' ? '' : 'none';
          }
          // Monitoring change
          const monRadio: HTMLInputElement | null = label.querySelector('input[name="wiz-monitoring"]');
          if (monRadio) {
            const el: HTMLElement | null = document.getElementById('monitoring-outil-group');
            if (el) el.style.display = monRadio.value === 'outil' ? '' : 'none';
          }
        });
      });
    });

    // Declarant est responsable toggle
    document.getElementById('f-conf-declarant-est-resp')?.addEventListener('change', (e: any) => {
      const el: HTMLElement | null = document.getElementById('declarant-fields');
      if (el) el.style.display = e.target.checked ? 'none' : '';
      markChanged();
    });

    // Select "Autre" toggles
    document.getElementById('f-outils-screening')?.addEventListener('change', (e: any) => {
      const el: HTMLElement | null = document.getElementById('screening-autre-group');
      if (el) el.style.display = e.target.value === 'autre' ? '' : 'none';
      markChanged();
    });
    document.getElementById('f-outils-kyc')?.addEventListener('change', (e: any) => {
      const el: HTMLElement | null = document.getElementById('kyc-autre-group');
      if (el) el.style.display = e.target.value === 'autre' ? '' : 'none';
      markChanged();
    });
    document.getElementById('f-outils-blockchain')?.addEventListener('change', (e: any) => {
      const el: HTMLElement | null = document.getElementById('blockchain-autre-group');
      if (el) el.style.display = e.target.value === 'autre' ? '' : 'none';
      markChanged();
    });
  }

  function bindServicesEvents(): void {
    document.querySelectorAll('.svc-cb, .svc-banque-toggle').forEach((el: any) => {
      el.addEventListener('change', markChanged);
    });
  }

  function onEntityTypeChange(entityType: string): void {
    // Blockchain analytics: visible only for CASP
    const bc: HTMLElement | null = document.getElementById('blockchain-section');
    if (bc) bc.style.display = entityType === 'CASP' ? '' : 'none';
    // Transferts de fonds: PSP or EME
    const tf: HTMLElement | null = document.getElementById('toggle-transferts');
    if (tf) tf.style.display = ['PSP', 'EME'].includes(entityType) ? '' : 'none';
    // Correspondance bancaire: Banque only
    const cb: HTMLElement | null = document.getElementById('toggle-correspondance');
    if (cb) cb.style.display = entityType === 'Banque' ? '' : 'none';

    // Render services section
    const svcEl: HTMLElement | null = document.getElementById('services-content');
    const svcSection: HTMLElement | null = document.getElementById('services-section');
    if (svcEl) {
      svcEl.innerHTML = renderServicesSection(entityType, []);
      if (svcSection) svcSection.style.display = entityType ? '' : 'none';
      bindServicesEvents();
    }

    // Preselect regulations if currently empty
    const regChips: NodeListOf<Element> = document.querySelectorAll('#chips-reg .st-chip');
    const activeRegs: Element[] = Array.from(regChips).filter((c: any) => c.classList.contains('active'));
    if (activeRegs.length === 0 && REG_PRESELECTION[entityType]) {
      const presel: string[] = REG_PRESELECTION[entityType];
      regChips.forEach((chip: any) => {
        if (presel.includes(chip.dataset.reg)) {
          chip.classList.add('active');
        }
      });
      markChanged();
    }
  }

  // Initialize after render
  const _origRender: typeof renderSettings = renderSettings;
  (renderSettings as any) = function(data: any): void {
    _origRender(data);
    initWizard();
    showWizStep(1);
    // Render services for current entity type
    const s: any = data.settings || {};
    const profil_v2_init: any = s.profil || {};
    const currentET: string = profil_v2_init.entity_type || s.entity_type || '';
    const currentSvc: string[] = profil_v2_init.services || [];
    const svcEl: HTMLElement | null = document.getElementById('services-content');
    const svcSection: HTMLElement | null = document.getElementById('services-section');
    if (svcEl && currentET) {
      svcEl.innerHTML = renderServicesSection(currentET, currentSvc);
      if (svcSection) svcSection.style.display = '';
      bindServicesEvents();
    }
  };

  loadSettings();
</script>
