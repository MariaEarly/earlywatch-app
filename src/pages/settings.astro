---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Parametres — Early Watch" activePage="settings">
  <div class="st-layout">
    <div class="st-main">
      <div class="page-title">Parametres</div>
      <div class="page-subtitle">Profil d'assujetti, preferences d'alertes et utilisateurs</div>

      <div id="content">
        <div class="loading">Chargement des parametres...</div>
      </div>

      <div class="save-bar" id="save-bar">
        <button class="btn-save" id="btn-save">Enregistrer les modifications</button>
      </div>
    </div>
  </div>
</AppLayout>

<style>
  .st-layout { min-height: 100vh; display: flex; flex-direction: column; }
  .st-main { flex: 1; max-width: 900px; margin: 0 auto; padding: 32px 24px; width: 100%; }
  .page-title { font-size: 15px; font-weight: 500; color: var(--noir); margin-bottom: 4px; }
  .page-subtitle { font-size: 14px; color: var(--color-text-tertiary); margin-bottom: 28px; }

  .save-bar {
    position: sticky; bottom: 0; padding: 16px 0; background: rgba(237,234,227,0.95);
    border-top: 1px solid var(--color-border); text-align: right; display: none;
  }
  :global(.save-bar.visible) { display: block; }
  .btn-save {
    padding: 10px 28px; background: var(--kaki); color: var(--beige);
    border: 1px solid var(--text-primary); border-radius: 4px; font-size: 14px;
    font-weight: 500; cursor: pointer; font-family: inherit;
    box-shadow: none; transition: all 0.15s;
  }
  .btn-save:hover { }
  .loading { padding: 40px; text-align: center; color: var(--color-text-tertiary); font-size: 14px; }
</style>

<style is:global>
  .st-section {
    background: var(--beige); border: 1px solid var(--border-light); border-radius: 0;
    box-shadow: none; margin-bottom: 20px; overflow: hidden;
  }
  .st-section-header {
    padding: 14px 20px; font-size: 14px; font-weight: 500; color: var(--noir);
    border-bottom: 1px solid var(--color-border); display: flex;
    justify-content: space-between; align-items: center;
  }
  .st-section-body { padding: 20px; }

  .st-form-row { display: flex; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }
  .st-form-group { flex: 1; min-width: 200px; }
  .st-form-group label {
    display: block; font-size: 12px; font-weight: 500; color: var(--noir);
    margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.1em;
  }
  .st-form-group input, .st-form-group select {
    width: 100%; padding: 8px 12px; border: 1px solid var(--border-medium);
    border-radius: 4px; font-size: 13px; font-family: inherit; background: #EDEAE3; color: var(--noir);
  }
  .st-form-group input:focus, .st-form-group select:focus {
    outline: none; border-color: var(--kaki); box-shadow: none;
  }

  .toggle-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 0; border-bottom: 1px solid var(--color-border);
  }
  .toggle-row:last-child { border-bottom: none; }
  .toggle-label { font-size: 13px; color: var(--noir); }
  .toggle-desc { font-size: 11px; color: var(--color-text-tertiary); margin-top: 1px; }
  .toggle { position: relative; width: 44px; height: 24px; cursor: pointer; }
  .toggle input { opacity: 0; width: 0; height: 0; }
  .toggle-slider {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: var(--color-border); border-radius: 0; transition: 0.2s; border: 1px solid var(--noir);
  }
  .toggle-slider::before {
    content: ''; position: absolute; height: 18px; width: 18px;
    left: 2px; bottom: 2px; background: #EDEAE3; border-radius: 0;
    transition: 0.2s;
  }
  .toggle input:checked + .toggle-slider { background: var(--kaki); }
  .toggle input:checked + .toggle-slider::before { transform: translateX(20px); }

  .st-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
  .st-chip {
    padding: 4px 12px; border-radius: 4px; border: 1px solid var(--border-medium);
    font-size: 12px; cursor: pointer; font-family: inherit;
    background: var(--beige); color: var(--noir); transition: all 0.15s;
  }
  .st-chip.active { background: var(--kaki); color: var(--beige); }
  .st-chip:hover { background: var(--beige2); }
  .st-chip.active:hover { background: var(--kaki); opacity: 0.9; }

  .users-table { width: 100%; font-size: 13px; }
  .users-table th {
    text-align: left; font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 400; color: var(--color-text-tertiary);
    text-transform: uppercase; letter-spacing: 0.08em; padding: 6px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .users-table td { padding: 8px 0; border-bottom: 1px solid var(--color-border); color: var(--noir); }
  .role-badge { font-size: 10px; padding: 2px 8px; border-radius: 0; font-family: 'IBM Plex Mono', monospace; font-weight: 400; letter-spacing: 0.06em; }
  .role-admin { background: rgba(92,99,71,0.15); color: #5C6347; }
  .role-user { background: rgba(92,99,71,0.05); color: #5C6347; }
  .role-compliance_officer { background: rgba(92,99,71,0.1); color: #5C6347; }

  .st-plan-badge { padding: 4px 12px; border-radius: 0; font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 400; letter-spacing: 0.06em; }
  .st-plan-demo { background: rgba(92,99,71,0.1); color: #5C6347; border: 1px solid #5C6347; }
  .st-plan-starter { background: rgba(92,99,71,0.15); color: #5C6347; border: 1px solid #5C6347; }
  .st-plan-pro { background: rgba(92,99,71,0.25); color: #5C6347; border: 1px solid #5C6347; }
</style>

<script>
  import { api, toast } from '../scripts/api';

  let settingsData: any = {};
  let hasChanges: boolean = false;

  const ENTITY_TYPES: any[] = [
    { value: 'EC', label: 'Etablissement de credit' },
    { value: 'PSP', label: 'Prestataire de services de paiement' },
    { value: 'EME', label: 'Etablissement de monnaie electronique' },
    { value: 'SGP', label: 'Societe de gestion de portefeuille' },
    { value: 'CASP', label: 'Prestataire de services sur actifs numeriques' },
    { value: 'CIF', label: 'Conseiller en investissement financier' },
    { value: 'IFP', label: 'Intermediaire en financement participatif' },
    { value: 'OTHER', label: 'Autre' },
  ];

  const ALL_REGULATIONS: string[] = ['LCB-FT', 'DORA', 'DSP2', 'MiCA', 'AI Act', 'AMLR', 'PSD3', 'RGPD'];
  const SEVERITIES: string[] = ['critical', 'high', 'medium', 'low'];
  const SEV_LABELS: any = { critical: 'Critique', high: 'Eleve', medium: 'Moyen', low: 'Faible' };

  async function loadSettings(): Promise<void> {
    try {
      const data: any = await api('/api/v1/settings');
      settingsData = data;
      renderSettings(data);
    } catch (e: any) {
      document.getElementById('content')!.innerHTML = `<div class="loading">Erreur : ${e.message}</div>`;
    }
  }

  function renderSettings(data: any): void {
    const t: any = data.tenant || {};
    const s: any = data.settings || {};
    const p: any = data.profile || {};
    const users: any[] = data.users || [];
    const counts: any = data.counts || {};

    const entityOpts: string = ENTITY_TYPES.map((et: any) =>
      `<option value="${et.value}" ${et.value === (s.entity_type || '') ? 'selected' : ''}>${et.label}</option>`
    ).join('');

    const regChips: string = ALL_REGULATIONS.map((r: string) => {
      const active: string = (s.regulations || []).includes(r) ? 'active' : '';
      return `<button class="st-chip ${active}" data-reg="${r}">${r}</button>`;
    }).join('');

    const sevChips: string = SEVERITIES.map((sv: string) => {
      const active: string = (s.alert_severities || ['critical', 'high']).includes(sv) ? 'active' : '';
      return `<button class="st-chip ${active}" data-sev="${sv}">${SEV_LABELS[sv]}</button>`;
    }).join('');

    const planCls: string = t.plan === 'pro' ? 'st-plan-pro' : t.plan === 'starter' ? 'st-plan-starter' : 'st-plan-demo';

    const usersRows: string = users.map((u: any) => {
      const roleCls: string = u.role === 'admin' ? 'role-admin' : u.role === 'compliance_officer' ? 'role-compliance_officer' : 'role-user';
      const lastLogin: string = u.last_login_at ? new Date(u.last_login_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Jamais';
      return `<tr>
        <td>${u.first_name || ''} ${u.last_name || ''}</td>
        <td>${u.email}</td>
        <td><span class="role-badge ${roleCls}">${u.role}</span></td>
        <td>${lastLogin}</td>
        <td>${u.is_active ? 'Actif' : 'Inactif'}</td>
      </tr>`;
    }).join('');

    document.getElementById('content')!.innerHTML = `
      <div class="st-section">
        <div class="st-section-header">
          Profil d'assujetti
          <span class="st-plan-badge ${planCls}">${t.plan || 'demo'}</span>
        </div>
        <div class="st-section-body">
          <div class="st-form-row">
            <div class="st-form-group">
              <label>Nom de l'etablissement</label>
              <input type="text" id="f-name" value="${t.name || ''}">
            </div>
            <div class="st-form-group">
              <label>Type d'entite</label>
              <select id="f-entity-type">${entityOpts}</select>
            </div>
          </div>
          <div class="st-form-row">
            <div class="st-form-group">
              <label>Sous-type</label>
              <input type="text" id="f-entity-subtype" value="${s.entity_subtype || ''}">
            </div>
            <div class="st-form-group">
              <label>N ACPR / AMF</label>
              <input type="text" id="f-acpr" value="${s.acpr_number || ''}" placeholder="Ex: 12345">
            </div>
          </div>
          <div class="st-form-group">
            <label>Reglementations applicables</label>
            <div class="st-chips" id="chips-reg">${regChips}</div>
          </div>
        </div>
      </div>

      <div class="st-section">
        <div class="st-section-header">Preferences d'alertes</div>
        <div class="st-section-body">
          <div class="toggle-row">
            <div>
              <div class="toggle-label">Alertes email</div>
              <div class="toggle-desc">Recevoir un email pour chaque reminder selon la severite selectionnee</div>
            </div>
            <label class="toggle">
              <input type="checkbox" id="f-alert-email" ${s.alert_email_enabled ? 'checked' : ''}>
              <span class="toggle-slider"></span>
            </label>
          </div>
          <div style="margin-top:12px">
            <label style="display:block;font-size:12px;font-weight:500;color:var(--noir);margin-bottom:4px;text-transform:uppercase;letter-spacing:0.1em">Severites declenchant un email</label>
            <div class="st-chips" id="chips-sev">${sevChips}</div>
          </div>
          <div class="st-form-row" style="margin-top:16px">
            <div class="st-form-group">
              <label>Mode d'envoi</label>
              <select id="f-digest">
                <option value="immediate" ${s.alert_digest === 'immediate' ? 'selected' : ''}>Immediat</option>
                <option value="daily" ${s.alert_digest === 'daily' ? 'selected' : ''}>Digest quotidien</option>
                <option value="weekly" ${s.alert_digest === 'weekly' ? 'selected' : ''}>Digest hebdomadaire</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="st-section">
        <div class="st-section-header">Modules actifs</div>
        <div class="st-section-body">
          <div class="toggle-row">
            <div><div class="toggle-label">Procedures LCB-FT</div><div class="toggle-desc">${counts.procedures_count || 0} procedures attribuees</div></div>
            <label class="toggle"><input type="checkbox" id="f-mod-procs" ${s.procedures_enabled ? 'checked' : ''}><span class="toggle-slider"></span></label>
          </div>
          <div class="toggle-row">
            <div><div class="toggle-label">Pays a risque</div><div class="toggle-desc">Liste FATF / EU / ACPR avec croisement veille</div></div>
            <label class="toggle"><input type="checkbox" id="f-mod-country" ${s.country_risk_enabled !== false ? 'checked' : ''}><span class="toggle-slider"></span></label>
          </div>
          <div class="toggle-row">
            <div><div class="toggle-label">Roadmap reglementaire</div><div class="toggle-desc">Echeances DORA, AMLR, AI Act</div></div>
            <label class="toggle"><input type="checkbox" id="f-mod-roadmap" ${s.roadmap_enabled !== false ? 'checked' : ''}><span class="toggle-slider"></span></label>
          </div>
          <div class="toggle-row">
            <div><div class="toggle-label">Fiches reflexes</div><div class="toggle-desc">Guides operationnels par situation</div></div>
            <label class="toggle"><input type="checkbox" id="f-mod-situations" ${s.situations_enabled !== false ? 'checked' : ''}><span class="toggle-slider"></span></label>
          </div>
        </div>
      </div>

      <div class="st-section">
        <div class="st-section-header">Mon profil</div>
        <div class="st-section-body">
          <div class="st-form-row">
            <div class="st-form-group">
              <label>Prenom</label>
              <input type="text" id="f-firstname" value="${p.first_name || ''}">
            </div>
            <div class="st-form-group">
              <label>Nom</label>
              <input type="text" id="f-lastname" value="${p.last_name || ''}">
            </div>
          </div>
          <div class="st-form-row">
            <div class="st-form-group">
              <label>Email</label>
              <input type="email" id="f-email" value="${p.email || ''}">
            </div>
            <div class="st-form-group">
              <label>Role</label>
              <input type="text" value="${p.role || ''}" disabled style="background:#f5f5f5">
            </div>
          </div>
        </div>
      </div>

      <div class="st-section">
        <div class="st-section-header">Utilisateurs (${users.length})</div>
        <div class="st-section-body">
          <table class="users-table">
            <thead><tr><th>Nom</th><th>Email</th><th>Role</th><th>Derniere connexion</th><th>Statut</th></tr></thead>
            <tbody>${usersRows || '<tr><td colspan="5" style="color:var(--color-text-tertiary)">Aucun utilisateur</td></tr>'}</tbody>
          </table>
        </div>
      </div>

      <div style="font-size:12px;color:var(--color-text-tertiary);text-align:center;padding:16px 0">
        ${counts.sources_count || 0} sources surveillees \u00b7 ${counts.procedures_count || 0} procedures \u00b7 ${counts.reminders_active || 0} reminders actifs
      </div>
    `;

    // Bind change events
    document.querySelectorAll('#content input, #content select').forEach((el: any) => {
      el.addEventListener('change', markChanged);
    });

    document.querySelectorAll('.st-chip').forEach((el: any) => {
      el.addEventListener('click', () => {
        el.classList.toggle('active');
        markChanged();
      });
    });
  }

  function markChanged(): void {
    hasChanges = true;
    document.getElementById('save-bar')!.classList.add('visible');
  }

  async function saveAll(): Promise<void> {
    try {
      const regs: string[] = Array.from(document.querySelectorAll('#chips-reg .st-chip.active')).map((c: any) => c.dataset.reg);
      const sevs: string[] = Array.from(document.querySelectorAll('#chips-sev .st-chip.active')).map((c: any) => c.dataset.sev);

      await api('/api/v1/settings', {
        method: 'PUT',
        body: {
          name: (document.getElementById('f-name') as HTMLInputElement).value,
          entity_type: (document.getElementById('f-entity-type') as HTMLSelectElement).value,
          entity_subtype: (document.getElementById('f-entity-subtype') as HTMLInputElement).value,
          acpr_number: (document.getElementById('f-acpr') as HTMLInputElement).value,
          regulations: regs,
          alert_email_enabled: (document.getElementById('f-alert-email') as HTMLInputElement).checked,
          alert_severities: sevs,
          alert_digest: (document.getElementById('f-digest') as HTMLSelectElement).value,
          procedures_enabled: (document.getElementById('f-mod-procs') as HTMLInputElement).checked,
          country_risk_enabled: (document.getElementById('f-mod-country') as HTMLInputElement).checked,
          roadmap_enabled: (document.getElementById('f-mod-roadmap') as HTMLInputElement).checked,
          situations_enabled: (document.getElementById('f-mod-situations') as HTMLInputElement).checked,
        },
      });

      await api('/api/v1/settings/profile', {
        method: 'PUT',
        body: {
          first_name: (document.getElementById('f-firstname') as HTMLInputElement).value,
          last_name: (document.getElementById('f-lastname') as HTMLInputElement).value,
          email: (document.getElementById('f-email') as HTMLInputElement).value,
        },
      });

      hasChanges = false;
      document.getElementById('save-bar')!.classList.remove('visible');
      toast('Parametres enregistres', 'success');
    } catch (e: any) {
      toast(e.message || 'Erreur', 'error');
    }
  }

  document.getElementById('btn-save')!.addEventListener('click', saveAll);

  loadSettings();
</script>
