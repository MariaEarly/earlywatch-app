---
import ClientLayout from '../../layouts/ClientLayout.astro';
const base = import.meta.env.BASE_URL;
---

<ClientLayout title="Tableau de bord" activePage="tableau-de-bord">

  <div class="ew-header">
    <div>
      <h1 class="ew-h-title" id="client-greeting">Bonjour</h1>
      <div style="font-size:13px;color:var(--taupe);margin-top:4px" id="client-last-visit"></div>
    </div>
    <div class="ew-h-date" id="client-today"></div>
  </div>

  <!-- KPIs -->
  <div id="kpi-row" style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:36px">
    <div class="kpi-card" id="kpi-unread">
      <div class="kpi-num">—</div>
      <div class="kpi-label">Articles non lus</div>
    </div>
    <div class="kpi-card" id="kpi-toprocess">
      <div class="kpi-num">—</div>
      <div class="kpi-label">À traiter</div>
    </div>
    <div class="kpi-card" id="kpi-tracker">
      <div class="kpi-num">—</div>
      <div class="kpi-label">Nouvelles entrées tracker</div>
    </div>
    <div class="kpi-card" id="kpi-deadlines">
      <div class="kpi-num">—</div>
      <div class="kpi-label">Échéances &lt; 30 j</div>
    </div>
  </div>

  <!-- Section Ma veille -->
  <section class="client-section">
    <div class="client-section-header">
      <span class="client-section-title">Ma Veille</span>
      <span style="font-size:12px;color:var(--taupe)">5 derniers articles non lus</span>
    </div>
    <div id="preview-veille">
      <div class="ew-loading"><div class="ew-spinner"></div></div>
    </div>
    <a href={`${base}app/veille`} class="client-section-more">Voir tout le fil réglementaire →</a>
  </section>

  <!-- Section Mes tâches -->
  <section class="client-section">
    <div class="client-section-header">
      <span class="client-section-title">Mes Tâches en cours</span>
    </div>
    <div id="preview-tasks">
      <div class="ew-loading"><div class="ew-spinner"></div></div>
    </div>
    <a href={`${base}app/veille?tab=to_process`} class="client-section-more">Voir toutes mes tâches →</a>
  </section>

  <!-- Section Prochaines échéances -->
  <section class="client-section">
    <div class="client-section-header">
      <span class="client-section-title">Prochaines Échéances</span>
    </div>
    <div id="preview-deadlines">
      <div class="ew-loading"><div class="ew-spinner"></div></div>
    </div>
    <a href={`${base}app/feuille-de-route`} class="client-section-more">Voir la feuille de route complète →</a>
  </section>

</ClientLayout>

<style>
  .kpi-card {
    background: var(--bg-side);
    border: 0.5px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 22px;
  }
  .kpi-num {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 8px;
  }
  .kpi-label {
    font-size: 12px;
    color: var(--taupe);
    line-height: 1.4;
  }
  .client-section {
    margin-bottom: 40px;
  }
  .client-section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .client-section-title {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .client-section-more {
    display: block;
    margin-top: 12px;
    font-size: 12px;
    color: var(--taupe);
    text-decoration: none;
    text-align: right;
  }
  .client-section-more:hover { color: var(--ink); text-decoration: underline; }

  /* Carte compacte aperçu veille */
  .preview-card {
    padding: 14px 0;
    border-bottom: 0.5px solid var(--line);
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    align-items: start;
  }
  .preview-card:last-child { border-bottom: none; }
  .preview-card-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--mute);
    text-transform: uppercase;
    margin-bottom: 5px;
  }
  .preview-card-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
  }
  .preview-card-impact {
    font-size: 11px;
    color: var(--taupe);
    margin-top: 4px;
  }

  /* Carte tâche */
  .task-card {
    padding: 12px 16px;
    border: 0.5px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: 8px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .task-card-title { font-size: 13px; font-weight: 500; color: var(--ink); }
  .task-card-meta  { font-size: 11px; color: var(--taupe); white-space: nowrap; }

  /* Échéance */
  .deadline-row {
    padding: 12px 0;
    border-bottom: 0.5px solid var(--line);
    display: flex;
    align-items: baseline;
    gap: 20px;
  }
  .deadline-row:last-child { border-bottom: none; }
  .deadline-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--taupe);
    white-space: nowrap;
    min-width: 80px;
  }
  .deadline-label { font-size: 13px; color: var(--ink); font-weight: 500; }
  .deadline-badge-critical {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: #fff;
    background: #5C6347;
    border-radius: 3px;
    padding: 2px 6px;
    white-space: nowrap;
  }
</style>

<script>
  import { api, getUser, formatDate } from '../../scripts/api';

  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';

  const SIGLES: Record<string, string> = {
    'AMF': 'AMF', 'ACPR': 'ACPR', 'EBA': 'EBA', 'ESMA': 'ESMA',
    'AMLA': 'AMLA', 'OFAC': 'OFAC', 'GAFI': 'GAFI',
  };

  function avatar(source: string): string {
    const s = (source || '').toUpperCase().substring(0, 4);
    return `<div class="ew-source-avatar" style="width:32px;height:32px;font-size:10px">${s}</div>`;
  }

  async function loadDashboard() {
    const user = getUser();
    if (!user) return;

    // Greeting
    const greetEl = document.getElementById('client-greeting');
    if (greetEl) greetEl.textContent = `Bonjour ${user.first_name || ''}`.trim();

    // Date
    const todayEl = document.getElementById('client-today');
    if (todayEl) {
      todayEl.textContent = new Date().toLocaleDateString('fr-FR', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
      });
    }

    // Dernière visite (last_login_at non dispo ici — placeholder)
    const visitEl = document.getElementById('client-last-visit');
    if (visitEl) visitEl.textContent = '';

    try {
      const [articles, deadlines] = await Promise.all([
        api('/api/v1/articles?page_size=50&score_min=11'),
        api('/api/v1/deadlines?include_passed=false'),
      ]);

      const list: any[] = Array.isArray(articles) ? articles : (articles?.items || []);
      const inbox = list.filter((a: any) => a.lifecycle_status === 'inbox' || a.lifecycle_status === 'triaged');

      // KPIs (approximation v1 — avant table tenant_article_states)
      const setKpi = (id: string, val: number) => {
        const el = document.querySelector(`#${id} .kpi-num`);
        if (el) el.textContent = String(val);
      };
      setKpi('kpi-unread',    inbox.length);
      setKpi('kpi-toprocess', 0);
      setKpi('kpi-tracker',   0);

      const dl: any[] = Array.isArray(deadlines) ? deadlines : (deadlines?.deadlines || []);
      const soon = dl.filter((d: any) => {
        const days = Math.ceil((new Date(d.deadline_date).getTime() - Date.now()) / 86400000);
        return days >= 0 && days <= 30;
      });
      setKpi('kpi-deadlines', soon.length);

      // Preview veille — 5 premiers articles inbox
      renderVeille(inbox.slice(0, 5));

      // Preview tâches — vide en v1 (pas de to_process avant migration)
      renderTasks([]);

      // Preview échéances — 3 premières
      renderDeadlines(dl.slice(0, 3));

    } catch (e: any) {
      console.error('Dashboard load error:', e);
    }
  }

  function renderVeille(articles: any[]) {
    const el = document.getElementById('preview-veille');
    if (!el) return;
    if (!articles.length) {
      el.innerHTML = '<div style="font-size:13px;color:var(--taupe);padding:16px 0">Aucun article récent.</div>';
      return;
    }
    el.innerHTML = articles.map((a: any) => `
      <div class="preview-card">
        ${avatar(a.source_name)}
        <div>
          <div class="preview-card-meta">${a.source_name || ''} · ${formatDate(a.published_at)}</div>
          <div class="preview-card-title">${a.title || 'Sans titre'}</div>
          ${a.has_impact && a.impacted_procedures?.length
            ? `<div class="preview-card-impact">Impacte → ${a.impacted_procedures.slice(0,2).join(' · ')}</div>`
            : ''}
        </div>
      </div>
    `).join('');
  }

  function renderTasks(tasks: any[]) {
    const el = document.getElementById('preview-tasks');
    if (!el) return;
    if (!tasks.length) {
      el.innerHTML = '<div style="font-size:13px;color:var(--taupe);padding:12px 0">Aucune tâche en cours.</div>';
      return;
    }
    el.innerHTML = tasks.map((t: any) => `
      <div class="task-card">
        <div class="task-card-title">${t.title || 'Sans titre'}</div>
        <div class="task-card-meta">${formatDate(t.processed_at)}</div>
      </div>
    `).join('');
  }

  function renderDeadlines(deadlines: any[]) {
    const el = document.getElementById('preview-deadlines');
    if (!el) return;
    if (!deadlines.length) {
      el.innerHTML = '<div style="font-size:13px;color:var(--taupe);padding:12px 0">Aucune échéance.</div>';
      return;
    }
    el.innerHTML = deadlines.map((d: any) => {
      const days = Math.ceil((new Date(d.deadline_date).getTime() - Date.now()) / 86400000);
      const inLabel = days <= 0 ? 'Passée' : days === 1 ? 'demain' : `dans ${days} jours`;
      const badge = d.priority === 'critical'
        ? `<span class="deadline-badge-critical">CRITIQUE</span>` : '';
      return `
        <div class="deadline-row">
          <div class="deadline-date">
            ${new Date(d.deadline_date).toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit', year:'numeric' })}
            <div style="font-size:10px;color:var(--mute)">${inLabel}</div>
          </div>
          <div style="flex:1">
            <div class="deadline-label">${d.title || d.regulation || '—'}</div>
            ${d.description ? `<div style="font-size:12px;color:var(--taupe);margin-top:2px">${d.description}</div>` : ''}
          </div>
          ${badge}
        </div>
      `;
    }).join('');
  }

  loadDashboard();
</script>
