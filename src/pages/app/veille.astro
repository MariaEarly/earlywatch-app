---
import ClientLayout from '../../layouts/ClientLayout.astro';
const base = import.meta.env.BASE_URL;
---

<ClientLayout title="Fil réglementaire" activePage="veille">

  <div class="ew-header">
    <h1 class="ew-h-title">Fil réglementaire</h1>
    <div class="ew-h-date" id="client-today"></div>
  </div>

  <!-- Tabs + tri -->
  <div id="veille-tabs-container"></div>

  <!-- Liste articles -->
  <div id="veille-list">
    <div class="ew-loading"><div class="ew-spinner"></div></div>
  </div>

</ClientLayout>

<!-- Tracker drawer (réutilisé de l'admin) -->
<div id="tracker-overlay" style="display:none;position:fixed;inset:0;background:rgba(26,24,20,0.35);z-index:1000;justify-content:flex-end">
  <div id="tracker-drawer" style="width:420px;max-width:90vw;height:100vh;background:var(--bg);display:flex;flex-direction:column;animation:ew-slide-in 0.2s ease-out">
    <header style="display:flex;justify-content:space-between;align-items:center;padding:16px 22px;border-bottom:0.5px solid var(--line)">
      <span style="font-size:14px;font-weight:500">+ Tracker</span>
      <button id="tracker-close" style="background:none;border:none;font-size:18px;color:var(--taupe);cursor:pointer">&times;</button>
    </header>
    <div style="flex:1;overflow-y:auto;padding:18px 22px">
      <div id="tracker-form-body"></div>
    </div>
  </div>
</div>

<style>
  /* Tabs */
  .veille-tabs {
    display: flex;
    align-items: center;
    gap: 2px;
    border-bottom: 0.5px solid var(--line);
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .veille-tab {
    font-size: 13px;
    padding: 8px 14px;
    color: var(--taupe);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    font-family: var(--font);
    white-space: nowrap;
    transition: color 0.12s;
    margin-bottom: -0.5px;
  }
  .veille-tab:hover { color: var(--ink); }
  .veille-tab.active { color: var(--ink); border-bottom-color: #5C6347; font-weight: 500; }
  .veille-tab-num {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--mute);
    margin-left: 5px;
  }

  /* Carte article client */
  .client-item {
    padding: 22px 0;
    border-bottom: 0.5px solid var(--line);
    display: grid;
    grid-template-columns: 44px 1fr;
    column-gap: 24px;
    align-items: start;
  }
  .client-item:last-child { border-bottom: none; }
  .client-item-body { min-width: 0; }

  /* Actions client */
  .client-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 14px;
  }
  .btn-primary-kaki {
    font-size: 12px;
    padding: 7px 14px;
    background: #5C6347;
    color: #F4F0E6;
    border: none;
    border-radius: var(--radius);
    font-family: var(--font);
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.12s;
  }
  .btn-primary-kaki:hover { opacity: 0.88; }
  .btn-outline-kaki {
    font-size: 12px;
    padding: 7px 14px;
    background: transparent;
    color: #5C6347;
    border: 1px solid #5C6347;
    border-radius: var(--radius);
    font-family: var(--font);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.12s;
  }
  .btn-outline-kaki:hover { background: rgba(92,99,71,0.06); }
  .btn-text-kaki {
    font-size: 12px;
    padding: 7px 10px;
    background: none;
    color: #5C6347;
    border: none;
    font-family: var(--font);
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn-text-kaki:hover { text-decoration: underline; }
  .btn-text-mute {
    font-size: 12px;
    padding: 7px 10px;
    background: none;
    color: var(--taupe);
    border: none;
    font-family: var(--font);
    cursor: pointer;
    white-space: nowrap;
  }
  .btn-text-mute:hover { color: var(--ink); }
</style>

<script>
  import { api, getUser, formatDate, toast } from '../../scripts/api';

  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';

  // ── State ────────────────────────────────────────────────────────────────
  let articles: any[] = [];
  // Per-article local state (avant migration tenant_article_states)
  // Clé = article.id, valeur = 'inbox' | 'to_process' | 'read' | 'ignored'
  const localState: Record<string, string> = {};

  let activeTab = 'all';

  // Lire le tab depuis l'URL (?tab=to_process)
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('tab')) activeTab = urlParams.get('tab')!;

  // ── Init ─────────────────────────────────────────────────────────────────

  async function init() {
    // Date
    const todayEl = document.getElementById('client-today');
    if (todayEl) {
      todayEl.textContent = new Date().toLocaleDateString('fr-FR', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
      });
    }

    try {
      const data = await api('/api/v1/articles?page_size=200&score_min=11');
      const raw: any[] = Array.isArray(data) ? data : (data?.items || []);
      // Filtrer : uniquement articles publiés < 7 jours (inbox/triaged)
      articles = raw.filter((a: any) =>
        a.lifecycle_status === 'inbox' || a.lifecycle_status === 'triaged'
      );
      // Initialiser l'état local
      articles.forEach((a: any) => { if (!localState[a.id]) localState[a.id] = 'inbox'; });
    } catch (e: any) {
      document.getElementById('veille-list')!.innerHTML =
        `<div class="ew-empty"><div class="ew-empty-title">Erreur de chargement</div><div class="ew-empty-sub">${e.message}</div></div>`;
      return;
    }

    renderTabs();
    renderList();
  }

  // ── Tabs ─────────────────────────────────────────────────────────────────

  function getTabCounts() {
    const all       = articles.filter((a: any) => localState[a.id] !== 'ignored').length;
    const unread    = articles.filter((a: any) => localState[a.id] === 'inbox').length;
    const toProcess = articles.filter((a: any) => localState[a.id] === 'to_process').length;
    const read      = articles.filter((a: any) => localState[a.id] === 'read').length;
    return { all, unread, toProcess, read };
  }

  function renderTabs() {
    const c = getTabCounts();
    const container = document.getElementById('veille-tabs-container')!;
    container.innerHTML = `
      <div class="veille-tabs">
        ${tabBtn('all',        'Tous',       c.all,       activeTab)}
        ${tabBtn('unread',     'Non lus',    c.unread,    activeTab)}
        ${tabBtn('to_process', 'À traiter',  c.toProcess, activeTab)}
        ${tabBtn('read',       'Traités',    c.read,      activeTab)}
        <div style="margin-left:auto">
          <span style="font-size:13px;color:#888">Plus récent ▾</span>
        </div>
      </div>`;
    container.querySelectorAll('[data-tab]').forEach((el: any) => {
      el.addEventListener('click', () => {
        activeTab = el.dataset.tab;
        renderTabs();
        renderList();
      });
    });
  }

  function tabBtn(key: string, label: string, count: number, current: string): string {
    return `<button class="veille-tab${current === key ? ' active' : ''}" data-tab="${key}">${label}<span class="veille-tab-num">${count}</span></button>`;
  }

  // ── Filtrage ─────────────────────────────────────────────────────────────

  function getFiltered(): any[] {
    return articles.filter((a: any) => {
      const s = localState[a.id] || 'inbox';
      if (activeTab === 'all')        return s !== 'ignored';
      if (activeTab === 'unread')     return s === 'inbox';
      if (activeTab === 'to_process') return s === 'to_process';
      if (activeTab === 'read')       return s === 'read';
      return false;
    }).sort((a: any, b: any) =>
      new Date(b.published_at || b.created_at).getTime() -
      new Date(a.published_at || a.created_at).getTime()
    );
  }

  // ── Rendu liste ──────────────────────────────────────────────────────────

  function renderList() {
    const filtered = getFiltered();
    const container = document.getElementById('veille-list')!;

    if (!filtered.length) {
      container.innerHTML = `<div class="ew-empty">
        <div class="ew-empty-title">Aucun article</div>
        <div class="ew-empty-sub">Pas d'article dans cet onglet.</div>
      </div>`;
      return;
    }

    container.innerHTML = filtered.map((a: any) => renderCard(a)).join('');

    // Bind actions
    container.querySelectorAll('[data-action]').forEach((el: any) => {
      el.addEventListener('click', (e: Event) => {
        e.stopPropagation();
        const { action, id } = el.dataset;
        handleAction(id, action);
      });
    });

    // Bind tracker
    container.querySelectorAll('[data-open-tracker]').forEach((el: any) => {
      el.addEventListener('click', (e: Event) => {
        e.stopPropagation();
        openTracker(el.dataset.openTracker);
      });
    });
  }

  function renderCard(a: any): string {
    const src = (a.source_name || '').toUpperCase().substring(0, 4);
    const st  = localState[a.id] || 'inbox';

    const impactRow = (a.has_impact && a.impacted_procedures?.length)
      ? `<div style="display:flex;align-items:center;gap:6px;margin-top:16px;flex-wrap:wrap">
           <span style="font-size:11px;color:#888">Impacte →</span>
           ${a.impacted_procedures.map((p: string) =>
             `<span style="font-size:11px;font-weight:500;color:#5C6347">${p}</span>`
           ).join(' · ')}
         </div>` : '';

    // Actions selon état
    const toProcessBtn = st === 'to_process'
      ? `<button class="btn-primary-kaki" data-action="inbox" data-id="${a.id}" style="background:#888">Retirer des tâches ×</button>`
      : `<button class="btn-primary-kaki" data-action="to_process" data-id="${a.id}">À traiter</button>`;

    const readBtn = st === 'read'
      ? `<button class="btn-outline-kaki" data-action="inbox" data-id="${a.id}">Marquer non lu</button>`
      : `<button class="btn-outline-kaki" data-action="read" data-id="${a.id}">Marquer comme lu</button>`;

    const ignoreBtn = st === 'ignored'
      ? ''
      : `<button class="btn-text-mute" data-action="ignored" data-id="${a.id}">Ignorer</button>`;

    return `
      <div class="client-item">
        <div class="ew-source-avatar">${src}</div>
        <div class="client-item-body">
          <div class="ew-meta">
            <span>${a.source_name || '—'}</span>
            <span class="dot">·</span>
            <span>${formatDate(a.published_at)}</span>
          </div>
          <h3 class="ew-title" style="margin-bottom:0">
            ${a.original_url
              ? `<a href="${a.original_url}" target="_blank" rel="noopener" style="color:inherit;text-decoration:none">${a.title || 'Sans titre'}</a>`
              : (a.title || 'Sans titre')
            }
          </h3>
          ${impactRow}
          <div class="client-actions">
            ${toProcessBtn}
            ${readBtn}
            <button class="btn-text-kaki" data-open-tracker="${a.id}">+ Tracker</button>
            ${ignoreBtn}
          </div>
        </div>
      </div>`;
  }

  // ── Actions ──────────────────────────────────────────────────────────────

  function handleAction(id: string, action: string) {
    // v1 : état local uniquement (avant migration tenant_article_states)
    // v2 : PATCH /api/v1/app/articles/{id}/state
    localState[id] = action === 'ignored' ? 'ignored'
                   : action === 'to_process' ? 'to_process'
                   : action === 'read' ? 'read'
                   : 'inbox';

    renderTabs();
    renderList();

    const labels: Record<string, string> = {
      to_process: 'Article ajouté aux tâches',
      read:       'Article marqué comme lu',
      inbox:      'Article remis en non lu',
      ignored:    'Article ignoré',
    };
    toast(labels[action] || 'Mis à jour');
  }

  // ── Tracker drawer ───────────────────────────────────────────────────────

  function openTracker(id: string) {
    const a = articles.find((x: any) => x.id === id);
    if (!a) return;
    const overlay = document.getElementById('tracker-overlay')!;
    const formBody = document.getElementById('tracker-form-body')!;
    formBody.innerHTML = `
      <p style="font-size:13px;color:var(--taupe);margin-bottom:16px">
        Ajoutez cet article à votre tracker réglementaire.
      </p>
      <div style="font-size:13px;font-weight:500;color:var(--ink);margin-bottom:12px">${a.title || 'Sans titre'}</div>
      <p style="font-size:12px;color:var(--taupe)">
        Fonctionnalité complète disponible depuis la page Tracker.
      </p>
      <a href="${BASE}app/tracker" class="ew-btn" style="display:inline-block;margin-top:16px;text-decoration:none">
        Aller au Tracker →
      </a>
    `;
    overlay.style.display = 'flex';
  }

  document.getElementById('tracker-close')?.addEventListener('click', () => {
    document.getElementById('tracker-overlay')!.style.display = 'none';
  });
  document.getElementById('tracker-overlay')?.addEventListener('click', (e: any) => {
    if (e.target === e.currentTarget) e.currentTarget.style.display = 'none';
  });

  init();
</script>
