---
import ClientLayout from '../../layouts/ClientLayout.astro';
const base = import.meta.env.BASE_URL;
---

<ClientLayout title="Fil réglementaire" activePage="veille">

  <div class="ew-header">
    <h1 class="ew-h-title">Fil réglementaire</h1>
    <div class="ew-h-date" id="client-today"></div>
  </div>

  <div id="veille-list">
    <div class="ew-loading"><div class="ew-spinner"></div></div>
  </div>

</ClientLayout>

<!-- Tracker drawer -->
<div id="tracker-overlay" style="display:none;position:fixed;inset:0;background:rgba(26,24,20,0.35);z-index:1000;justify-content:flex-end">
  <div style="width:420px;max-width:90vw;height:100vh;background:var(--bg);display:flex;flex-direction:column;animation:ew-slide-in 0.2s ease-out">
    <header style="display:flex;justify-content:space-between;align-items:center;padding:16px 22px;border-bottom:0.5px solid var(--line)">
      <span style="font-size:14px;font-weight:500;color:var(--ink)">+ Tracker</span>
      <button id="tracker-close" style="background:none;border:none;font-size:20px;color:var(--taupe);cursor:pointer;padding:4px;line-height:1">&times;</button>
    </header>
    <div style="flex:1;overflow-y:auto;padding:18px 22px" id="tracker-form-body"></div>
  </div>
</div>

<script>
  import { api, formatDate, toast } from '../../scripts/api';
  import {
    renderEwTab, renderSortDropdown, bindSortDropdown, renderClientCard, SORT_LABELS,
  } from '../../scripts/article-card.js';

  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';

  // ── State ─────────────────────────────────────────────────────────────────

  let articles: any[] = [];
  let counts = { inbox: 0, to_process: 0, read: 0, all_visible: 0 };
  let activeTab = 'all';
  let sortMode = 'recent';
  let loading = false;

  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('tab')) activeTab = urlParams.get('tab')!;

  // ── Init ─────────────────────────────────────────────────────────────────

  async function init() {
    const todayEl = document.getElementById('client-today');
    if (todayEl) {
      todayEl.textContent = new Date().toLocaleDateString('fr-FR', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
      });
    }
    await loadArticles();
  }

  // ── Load ─────────────────────────────────────────────────────────────────

  async function loadArticles() {
    if (loading) return;
    loading = true;

    const listEl = document.getElementById('veille-list')!;
    const savedTabs = listEl.querySelector('#ew-tabs');
    listEl.innerHTML = '<div class="ew-loading"><div class="ew-spinner"></div></div>';
    if (savedTabs) listEl.insertAdjacentElement('afterbegin', savedTabs);

    try {
      const [data, cntData] = await Promise.all([
        api(`/api/v1/app/articles?status=${activeTab}&page_size=100`),
        api('/api/v1/app/articles/counts'),
      ]);
      articles = data.articles || [];
      counts = cntData;
    } catch (e: any) {
      listEl.innerHTML = `<div class="ew-empty">
        <div class="ew-empty-title">Erreur de chargement</div>
        <div class="ew-empty-sub">${e.message}</div>
      </div>`;
      loading = false;
      return;
    }

    loading = false;
    renderTabs();
    renderList();
  }

  // ── Tabs ─────────────────────────────────────────────────────────────────

  function renderTabs() {
    const tabsHtml = `<div class="ew-tabs" id="ew-tabs">
      ${renderEwTab('all',        'Tous',      counts.all_visible, activeTab)}
      ${renderEwTab('inbox',      'Non lus',   counts.inbox,       activeTab)}
      ${renderEwTab('to_process', 'À traiter', counts.to_process,  activeTab)}
      ${renderEwTab('read',       'Traités',   counts.read,        activeTab)}
      ${renderSortDropdown(sortMode)}
    </div>`;

    const listEl = document.getElementById('veille-list')!;
    const existing = listEl.querySelector('#ew-tabs');
    if (existing) {
      existing.outerHTML = tabsHtml;
    } else {
      listEl.insertAdjacentHTML('afterbegin', tabsHtml);
    }

    listEl.querySelectorAll('[data-tab]').forEach((el: any) => {
      el.addEventListener('click', () => {
        activeTab = el.dataset.tab;
        loadArticles();
      });
    });

    bindSortDropdown((key: string) => {
      sortMode = key;
      renderTabs();
      renderList();
    });
  }

  // ── List ─────────────────────────────────────────────────────────────────

  function sortedArticles(): any[] {
    const now = Date.now();
    const ts = (a: any) => new Date(a.published_at || a.created_at).getTime();

    if (sortMode === 'week') {
      const start = new Date();
      start.setDate(start.getDate() - start.getDay() + 1);
      start.setHours(0, 0, 0, 0);
      return articles.filter(a => ts(a) >= start.getTime());
    }
    if (sortMode === '7days') {
      return articles.filter(a => ts(a) >= now - 7 * 86400000);
    }
    const dir = sortMode === 'oldest' ? 1 : -1;
    return [...articles].sort((a, b) => dir * (ts(a) - ts(b)));
  }

  function renderList() {
    const listEl = document.getElementById('veille-list')!;
    const tabs   = listEl.querySelector('#ew-tabs');

    const items = sortedArticles();
    if (!items.length) {
      listEl.innerHTML = `<div class="ew-empty">
        <div class="ew-empty-title">Aucun article</div>
        <div class="ew-empty-sub">Pas d'article dans cet onglet.</div>
      </div>`;
    } else {
      listEl.innerHTML = `<div class="ew-list" id="ew-list">
        ${items.map((a: any) => renderClientCard(a, formatDate)).join('')}
      </div>`;
    }

    if (tabs) listEl.insertAdjacentElement('afterbegin', tabs);

    listEl.querySelectorAll('[data-action]').forEach((el: any) => {
      el.addEventListener('click', (e: Event) => {
        e.stopPropagation();
        handleAction(el.dataset.id, el.dataset.action);
      });
    });
    listEl.querySelectorAll('[data-open-tracker]').forEach((el: any) => {
      el.addEventListener('click', (e: Event) => {
        e.stopPropagation();
        openTracker(el.dataset.openTracker);
      });
    });
  }

  // ── Actions ──────────────────────────────────────────────────────────────

  async function handleAction(id: string, action: string) {
    try {
      await api(`/api/v1/app/articles/${id}/state`, {
        method: 'PATCH',
        body: { action },
      });
      const labels: Record<string, string> = {
        to_process: 'Article ajouté aux tâches',
        read:       'Article marqué comme lu',
        inbox:      'Article remis en non lu',
        ignored:    'Article ignoré',
      };
      toast(labels[action] || 'Mis à jour');
      await loadArticles();
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  // ── Tracker drawer ───────────────────────────────────────────────────────

  function openTracker(id: string) {
    const a = articles.find((x: any) => x.id === id);
    if (!a) return;
    const formBody = document.getElementById('tracker-form-body')!;
    formBody.innerHTML = `
      <p style="font-size:13px;color:var(--taupe);margin-bottom:16px">
        Ajoutez cet article à votre tracker réglementaire.
      </p>
      <div style="font-size:13px;font-weight:500;color:var(--ink);margin-bottom:12px">${a.title || 'Sans titre'}</div>
      <a href="${BASE}app/tracker" class="ew-btn" style="display:inline-block;margin-top:8px;text-decoration:none">
        Aller au Tracker →
      </a>`;
    document.getElementById('tracker-overlay')!.style.display = 'flex';
  }

  document.getElementById('tracker-close')?.addEventListener('click', () => {
    document.getElementById('tracker-overlay')!.style.display = 'none';
  });
  document.getElementById('tracker-overlay')?.addEventListener('click', (e: any) => {
    if (e.target === e.currentTarget) e.currentTarget.style.display = 'none';
  });

  init();
</script>
