---
// Tâche 7 — redirige vers la page mes-procedures existante
// Layout client appliqué ici pour cohérence navigation
import ClientLayout from '../../layouts/ClientLayout.astro';
const base = import.meta.env.BASE_URL;
---

<ClientLayout title="Mes procédures" activePage="procedures">
  <div id="proc-redirect">
    <div class="ew-loading"><div class="ew-spinner"></div></div>
  </div>
</ClientLayout>

<script>
  // Charger le contenu de la page mes-procedures dans l'iframe ou rediriger
  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';
  window.location.replace(BASE + 'mes-procedures');
</script>
