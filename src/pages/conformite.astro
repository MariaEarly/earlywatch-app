---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Conformite LCB-FT — Early Watch" activePage="conformite">
  <div style="max-width:1100px;margin:0 auto;">

    <!-- HEADER + SCORE -->
    <div class="cf-header">
      <div>
        <div class="cf-title">Tableau de bord conformité LCB-FT</div>
        <div class="cf-subtitle" id="cf-subtitle">Chargement...</div>
      </div>
      <div class="score-circle" id="score-circle">
        <div class="score-pct" id="score-pct">--</div>
        <div class="score-label">Conformité</div>
      </div>
    </div>

    <!-- STATS -->
    <div class="stats-bar">
      <div class="stat-card">
        <div class="stat-card-value" id="stat-sources">--</div>
        <div class="stat-card-label">Sources surveillées</div>
        <div class="stat-card-sub" id="stat-sources-sub"></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-value" id="stat-reminders">--</div>
        <div class="stat-card-label">Reminders actifs</div>
        <div class="stat-card-sub" id="stat-reminders-sub"></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-value" id="stat-procs">--</div>
        <div class="stat-card-label">Procédures validées</div>
        <div class="stat-card-sub" id="stat-procs-sub"></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-value" id="stat-deadline">--</div>
        <div class="stat-card-label">Prochaine échéance</div>
        <div class="stat-card-sub" id="stat-deadline-sub"></div>
      </div>
    </div>

    <!-- MODULES GRID -->
    <div class="modules-grid">

      <!-- REMINDERS -->
      <div class="module-card">
        <div class="module-header">
          <span class="module-title">Reminders actifs</span>
          <a href={`${base}controle`} class="module-link">Voir tout</a>
        </div>
        <div class="module-body" id="mod-reminders">
          <div class="cf-loading">Chargement...</div>
        </div>
      </div>

      <!-- PROCEDURES -->
      <div class="module-card">
        <div class="module-header">
          <span class="module-title">Mes procédures</span>
          <a href={`${base}mes-procedures`} class="module-link">Voir tout</a>
        </div>
        <div class="module-body" id="mod-procs">
          <div class="cf-loading">Chargement...</div>
        </div>
      </div>

      <!-- DEADLINES -->
      <div class="module-card">
        <div class="module-header">
          <span class="module-title">Prochaines échéances</span>
          <a href={`${base}roadmap`} class="module-link">Voir tout</a>
        </div>
        <div class="module-body" id="mod-deadlines">
          <div class="cf-loading">Chargement...</div>
        </div>
      </div>

      <!-- VEILLE -->
      <div class="module-card">
        <div class="module-header">
          <span class="module-title">Dernières alertes veille</span>
          <a href={`${base}dashboard`} class="module-link">Voir tout</a>
        </div>
        <div class="module-body" id="mod-sanctions">
          <div class="cf-loading">Chargement...</div>
        </div>
      </div>

    </div>

    <!-- QUICK LINKS -->
    <div class="quick-links">
      <a href={`${base}dashboard`} class="ql-btn">Inbox veille</a>
      <a href={`${base}mes-procedures`} class="ql-btn">Mes procédures</a>
      <a href={`${base}situations`} class="ql-btn">Fiches réflexes</a>
      <a href={`${base}roadmap`} class="ql-btn">Roadmap</a>
      <a href={`${base}pays-risque`} class="ql-btn">Pays à risque</a>
      <a href={`${base}controle`} class="ql-btn">Contrôle</a>
      <a href="#" id="export-audit-btn" class="ql-btn">Export audit PDF</a>
    </div>

  </div>

  <script>
    import { api, toast, getToken, API } from '../scripts/api';

    // ── LOAD ALL MODULES ──
    Promise.allSettled([
      loadReminders(),
      loadProcedures(),
      loadDeadlines(),
      loadSanctions(),
      loadSources(),
    ]).then(() => {
      const sub = document.getElementById('cf-subtitle');
      if (sub) sub.textContent =
        `Vue d'ensemble de votre dispositif LCB-FT — ${new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}`;
    });

    // ── REMINDERS ──
    async function loadReminders() {
      try {
        const counts = await api('/api/v1/reminders/counts');
        const total = counts.total || 0;
        document.getElementById('stat-reminders')!.textContent = String(total);
        const parts: string[] = [];
        if (counts.critical) parts.push(`${counts.critical} critiques`);
        if (counts.high) parts.push(`${counts.high} élevés`);
        if (counts.medium) parts.push(`${counts.medium} moyens`);
        document.getElementById('stat-reminders-sub')!.textContent = parts.join(' / ') || 'Aucun reminder actif';

        const data = await api('/api/v1/reminders?limit=5');
        const reminders = data.reminders || data || [];
        const el = document.getElementById('mod-reminders')!;

        if (!reminders.length) {
          el.innerHTML = '<div class="cf-empty">Aucun reminder actif. Votre veille est à jour.</div>';
          return;
        }

        el.innerHTML = reminders.slice(0, 5).map((r: any) => {
          const date = r.created_at ? new Date(r.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }) : '';
          return `<div class="rem-item">
            <span class="rem-sev sev-${r.severity || 'low'}"></span>
            <span class="rem-text">${r.reminder_text || r.title || '\u2014'}</span>
            <span class="rem-date">${date}</span>
          </div>`;
        }).join('');
      } catch (e: any) {
        document.getElementById('mod-reminders')!.innerHTML = `<div class="cf-empty">Erreur : ${e.message}</div>`;
      }
    }

    // ── PROCEDURES ──
    async function loadProcedures() {
      try {
        const data = await api('/api/v1/my-procedures');
        if (!data.enabled) {
          document.getElementById('mod-procs')!.innerHTML = '<div class="cf-empty">Module procédures non activé.</div>';
          return;
        }
        const procs = data.procedures || [];
        const total = procs.length;
        const valide = procs.filter((p: any) => p.status === 'valide').length;
        const encours = procs.filter((p: any) => p.status === 'en_cours').length;
        const avalider = total - valide - encours;
        const pct = total ? Math.round(valide / total * 100) : 0;

        document.getElementById('stat-procs')!.textContent = `${valide}/${total}`;
        document.getElementById('stat-procs-sub')!.textContent = `${pct}% validées`;
        document.getElementById('score-pct')!.textContent = `${pct}%`;
        const circle = document.getElementById('score-circle')!;
        circle.className = 'score-circle ' + (pct >= 80 ? 'score-green' : pct >= 50 ? 'score-orange' : 'score-red');

        const el = document.getElementById('mod-procs')!;
        const pctV = total ? (valide / total * 100) : 0;
        const pctE = total ? (encours / total * 100) : 0;
        const pctA = total ? (avalider / total * 100) : 0;

        el.innerHTML = `
          <div class="proc-progress">
            <div class="proc-bar-bg">
              <div class="proc-bar-fill proc-fill-valide" style="width:${pctV}%"></div>
              <div class="proc-bar-fill proc-fill-encours" style="width:${pctE}%"></div>
              <div class="proc-bar-fill proc-fill-avalider" style="width:${pctA}%"></div>
            </div>
            <div class="proc-legend">
              <div class="proc-legend-item"><span class="proc-legend-dot" style="background:var(--moutarde)"></span> ${valide} validées</div>
              <div class="proc-legend-item"><span class="proc-legend-dot" style="background:var(--taupe)"></span> ${encours} en cours</div>
              <div class="proc-legend-item"><span class="proc-legend-dot" style="background:var(--ghost)"></span> ${avalider} à valider</div>
            </div>
          </div>
          ${procs.filter((p: any) => p.status !== 'valide').slice(0, 4).map((p: any) => `
            <div style="font-size:12px;padding:4px 0;border-bottom:0.5px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:8px">
              <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><b>${p.reference}</b> ${p.title}</span>
              <span style="flex-shrink:0;font-size:11px;color:var(--taupe)">${p.status === 'en_cours' ? 'En cours' : 'À valider'}</span>
            </div>
          `).join('')}
        `;
      } catch (e: any) {
        document.getElementById('mod-procs')!.innerHTML = `<div class="cf-empty">Erreur : ${e.message}</div>`;
      }
    }

    // ── DEADLINES ──
    async function loadDeadlines() {
      try {
        const data = await api('/api/v1/deadlines');
        const deadlines = data.deadlines || [];
        const el = document.getElementById('mod-deadlines')!;

        const upcoming = deadlines.filter((d: any) => d.urgency !== 'passed');
        if (upcoming.length) {
          const next = upcoming[0];
          const dd = new Date(next.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
          document.getElementById('stat-deadline')!.textContent = dd;
          document.getElementById('stat-deadline-sub')!.textContent = next.regulation || '';
        } else {
          document.getElementById('stat-deadline')!.textContent = '\u2014';
          document.getElementById('stat-deadline-sub')!.textContent = 'Aucune échéance proche';
        }

        if (!deadlines.length) {
          el.innerHTML = '<div class="cf-empty">Aucune échéance.</div>';
          return;
        }

        el.innerHTML = deadlines.slice(0, 5).map((d: any) => {
          const dd = new Date(d.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
          const urgColor = d.urgency === 'imminent' ? 'var(--moutarde)' : 'var(--mute)';
          return `<div class="dl-item">
            <span class="dl-reg">${d.regulation || '\u2014'}</span>
            <span class="dl-title">${d.title || d.description || '\u2014'}</span>
            <span class="dl-date" style="color:${urgColor}">${dd}</span>
          </div>`;
        }).join('');
      } catch (e: any) {
        document.getElementById('mod-deadlines')!.innerHTML = `<div class="cf-empty">Erreur : ${e.message}</div>`;
      }
    }

    // ── VEILLE ──
    async function loadSanctions() {
      try {
        const data = await api('/api/v1/articles?page_size=5&score_min=11');
        const articles = data.articles || data || [];
        const el = document.getElementById('mod-sanctions')!;

        if (!articles.length) {
          el.innerHTML = '<div class="cf-empty">Aucun article récent.</div>';
          return;
        }

        el.innerHTML = articles.slice(0, 5).map((a: any) => {
          const date = a.published_at ? new Date(a.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }) : '';
          const themes = (a.themes || []).slice(0, 3).map((t: string) => `<span class="sanc-tag">${t}</span>`).join('');
          return `<div class="sanc-item">
            <div class="sanc-title"><a href="${a.original_url || a.url || '#'}" target="_blank">${a.title}</a></div>
            <div class="sanc-meta">${a.source_name || a.source || ''} \u2014 ${date} ${themes}</div>
          </div>`;
        }).join('');
      } catch (e: any) {
        document.getElementById('mod-sanctions')!.innerHTML = `<div class="cf-empty">Erreur : ${e.message}</div>`;
      }
    }

    // ── SOURCES ──
    async function loadSources() {
      try {
        const data = await api('/api/v1/sources');
        const sources = data.sources || data || [];
        document.getElementById('stat-sources')!.textContent = String(sources.length);
        const active = sources.filter((s: any) => !s.fallback_active).length;
        document.getElementById('stat-sources-sub')!.textContent = `${active} actives`;
      } catch (e) {
        document.getElementById('stat-sources')!.textContent = '\u2014';
      }
    }

    // ── EXPORT AUDIT ──
    document.getElementById('export-audit-btn')?.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        const token = getToken();
        const res = await fetch(`${API}/api/v1/audit/export-pdf`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) throw new Error('Erreur export');
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `piste-audit-lcbft-${new Date().toISOString().slice(0,10)}.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        toast('PDF téléchargé', 'success');
      } catch (err: any) {
        toast(err.message, 'error');
      }
    });
  </script>
</AppLayout>

<style>
  .cf-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    flex-wrap: wrap; gap: 16px; margin-bottom: 28px;
  }
  .cf-title { font-size: 15px; font-weight: 500; color: var(--ink); }
  .cf-subtitle { font-size: 13px; color: var(--mute); margin-top: 2px; }

  .score-circle {
    width: 100px; height: 100px; border-radius: 50%;
    border: 0.5px solid var(--line-strong);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    background: var(--bg);
  }
  .score-pct { font-size: 28px; font-weight: 500; line-height: 1; color: var(--ink); }
  .score-label { font-size: 10px; color: var(--mute); text-transform: uppercase; letter-spacing: 0.5px; }
  .score-red .score-pct { color: var(--ink); }
  .score-orange { border-color: var(--moutarde); }
  .score-orange .score-pct { color: var(--moutarde); }
  .score-green { border-color: var(--ink-soft); }
  .score-green .score-pct { color: var(--ink-soft); }

  .stats-bar {
    display: grid; grid-template-columns: repeat(4, 1fr);
    border: 0.5px solid var(--line); margin-bottom: 28px;
  }
  .stat-card {
    padding: 20px 24px; background: var(--bg);
    border-right: 0.5px solid var(--line);
  }
  .stat-card:last-child { border-right: none; }
  .stat-card-value { font-family: var(--font-mono); font-size: 32px; font-weight: 300; line-height: 1; color: var(--ink); }
  .stat-card-label { font-size: 12px; color: var(--mute); margin-top: 2px; }
  .stat-card-sub { font-size: 11px; color: var(--mute); margin-top: 4px; }

  .modules-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 20px; margin-bottom: 28px;
  }
  .module-card {
    background: var(--bg); border: 0.5px solid var(--line);
    display: flex; flex-direction: column; overflow: hidden;
  }
  .module-header {
    padding: 14px 18px; display: flex; justify-content: space-between;
    align-items: center; border-bottom: 0.5px solid var(--line);
  }
  .module-title { font-size: 13px; font-weight: 500; color: var(--ink); }
  .module-link { font-size: 12px; color: var(--taupe); text-decoration: none; }
  .module-link:hover { color: var(--ink); }
  .module-body { padding: 14px 18px; flex: 1; }

  .rem-item {
    display: flex; gap: 10px; align-items: flex-start; padding: 8px 0;
    border-bottom: 0.5px solid var(--line); font-size: 13px;
  }
  .rem-item:last-child { border-bottom: none; }
  .rem-sev { width: 7px; height: 7px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
  :global(.sev-critical) { background: var(--moutarde); }
  :global(.sev-high)     { background: var(--ink-soft); }
  :global(.sev-medium)   { background: var(--taupe); }
  :global(.sev-low)      { background: var(--ghost); }
  .rem-text { flex: 1; color: var(--ink); }
  .rem-date { font-size: 11px; color: var(--mute); white-space: nowrap; }

  :global(.proc-bar-bg) {
    height: 10px; background: var(--bg-side); overflow: hidden; display: flex;
    border: 0.5px solid var(--line);
  }
  :global(.proc-bar-fill) { height: 100%; transition: width 0.4s; }
  :global(.proc-fill-valide)  { background: var(--moutarde); }
  :global(.proc-fill-encours) { background: var(--taupe); }
  :global(.proc-fill-avalider){ background: var(--ghost); }
  :global(.proc-legend) { display: flex; gap: 12px; margin-top: 8px; font-size: 11px; color: var(--mute); }
  :global(.proc-legend-item)  { display: flex; align-items: center; gap: 4px; }
  :global(.proc-legend-dot)   { width: 7px; height: 7px; border-radius: 50%; }
  .proc-progress { margin-bottom: 14px; }

  .dl-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 0; border-bottom: 0.5px solid var(--line); font-size: 13px;
    gap: 8px;
  }
  .dl-item:last-child { border-bottom: none; }
  .dl-reg {
    font-family: var(--font-mono); font-size: 10px; padding: 2px 7px;
    border: 0.5px solid var(--line-strong); color: var(--taupe);
    white-space: nowrap;
  }
  .dl-title { flex: 1; color: var(--ink); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dl-date  { font-size: 12px; font-weight: 500; white-space: nowrap; }

  :global(.sanc-item) { padding: 8px 0; border-bottom: 0.5px solid var(--line); font-size: 13px; }
  :global(.sanc-item:last-child) { border-bottom: none; }
  :global(.sanc-title) { color: var(--ink); font-weight: 500; }
  :global(.sanc-title a) { color: var(--ink); text-decoration: none; }
  :global(.sanc-title a:hover) { text-decoration: underline; }
  :global(.sanc-meta) { font-size: 11px; color: var(--mute); margin-top: 2px; }
  :global(.sanc-tag) {
    display: inline-block; font-size: 10px; padding: 1px 6px;
    border: 0.5px solid var(--line); margin-right: 3px; color: var(--taupe);
  }

  .quick-links {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px;
  }
  .ql-btn {
    display: flex; align-items: center; padding: 12px 16px;
    background: var(--bg); border: 0.5px solid var(--line);
    font-size: 12px; font-weight: 500; color: var(--ink);
    text-decoration: none; font-family: inherit; cursor: pointer;
    transition: background 0.12s;
  }
  .ql-btn:hover { background: var(--bg-side); }

  .cf-loading { padding: 20px; text-align: center; color: var(--mute); font-size: 13px; }
  .cf-empty   { font-size: 13px; color: var(--mute); padding: 12px 0; }
</style>
