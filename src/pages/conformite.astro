---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Conformite LCB-FT — Early Watch" activePage="conformite">
  <div class="cf-layout">
    <div class="cf-main">

      <!-- HEADER + SCORE -->
      <div class="cf-header">
        <div>
          <div class="cf-title">Tableau de bord conformite LCB-FT</div>
          <div class="cf-subtitle" id="cf-subtitle">Chargement...</div>
        </div>
        <div class="score-circle" id="score-circle">
          <div class="score-pct" id="score-pct">--</div>
          <div class="score-label">Conformite</div>
        </div>
      </div>

      <!-- STATS -->
      <div class="stats-bar">
        <div class="stat-card">
          <div class="stat-card-value" id="stat-sources">--</div>
          <div class="stat-card-label">Sources surveillees</div>
          <div class="stat-card-sub" id="stat-sources-sub"></div>
        </div>
        <div class="stat-card stat-accent">
          <div class="stat-card-value" id="stat-reminders">--</div>
          <div class="stat-card-label">Reminders actifs</div>
          <div class="stat-card-sub" id="stat-reminders-sub"></div>
        </div>
        <div class="stat-card stat-ok">
          <div class="stat-card-value" id="stat-procs">--</div>
          <div class="stat-card-label">Procedures validees</div>
          <div class="stat-card-sub" id="stat-procs-sub"></div>
        </div>
        <div class="stat-card stat-warn">
          <div class="stat-card-value" id="stat-deadline">--</div>
          <div class="stat-card-label">Prochaine echeance</div>
          <div class="stat-card-sub" id="stat-deadline-sub"></div>
        </div>
      </div>

      <!-- MODULES GRID -->
      <div class="modules-grid">

        <!-- REMINDERS -->
        <div class="module-card">
          <div class="module-header">
            <span class="module-title">Reminders actifs</span>
            <a href={`${base}controle`} class="module-link">Voir tout</a>
          </div>
          <div class="module-body" id="mod-reminders">
            <div class="loading">Chargement...</div>
          </div>
        </div>

        <!-- PROCEDURES -->
        <div class="module-card">
          <div class="module-header">
            <span class="module-title">Mes procedures</span>
            <a href={`${base}mes-procedures`} class="module-link">Voir tout</a>
          </div>
          <div class="module-body" id="mod-procs">
            <div class="loading">Chargement...</div>
          </div>
        </div>

        <!-- DEADLINES -->
        <div class="module-card">
          <div class="module-header">
            <span class="module-title">Prochaines echeances</span>
            <a href={`${base}roadmap`} class="module-link">Voir tout</a>
          </div>
          <div class="module-body" id="mod-deadlines">
            <div class="loading">Chargement...</div>
          </div>
        </div>

        <!-- SANCTIONS / VEILLE -->
        <div class="module-card">
          <div class="module-header">
            <span class="module-title">Dernieres alertes veille</span>
            <a href={`${base}dashboard`} class="module-link">Voir tout</a>
          </div>
          <div class="module-body" id="mod-sanctions">
            <div class="loading">Chargement...</div>
          </div>
        </div>

      </div>

      <!-- QUICK LINKS -->
      <div class="quick-links">
        <a href={`${base}dashboard`} class="ql-btn">Inbox veille</a>
        <a href={`${base}mes-procedures`} class="ql-btn">Mes procedures</a>
        <a href={`${base}situations`} class="ql-btn">Fiches reflexes</a>
        <a href={`${base}roadmap`} class="ql-btn">Roadmap</a>
        <a href={`${base}pays-risque`} class="ql-btn">Pays a risque</a>
        <a href={`${base}controle`} class="ql-btn">Controle</a>
        <a href="#" id="export-audit-btn" class="ql-btn">Export audit PDF</a>
      </div>

    </div>
  </div>

  <script>
    import { api, toast, getToken, API } from '../scripts/api';

    // ── LOAD ALL MODULES ──
    Promise.allSettled([
      loadReminders(),
      loadProcedures(),
      loadDeadlines(),
      loadSanctions(),
      loadSources(),
    ]).then(() => {
      const sub = document.getElementById('cf-subtitle');
      if (sub) sub.textContent =
        `Vue d'ensemble de votre dispositif LCB-FT — ${new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}`;
    });

    // ── REMINDERS ──
    async function loadReminders() {
      try {
        const counts = await api('/api/v1/reminders/counts');
        const total = counts.total || 0;
        document.getElementById('stat-reminders')!.textContent = String(total);
        const parts: string[] = [];
        if (counts.critical) parts.push(`${counts.critical} critiques`);
        if (counts.high) parts.push(`${counts.high} eleves`);
        if (counts.medium) parts.push(`${counts.medium} moyens`);
        document.getElementById('stat-reminders-sub')!.textContent = parts.join(' / ') || 'Aucun reminder actif';

        const data = await api('/api/v1/reminders?limit=5');
        const reminders = data.reminders || data || [];
        const el = document.getElementById('mod-reminders')!;

        if (!reminders.length) {
          el.innerHTML = '<div class="empty-msg">Aucun reminder actif. Votre veille est a jour.</div>';
          return;
        }

        el.innerHTML = reminders.slice(0, 5).map((r: any) => {
          const date = r.created_at ? new Date(r.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }) : '';
          return `<div class="rem-item">
            <span class="rem-sev sev-${r.severity || 'low'}"></span>
            <span class="rem-text">${r.reminder_text || r.title || '\u2014'}</span>
            <span class="rem-date">${date}</span>
          </div>`;
        }).join('');
      } catch (e: any) {
        document.getElementById('mod-reminders')!.innerHTML = `<div class="empty-msg">Erreur : ${e.message}</div>`;
      }
    }

    // ── PROCEDURES ──
    async function loadProcedures() {
      try {
        const data = await api('/api/v1/my-procedures');
        if (!data.enabled) {
          document.getElementById('mod-procs')!.innerHTML = '<div class="empty-msg">Module procedures non active.</div>';
          return;
        }
        const procs = data.procedures || [];
        const total = procs.length;
        const valide = procs.filter((p: any) => p.status === 'valide').length;
        const encours = procs.filter((p: any) => p.status === 'en_cours').length;
        const avalider = total - valide - encours;
        const pct = total ? Math.round(valide / total * 100) : 0;

        document.getElementById('stat-procs')!.textContent = `${valide}/${total}`;
        document.getElementById('stat-procs-sub')!.textContent = `${pct}% validees`;
        document.getElementById('score-pct')!.textContent = `${pct}%`;
        const circle = document.getElementById('score-circle')!;
        circle.className = 'score-circle ' + (pct >= 80 ? 'score-green' : pct >= 50 ? 'score-orange' : 'score-red');

        const el = document.getElementById('mod-procs')!;
        const pctV = total ? (valide / total * 100) : 0;
        const pctE = total ? (encours / total * 100) : 0;
        const pctA = total ? (avalider / total * 100) : 0;

        el.innerHTML = `
          <div class="proc-progress">
            <div class="proc-bar-bg">
              <div class="proc-bar-fill proc-fill-valide" style="width:${pctV}%"></div>
              <div class="proc-bar-fill proc-fill-encours" style="width:${pctE}%"></div>
              <div class="proc-bar-fill proc-fill-avalider" style="width:${pctA}%"></div>
            </div>
            <div class="proc-legend">
              <div class="proc-legend-item"><span class="proc-legend-dot" style="background:var(--ew-ink2)"></span> ${valide} validees</div>
              <div class="proc-legend-item"><span class="proc-legend-dot" style="background:var(--ew-ink2)"></span> ${encours} en cours</div>
              <div class="proc-legend-item"><span class="proc-legend-dot" style="background:var(--ew-orange-text)"></span> ${avalider} a valider</div>
            </div>
          </div>
          ${procs.filter((p: any) => p.status !== 'valide').slice(0, 4).map((p: any) => `
            <div style="font-size:12px;padding:4px 0;border-bottom:1px solid var(--color-border-tertiary);display:flex;justify-content:space-between">
              <span><b>${p.reference}</b> ${p.title}</span>
              <span style="font-size:11px;color:var(--ew-text-secondary)">${p.status === 'en_cours' ? 'En cours' : 'A valider'}</span>
            </div>
          `).join('')}
        `;
      } catch (e: any) {
        document.getElementById('mod-procs')!.innerHTML = `<div class="empty-msg">Erreur : ${e.message}</div>`;
      }
    }

    // ── DEADLINES ──
    async function loadDeadlines() {
      try {
        const data = await api('/api/v1/deadlines');
        const deadlines = data.deadlines || [];
        const el = document.getElementById('mod-deadlines')!;

        const upcoming = deadlines.filter((d: any) => d.urgency !== 'passed');
        if (upcoming.length) {
          const next = upcoming[0];
          const dd = new Date(next.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
          document.getElementById('stat-deadline')!.textContent = dd;
          document.getElementById('stat-deadline-sub')!.textContent = next.regulation || '';
        } else {
          document.getElementById('stat-deadline')!.textContent = '\u2014';
          document.getElementById('stat-deadline-sub')!.textContent = 'Aucune echeance proche';
        }

        if (!deadlines.length) {
          el.innerHTML = '<div class="empty-msg">Aucune echeance.</div>';
          return;
        }

        el.innerHTML = deadlines.slice(0, 5).map((d: any) => {
          const regCls = (d.regulation || '').toLowerCase().includes('dora') ? 'dl-reg-dora'
            : (d.regulation || '').toLowerCase().includes('aml') ? 'dl-reg-amlr'
            : (d.regulation || '').toLowerCase().includes('ai') ? 'dl-reg-ai'
            : 'dl-reg-other';
          const dd = new Date(d.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
          const urgCls = d.urgency === 'passed' ? 'dl-passed' : d.urgency === 'imminent' ? 'dl-imminent' : d.urgency === 'soon' ? 'dl-soon' : 'dl-upcoming';
          return `<div class="dl-item">
            <span class="dl-reg ${regCls}">${d.regulation || '\u2014'}</span>
            <span class="dl-title">${d.title || d.description || '\u2014'}</span>
            <span class="dl-date ${urgCls}">${dd}</span>
          </div>`;
        }).join('');
      } catch (e: any) {
        document.getElementById('mod-deadlines')!.innerHTML = `<div class="empty-msg">Erreur : ${e.message}</div>`;
      }
    }

    // ── SANCTIONS / VEILLE ──
    async function loadSanctions() {
      try {
        const data = await api('/api/v1/articles?page_size=5&score_min=11');
        const articles = data.articles || data || [];
        const el = document.getElementById('mod-sanctions')!;

        if (!articles.length) {
          el.innerHTML = '<div class="empty-msg">Aucun article recent.</div>';
          return;
        }

        el.innerHTML = articles.slice(0, 5).map((a: any) => {
          const date = a.published_at ? new Date(a.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }) : '';
          const themes = (a.themes || []).slice(0, 3).map((t: string) => `<span class="sanc-tag">${t}</span>`).join('');
          return `<div class="sanc-item">
            <div class="sanc-title"><a href="${a.original_url || a.url || '#'}" target="_blank">${a.title}</a></div>
            <div class="sanc-meta">${a.source_name || a.source || ''} \u2014 ${date} ${themes}</div>
          </div>`;
        }).join('');
      } catch (e: any) {
        document.getElementById('mod-sanctions')!.innerHTML = `<div class="empty-msg">Erreur : ${e.message}</div>`;
      }
    }

    // ── SOURCES ──
    async function loadSources() {
      try {
        const data = await api('/api/v1/sources');
        const sources = data.sources || data || [];
        document.getElementById('stat-sources')!.textContent = String(sources.length);
        const active = sources.filter((s: any) => !s.fallback_active).length;
        document.getElementById('stat-sources-sub')!.textContent = `${active} actives`;
      } catch (e) {
        document.getElementById('stat-sources')!.textContent = '\u2014';
      }
    }

    // ── EXPORT AUDIT ──
    document.getElementById('export-audit-btn')?.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        const token = getToken();
        const res = await fetch(`${API}/api/v1/audit/export-pdf`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) throw new Error('Erreur export');
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `piste-audit-lcbft-${new Date().toISOString().slice(0,10)}.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        toast('PDF telecharge', 'success');
      } catch (err: any) {
        toast(err.message, 'error');
      }
    });
  </script>
</AppLayout>

<style>
  .cf-layout { min-height: 100vh; display: flex; flex-direction: column; }
  .cf-main { flex: 1; max-width: 1200px; margin: 0 auto; padding: 32px 24px; width: 100%; }

  .cf-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 28px; }
  .cf-title { font-size: 15px; font-weight: 500; color: var(--noir); }
  .cf-subtitle { font-size: 14px; color: var(--color-text-tertiary); margin-top: 2px; }

  .score-circle {
    width: 100px; height: 100px; border-radius: 50%;
    border: 1px solid var(--text-primary); display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    box-shadow: none; background: var(--ew-bg);
  }
  .score-pct { font-size: 28px; font-weight: 500; line-height: 1; }
  .score-label { font-size: 10px; color: var(--color-text-tertiary); text-transform: uppercase; letter-spacing: 0.5px; }
  .score-red { border-color: var(--ew-orange-text); }
  .score-red .score-pct { color: var(--ew-orange-text); }
  .score-orange { border-color: var(--ew-orange-text); }
  .score-orange .score-pct { color: var(--ew-orange-text); }
  .score-green { border-color: var(--ew-ink2); }
  .score-green .score-pct { color: var(--ew-ink2); }

  .stats-bar {
    display: grid; grid-template-columns: repeat(4, 1fr); border: 0.5px solid var(--ew-border2); gap: 0;
    margin-bottom: 28px;
  }
  .stat-card {
    padding: 1.25rem 1.5rem; background: var(--ew-bg);
    border: none; border-right: 0.5px solid var(--ew-border2); border-radius: 8px;
    box-shadow: none;
  }
  .stat-card:last-child { border-right: none; }
  .stat-card-value { font-family: 'IBM Plex Mono', monospace; font-size: 32px; font-weight: 300; line-height: 1; color: var(--noir); }
  .stat-card-label { font-size: 12px; color: var(--color-text-tertiary); margin-top: 2px; }
  .stat-card-sub { font-size: 11px; color: var(--color-text-tertiary); margin-top: 4px; }
  .stat-accent .stat-card-value { color: var(--noir); }
  .stat-ok .stat-card-value { color: var(--noir); }
  .stat-warn .stat-card-value { color: var(--noir); }

  .modules-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;
    margin-bottom: 28px;
  }
  .module-card {
    background: var(--ew-bg); border: 0.5px solid var(--ew-border2);
    border-radius: 8px; box-shadow: none;
    display: flex; flex-direction: column; overflow: hidden;
  }
  .module-header {
    padding: 14px 18px; display: flex; justify-content: space-between;
    align-items: center; border-bottom: 1px solid var(--color-border-tertiary);
  }
  .module-title { font-size: 14px; font-weight: 500; color: var(--noir); }
  .module-link { font-size: 12px; color: var(--ew-text); text-decoration: none; font-weight: 500; }
  .module-link:hover { text-decoration: underline; }
  .module-body { padding: 14px 18px; flex: 1; }

  .rem-item {
    display: flex; gap: 10px; align-items: flex-start; padding: 8px 0;
    border-bottom: 1px solid var(--color-border-tertiary); font-size: 13px;
  }
  .rem-item:last-child { border-bottom: none; }
  .rem-sev { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
  :global(.sev-critical) { background: var(--ew-orange-text); }
  :global(.sev-high) { background: var(--ew-ink2); }
  :global(.sev-medium) { background: var(--ew-ink3); }
  :global(.sev-low) { background: var(--ew-ink3); }
  .rem-text { flex: 1; color: var(--noir); }
  .rem-date { font-size: 11px; color: var(--color-text-tertiary); white-space: nowrap; }

  .proc-progress { margin-bottom: 12px; }
  :global(.proc-bar-bg) {
    height: 14px; background: var(--ew-bg); border-radius: 8px;
    border: 1px solid var(--color-border-tertiary); overflow: hidden; display: flex;
  }
  :global(.proc-bar-fill) { height: 100%; transition: width 0.4s; }
  :global(.proc-fill-valide) { background: var(--ew-ink2); }
  :global(.proc-fill-encours) { background: var(--ew-ink3); }
  :global(.proc-fill-avalider) { background: var(--ew-surface); }
  :global(.proc-legend) { display: flex; gap: 12px; margin-top: 6px; font-size: 11px; color: var(--color-text-tertiary); }
  :global(.proc-legend-item) { display: flex; align-items: center; gap: 4px; }
  :global(.proc-legend-dot) { width: 8px; height: 8px; border-radius: 50%; }

  :global(.dl-item) {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 0; border-bottom: 1px solid var(--color-border-tertiary); font-size: 13px;
  }
  :global(.dl-item:last-child) { border-bottom: none; }
  :global(.dl-reg) { font-size: 10px; padding: 2px 8px; border-radius: 8px; font-weight: 400; font-family: 'IBM Plex Mono', monospace; letter-spacing: 0.06em; }
  :global(.dl-reg-dora) { background: transparent; color: var(--ew-text); border: 0.5px solid var(--ew-text); }
  :global(.dl-reg-amlr) { background: transparent; color: var(--ew-text); border: 0.5px solid var(--ew-text); }
  :global(.dl-reg-ai) { background: transparent; color: var(--ew-text); border: 0.5px solid var(--ew-text); }
  :global(.dl-reg-other) { background: transparent; color: var(--ew-text); border: 0.5px solid var(--ew-text); }
  :global(.dl-title) { flex: 1; margin: 0 10px; color: var(--noir); }
  :global(.dl-date) { font-size: 12px; font-weight: 500; white-space: nowrap; }
  :global(.dl-passed) { color: var(--color-text-tertiary); }
  :global(.dl-imminent) { color: var(--ew-orange-text); }
  :global(.dl-soon) { color: var(--ew-orange-text); }
  :global(.dl-upcoming) { color: var(--color-text-tertiary); }

  :global(.sanc-item) { padding: 8px 0; border-bottom: 1px solid var(--color-border-tertiary); font-size: 13px; }
  :global(.sanc-item:last-child) { border-bottom: none; }
  :global(.sanc-title) { color: var(--noir); font-weight: 500; }
  :global(.sanc-title a) { color: var(--ew-text); text-decoration: none; }
  :global(.sanc-title a:hover) { text-decoration: underline; }
  :global(.sanc-meta) { font-size: 11px; color: var(--color-text-tertiary); margin-top: 2px; }
  :global(.sanc-tag) {
    display: inline-block; font-size: 10px; padding: 1px 6px;
    border-radius: 8px; background: var(--ew-bg); border: 0.5px solid var(--ew-border2);
    margin-right: 3px;
  }

  .quick-links {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px;
  }
  .ql-btn {
    display: flex; align-items: center; gap: 8px; padding: 12px 16px;
    background: var(--ew-bg); border: 0.5px solid var(--ew-border2); border-radius: 8px;
    box-shadow: none; font-size: 11px;
    font-weight: 500; color: var(--noir); text-decoration: none;
    font-family: inherit; cursor: pointer; transition: all 0.15s;
  }
  .ql-btn:hover { background: var(--ew-bg); }

  .loading { padding: 20px; text-align: center; color: var(--color-text-tertiary); font-size: 13px; }
  .empty-msg { font-size: 13px; color: var(--color-text-tertiary); padding: 12px 0; }
</style>
