---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Early Watch — Nouveau mot de passe">
  <p class="auth-subtitle">Choisissez un nouveau mot de passe.</p>
  <form id="reset-form">
    <label for="password">Nouveau mot de passe</label>
    <input type="password" id="password" autocomplete="new-password" required minlength="8">
    <label for="confirm">Confirmer</label>
    <input type="password" id="confirm" autocomplete="new-password" required minlength="8">
    <div class="auth-msg error" id="match-err" style="display:none">Les mots de passe ne correspondent pas.</div>
    <button type="submit" class="auth-btn" id="btn">Changer le mot de passe</button>
  </form>
  <div class="auth-msg" id="msg"></div>
  <div class="auth-footer">
    <a href={`${import.meta.env.BASE_URL}login`}>&larr; Retour à la connexion</a>
  </div>

  <script>
    import { API } from '../scripts/api';

    const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';
    const params = new URLSearchParams(window.location.search);
    const token = params.get('token');

    if (!token) {
      document.getElementById('reset-form')!.style.display = 'none';
      const msg = document.getElementById('msg')!;
      msg.textContent = 'Lien invalide ou expiré. Demandez un nouveau lien.';
      msg.className = 'auth-msg error';
    }

    document.getElementById('reset-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pwd = document.getElementById('password') as HTMLInputElement;
      const confirm = document.getElementById('confirm') as HTMLInputElement;
      const btn = document.getElementById('btn') as HTMLButtonElement;
      const msg = document.getElementById('msg')!;
      const matchErr = document.getElementById('match-err')!;

      matchErr.style.display = 'none';
      msg.className = 'auth-msg';

      if (pwd.value !== confirm.value) {
        matchErr.style.display = 'block';
        confirm.classList.add('error');
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<span class="auth-spinner"></span>Mise à jour\u2026';

      try {
        const r = await fetch(`${API}/api/v1/auth/reset-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, new_password: pwd.value }),
        });

        if (r.ok) {
          msg.textContent = 'Mot de passe mis à jour. Redirection\u2026';
          msg.className = 'auth-msg success';
          document.getElementById('reset-form')!.style.display = 'none';
          setTimeout(() => { window.location.href = BASE + 'login'; }, 2000);
        } else {
          const d = await r.json().catch(() => ({}));
          throw new Error(d.detail || 'Lien expiré ou invalide');
        }
      } catch (ex: any) {
        msg.textContent = ex.message;
        msg.className = 'auth-msg error';
        btn.disabled = false;
        btn.textContent = 'Changer le mot de passe';
      }
    });
  </script>
</AuthLayout>
