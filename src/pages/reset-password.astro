---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Early Watch — Nouveau mot de passe">
  <p style="font-size:13px;color:var(--mute);line-height:1.6;margin-bottom:24px">
    Choisissez un nouveau mot de passe.
  </p>
  <form id="reset-form">
    <div class="ew-field">
      <label class="ew-label" for="password">Nouveau mot de passe</label>
      <div style="position:relative">
        <input class="ew-input" type="password" id="password" autocomplete="new-password" required minlength="8" style="padding-right:44px">
        <button type="button" class="pwd-toggle" data-pwd-toggle="password" aria-label="Afficher">
          <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
        </button>
      </div>
    </div>
    <div class="ew-field">
      <label class="ew-label" for="confirm">Confirmer</label>
      <div style="position:relative">
        <input class="ew-input" type="password" id="confirm" autocomplete="new-password" required minlength="8" style="padding-right:44px">
        <button type="button" class="pwd-toggle" data-pwd-toggle="confirm" aria-label="Afficher">
          <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
        </button>
      </div>
    </div>
    <div id="match-err" style="font-size:12px;color:var(--color-error);margin-bottom:12px;display:none">Les mots de passe ne correspondent pas.</div>
    <button type="submit" class="ew-login-btn" id="btn">Changer le mot de passe</button>
  </form>
  <div id="msg" style="font-size:13px;margin-top:16px;line-height:1.6;display:none"></div>
  <div style="margin-top:20px;text-align:center;font-size:12px">
    <a href={`${import.meta.env.BASE_URL}login`} style="color:var(--taupe);text-decoration:none">&larr; Retour à la connexion</a>
  </div>

  <style>
    .pwd-toggle {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
      color: var(--mute);
      line-height: 1;
    }
    .pwd-toggle:hover { color: var(--ink); }
    .ew-input.error { border-color: var(--color-error); }
  </style>

  <script>
    import { API } from '../scripts/api';

    const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';
    const params = new URLSearchParams(window.location.search);
    const token = params.get('token');

    if (!token) {
      document.getElementById('reset-form')!.style.display = 'none';
      const msg = document.getElementById('msg')!;
      msg.textContent = 'Lien invalide ou expiré. Demandez un nouveau lien.';
      msg.style.color = 'var(--color-error)';
      msg.style.display = 'block';
    }

    // Password eye toggles
    document.querySelectorAll('[data-pwd-toggle]').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const input = document.getElementById(btn.dataset.pwdToggle) as HTMLInputElement;
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.querySelector('.eye-open').style.display = show ? 'none' : 'block';
        btn.querySelector('.eye-closed').style.display = show ? 'block' : 'none';
      });
    });

    document.getElementById('reset-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pwd = document.getElementById('password') as HTMLInputElement;
      const confirm = document.getElementById('confirm') as HTMLInputElement;
      const btn = document.getElementById('btn') as HTMLButtonElement;
      const msg = document.getElementById('msg')!;
      const matchErr = document.getElementById('match-err')!;

      matchErr.style.display = 'none';

      if (pwd.value !== confirm.value) {
        matchErr.style.display = 'block';
        confirm.classList.add('error');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Mise à jour\u2026';

      try {
        const r = await fetch(`${API}/api/v1/auth/reset-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, new_password: pwd.value }),
        });

        if (r.ok) {
          msg.textContent = 'Mot de passe mis à jour. Redirection\u2026';
          msg.style.color = 'var(--taupe)';
          msg.style.display = 'block';
          document.getElementById('reset-form')!.style.display = 'none';
          setTimeout(() => { window.location.href = BASE + 'login'; }, 2000);
        } else {
          const d = await r.json().catch(() => ({}));
          throw new Error(d.detail || 'Lien expiré ou invalide');
        }
      } catch (ex: any) {
        msg.textContent = ex.message;
        msg.style.color = 'var(--color-error)';
        msg.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Changer le mot de passe';
      }
    });
  </script>
</AuthLayout>
