---
import SmartLayout from '../layouts/SmartLayout.astro';
const base = import.meta.env.BASE_URL;
---

<SmartLayout title="Pays à risque — Early Watch" activePage="pays-risque">
  <div style="max-width:1100px;margin:0 auto;">
    <div class="cr-page-title">Pays à risque LCB-FT</div>
    <div class="cr-page-sub">FATF (noire/grise) + EU high-risk + ACPR — croisement automatique avec la veille</div>

    <div id="stats-bar" class="stats-bar" style="display:none">
      <div class="stat-item stat-black">
        <div class="stat-value" id="stat-black">--</div>
        <div class="stat-label">Liste noire FATF</div>
      </div>
      <div class="stat-item stat-grey">
        <div class="stat-value" id="stat-grey">--</div>
        <div class="stat-label">Liste grise FATF</div>
      </div>
      <div class="stat-item stat-eu">
        <div class="stat-value" id="stat-eu">--</div>
        <div class="stat-label">EU high-risk seul</div>
      </div>
      <div class="stat-item stat-edd">
        <div class="stat-value" id="stat-edd">--</div>
        <div class="stat-label">EDD obligatoire</div>
      </div>
      <div class="stat-item">
        <div class="stat-value" id="stat-total">--</div>
        <div class="stat-label">Pays total</div>
      </div>
    </div>

    <div class="filters">
      <span class="filter-label">Filtrer :</span>
      <button class="filter-btn active" data-filter="all">Tous</button>
      <button class="filter-btn" data-filter="black_list">Liste noire</button>
      <button class="filter-btn" data-filter="grey_list">Liste grise</button>
      <button class="filter-btn" data-filter="eu">EU high-risk</button>
      <button class="filter-btn" data-filter="acpr">ACPR vigilance</button>
      <button class="filter-btn" data-filter="hot">Articles récents</button>
    </div>

    <div class="legend">
      <div class="legend-item"><span class="legend-dot dot-black"></span> Liste noire FATF</div>
      <div class="legend-item"><span class="legend-dot dot-grey"></span> Liste grise FATF</div>
      <div class="legend-item"><span class="legend-dot dot-eu"></span> EU high-risk</div>
      <div class="legend-item"><span class="legend-dot dot-hot"></span> Articles &lt;7j</div>
      <div class="legend-item"><span class="legend-dot dot-warm"></span> Articles &lt;30j</div>
    </div>

    <div id="table-container">
      <div class="cr-loading">Chargement des pays à risque...</div>
    </div>

    <div id="detail-panel" class="detail-panel">
      <div class="detail-title" id="detail-title"></div>
      <div class="detail-articles" id="detail-articles"></div>
    </div>

    <div class="update-info">
      Sources : FATF (fatf-gafi.org) — Plénaire fév. 2026 | Commission européenne — Règl. délégué 2016/1675 modifié déc. 2025 | ACPR<br>
      Prochaine mise à jour : après le Plénaire FATF de juin 2026
    </div>
  </div>
</SmartLayout>

<style>
  .cr-page-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 4px; }
  .cr-page-sub   { font-size: 13px; color: var(--mute); margin-bottom: 28px; }

  .stats-bar {
    display: grid; grid-template-columns: repeat(5, 1fr);
    border: 0.5px solid var(--line); margin-bottom: 24px;
    background: var(--bg);
  }
  .stat-item {
    display: flex; flex-direction: column; gap: 2px;
    padding: 20px 24px; border-right: 0.5px solid var(--line);
  }
  .stat-item:last-child { border-right: none; }
  .stat-value { font-family: var(--font-mono); font-size: 32px; font-weight: 300; line-height: 1; color: var(--ink); }
  .stat-label { font-size: 12px; color: var(--mute); }

  .filters {
    display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; align-items: center;
  }
  .filter-label { font-size: 12px; color: var(--mute); font-family: var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .filter-btn {
    padding: 5px 12px; border: 0.5px solid var(--line-strong);
    background: transparent; font-size: 12px; color: var(--taupe);
    cursor: pointer; font-family: inherit; transition: all 0.12s;
  }
  .filter-btn:hover { background: var(--bg-side); color: var(--ink); }
  .filter-btn.active { background: var(--ink); border-color: var(--ink); color: var(--bg); }

  .legend {
    display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 20px;
    font-size: 12px; color: var(--mute);
  }
  .legend-item  { display: flex; align-items: center; gap: 5px; }
  .legend-dot   { width: 8px; height: 8px; border-radius: 50%; border: 0.5px solid var(--line); display: inline-block; }
  .dot-black    { background: var(--ink); }
  .dot-grey     { background: var(--taupe); }
  .dot-eu       { background: var(--ink-soft); }
  .dot-hot      { background: var(--moutarde); }
  .dot-warm     { background: var(--ink-soft); }

  .detail-panel {
    display: none; margin-top: 20px; padding: 20px;
    background: var(--bg); border: 0.5px solid var(--line);
  }
  :global(.detail-panel.open) { display: block; }
  .detail-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 12px; }
  .detail-articles { display: flex; flex-direction: column; gap: 8px; }

  .update-info {
    margin-top: 20px; padding: 12px 16px; font-size: 12px;
    color: var(--mute); background: var(--bg-side);
    border: 0.5px solid var(--line);
  }
  .cr-loading { padding: 40px; text-align: center; color: var(--mute); font-size: 13px; }
</style>

<style is:global>
  .cr-table {
    width: 100%; border-collapse: collapse;
    border: 0.5px solid var(--line); overflow: hidden;
  }
  .cr-table thead th {
    background: var(--bg-side); color: var(--mute);
    font-family: var(--font-mono); font-size: 10px;
    font-weight: 500; text-align: left; padding: 10px 14px;
    text-transform: uppercase; letter-spacing: 0.1em;
    border-bottom: 0.5px solid var(--line-strong);
  }
  .cr-table tbody tr { transition: background 0.1s; }
  .cr-table tbody tr:hover { background: var(--bg-side); }
  .cr-table td { padding: 10px 14px; font-size: 13px; color: var(--ink); border-top: 0.5px solid var(--line); }
  .cr-table td:first-child { font-weight: 500; }

  .country-cell  { display: flex; align-items: center; gap: 8px; }
  .country-flag  { font-size: 18px; }
  .country-name  { font-weight: 500; }

  .fatf-badge { display: inline-block; padding: 2px 9px; font-family: var(--font-mono); font-size: 10px; font-weight: 400; letter-spacing: 0.06em; border: 0.5px solid; }
  .fatf-black { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .fatf-grey  { color: var(--taupe); border-color: var(--taupe); }
  .fatf-clean { color: var(--taupe); border-color: var(--line-strong); }

  .eu-badge { display: inline-block; padding: 2px 8px; font-family: var(--font-mono); font-size: 10px; font-weight: 400; border: 0.5px solid; }
  .eu-yes   { color: var(--ink-soft); border-color: var(--ink-soft); }
  .eu-no    { color: var(--ghost); font-size: 11px; }

  .edd-badge {
    display: inline-flex; align-items: center; gap: 3px;
    padding: 2px 8px; font-family: var(--font-mono); font-size: 10px; font-weight: 400;
    color: var(--moutarde); border: 0.5px solid var(--moutarde);
  }

  .cr-freshness-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 9px; font-family: var(--font-mono); font-size: 10px; font-weight: 400;
    cursor: pointer; border: 0.5px solid;
  }
  .cr-freshness-hot  { color: var(--moutarde); border-color: var(--moutarde); }
  .cr-freshness-warm { color: var(--ink-soft); border-color: var(--ink-soft); }
  .cr-freshness-dot  { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

  .acpr-badge { display: inline-block; font-size: 11px; padding: 2px 8px; color: var(--ink-soft); border: 0.5px solid var(--ink-soft); }

  .legal-cell { font-size: 11px; color: var(--mute); max-width: 200px; }
  .notes-row td { padding: 6px 14px 12px; font-size: 12px; color: var(--taupe); background: var(--bg-side); }

  .cr-detail-article {
    padding: 10px 14px; background: var(--bg); border: 0.5px solid var(--line);
    font-size: 13px;
  }
  .cr-detail-article a { color: var(--ink); font-weight: 500; text-decoration: none; }
  .cr-detail-article a:hover { text-decoration: underline; }
  .cr-detail-meta { font-size: 11px; color: var(--mute); margin-top: 3px; }
</style>

<script>
  import { api } from '../scripts/api';

  let allCountries: any[] = [];
  let currentFilter: string = 'all';

  async function loadCountries(): Promise<void> {
    try {
      const data: any = await api('/api/v1/countries');
      allCountries = data.countries || [];

      const s: any = data.stats || {};
      document.getElementById('stat-black')!.textContent = s.black_list || 0;
      document.getElementById('stat-grey')!.textContent = s.grey_list || 0;
      document.getElementById('stat-eu')!.textContent = s.eu_only || 0;
      document.getElementById('stat-edd')!.textContent = s.edd_required || 0;
      document.getElementById('stat-total')!.textContent = s.total || 0;
      document.getElementById('stats-bar')!.style.display = '';

      renderTable();
    } catch (e: any) {
      document.getElementById('table-container')!.innerHTML =
        `<div class="cr-loading">Erreur : ${e.message}</div>`;
    }
  }

  function getFiltered(): any[] {
    return allCountries.filter((c: any) => {
      if (currentFilter === 'all') return true;
      if (currentFilter === 'black_list') return c.fatf_status === 'black_list';
      if (currentFilter === 'grey_list') return c.fatf_status === 'grey_list';
      if (currentFilter === 'eu') return c.eu_high_risk;
      if (currentFilter === 'acpr') return c.acpr_vigilance;
      if (currentFilter === 'hot') return c.freshness === 'hot' || c.freshness === 'warm';
      return true;
    });
  }

  function renderTable(): void {
    const countries: any[] = getFiltered();
    if (!countries.length) {
      document.getElementById('table-container')!.innerHTML =
        '<div class="cr-loading">Aucun pays pour ce filtre.</div>';
      return;
    }

    let html: string = `<table class="cr-table">
      <thead><tr>
        <th>Pays</th><th>FATF</th><th>EU</th><th>ACPR</th><th>EDD</th><th>Base légale</th><th>Veille</th>
      </tr></thead><tbody>`;

    for (const c of countries) {
      let fatfBdg: string = '';
      if (c.fatf_status === 'black_list') fatfBdg = '<span class="fatf-badge fatf-black">Liste noire</span>';
      else if (c.fatf_status === 'grey_list') fatfBdg = '<span class="fatf-badge fatf-grey">Liste grise</span>';
      else fatfBdg = '<span class="fatf-badge fatf-clean">Clean</span>';

      const euBdg: string = c.eu_high_risk
        ? '<span class="eu-badge eu-yes">EU high-risk</span>'
        : '<span class="eu-no">\u2014</span>';

      const acprBdg: string = c.acpr_vigilance
        ? '<span class="acpr-badge">ACPR</span>'
        : '<span class="eu-no">\u2014</span>';

      const eddBdg: string = c.edd_required
        ? '<span class="edd-badge">EDD obligatoire</span>'
        : '\u2014';

      let freshBdg: string = '';
      if (c.freshness === 'hot') {
        freshBdg = `<span class="cr-freshness-badge cr-freshness-hot" data-show-country="${c.iso3}">
          <span class="cr-freshness-dot"></span>${c.articles_count_7d} article${c.articles_count_7d > 1 ? 's' : ''} &lt;7j</span>`;
      } else if (c.freshness === 'warm') {
        freshBdg = `<span class="cr-freshness-badge cr-freshness-warm" data-show-country="${c.iso3}">
          <span class="cr-freshness-dot"></span>${c.articles_count_30d} &lt;30j</span>`;
      } else {
        freshBdg = '<span class="eu-no">\u2014</span>';
      }

      html += `<tr data-show-country="${c.iso3}" style="cursor:pointer">
        <td><div class="country-cell">
          <span class="country-flag">${c.flag_emoji || ''}</span>
          <span class="country-name">${c.country_name}</span>
        </div></td>
        <td>${fatfBdg}</td>
        <td>${euBdg}</td>
        <td>${acprBdg}</td>
        <td>${eddBdg}</td>
        <td class="legal-cell">${c.legal_basis || '\u2014'}</td>
        <td>${freshBdg}</td>
      </tr>`;

      if (c.notes) {
        html += `<tr class="notes-row"><td colspan="7">${c.flag_emoji || ''} ${c.notes}</td></tr>`;
      }
    }

    html += '</tbody></table>';
    document.getElementById('table-container')!.innerHTML = html;

    document.querySelectorAll('[data-show-country]').forEach((el: any) => {
      el.addEventListener('click', () => {
        showDetail(el.dataset.showCountry);
      });
    });
  }

  async function showDetail(iso3: string): Promise<void> {
    const panel: HTMLElement = document.getElementById('detail-panel')!;
    const titleEl: HTMLElement = document.getElementById('detail-title')!;
    const articlesEl: HTMLElement = document.getElementById('detail-articles')!;

    const c: any = allCountries.find((x: any) => x.iso3 === iso3);
    if (!c) return;

    titleEl.textContent = `${c.flag_emoji || ''} ${c.country_name} \u2014 articles de veille (90 jours)`;
    articlesEl.innerHTML = '<div class="cr-loading" style="padding:12px 0;font-size:13px">Chargement...</div>';
    panel.classList.add('open');
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    try {
      const data: any = await api(`/api/v1/countries/${iso3}`);
      const articles: any[] = data.articles || [];

      if (!articles.length) {
        articlesEl.innerHTML = '<div style="font-size:13px;color:var(--mute)">Aucun article mentionne ce pays sur les 90 derniers jours.</div>';
        return;
      }

      articlesEl.innerHTML = articles.map((a: any) => {
        const date: string = a.published_at
          ? new Date(a.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })
          : '';
        const themes: string = (a.themes || []).slice(0, 3).map((t: string) =>
          `<span style="background:var(--bg-hover);padding:1px 6px;font-size:10px;border:0.5px solid var(--line);color:var(--taupe)">${t}</span>`
        ).join(' ');
        return `<div class="cr-detail-article">
          <a href="${a.original_url || '#'}" target="_blank">${a.title}</a>
          <div class="cr-detail-meta">${a.source_name || ''} \u2014 ${date} ${themes}</div>
        </div>`;
      }).join('');
    } catch (e: any) {
      articlesEl.innerHTML = '<div style="color:var(--moutarde);font-size:13px">Erreur de chargement.</div>';
    }
  }

  // Filter UI
  document.querySelectorAll('.filter-btn').forEach((btn: any) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach((b: any) => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter;
      renderTable();
    });
  });

  loadCountries();
</script>
