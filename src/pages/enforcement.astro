---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Sanctions — Early Watch">
  <div style="max-width:1100px;margin:0 auto;">
    <h1 class="enf-title-page">Sanctions et décisions disciplinaires</h1>
    <p class="enf-subtitle">Décisions ACPR, AMF, EBA, ESMA — impact sur vos procédures LCB-FT</p>

    <div class="stats-bar" id="stats-bar">
      <div class="stat-item"><div class="stat-value" id="stat-total">-</div><div class="stat-label">Total sanctions</div></div>
      <div class="stat-item"><div class="stat-value" id="stat-critical">-</div><div class="stat-label">Critiques</div></div>
      <div class="stat-item"><div class="stat-value" id="stat-high">-</div><div class="stat-label">Élevées</div></div>
      <div class="stat-item"><div class="stat-value" id="stat-7d">-</div><div class="stat-label">7 derniers jours</div></div>
      <div class="stat-item"><div class="stat-value" id="stat-30d">-</div><div class="stat-label">30 derniers jours</div></div>
    </div>

    <div class="filters-bar">
      <select id="filter-source" class="enf-select"><option value="">Toutes les sources</option></select>
      <select id="filter-severity" class="enf-select">
        <option value="">Toutes sévérités</option>
        <option value="critical">Critique</option>
        <option value="high">Élevée</option>
        <option value="medium">Moyenne</option>
      </select>
    </div>

    <table class="enf-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Source</th>
          <th>Décision</th>
          <th>Sévérité</th>
          <th>Procédures impactées</th>
        </tr>
      </thead>
      <tbody id="enf-body">
        <tr><td colspan="5" class="empty-state">Chargement...</td></tr>
      </tbody>
    </table>
  </div>

  <div class="detail-panel" id="detail-panel">
    <button class="detail-close" id="detail-close-btn">&times;</button>
    <div id="detail-content"></div>
  </div>
</AppLayout>

<style>
  .enf-title-page { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 4px; }
  .enf-subtitle   { font-size: 13px; color: var(--mute); margin-bottom: 28px; }

  .stats-bar {
    display: grid; grid-template-columns: repeat(5, 1fr);
    border: 0.5px solid var(--line); margin-bottom: 24px;
    background: var(--bg);
  }
  .stat-item {
    display: flex; flex-direction: column; gap: 2px;
    padding: 20px 24px; border-right: 0.5px solid var(--line);
  }
  .stat-item:last-child { border-right: none; }
  .stat-value { font-family: var(--font-mono); font-size: 32px; font-weight: 300; line-height: 1; color: var(--ink); }
  .stat-label { font-size: 12px; color: var(--mute); }

  .filters-bar {
    display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; align-items: center;
  }
  .enf-select {
    padding: 7px 12px; border: 0.5px solid var(--line-strong);
    background: var(--bg); font-size: 13px;
    font-family: inherit; color: var(--ink); outline: none;
    transition: border-color 0.15s;
  }
  .enf-select:focus { border-color: var(--ink); }

  .enf-table {
    width: 100%; border-collapse: collapse;
    border: 0.5px solid var(--line); background: var(--bg);
  }
  .enf-table th {
    background: var(--bg-side); font-family: var(--font-mono); font-size: 10px; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.1em;
    padding: 10px 14px; text-align: left; color: var(--mute);
    border-bottom: 0.5px solid var(--line-strong);
  }
  .enf-table td {
    padding: 14px; font-size: 13px; border-bottom: 0.5px solid var(--line); vertical-align: top;
  }
  .enf-table tr:last-child td { border-bottom: none; }
  .enf-table tr:hover td { background: var(--bg-side); }

  .empty-state { text-align: center; padding: 60px 20px; color: var(--mute); font-size: 13px; }

  .detail-panel {
    display: none; position: fixed; top: 0; right: 0;
    width: 480px; height: 100vh; background: var(--bg);
    border-left: 0.5px solid var(--line);
    z-index: 200; overflow-y: auto; padding: 24px;
  }
  :global(.detail-panel.open) { display: block; }
  .detail-close {
    position: absolute; top: 12px; right: 16px;
    background: none; border: none; font-size: 20px; cursor: pointer; color: var(--ink);
  }
</style>

<style is:global>
  .enf-row-title { font-weight: 500; color: var(--ink); line-height: 1.4; max-width: 400px; display: block; }
  .enf-row-title a { color: inherit; text-decoration: none; }
  .enf-row-title a:hover { text-decoration: underline; }
  .enf-summary { font-size: 12px; color: var(--mute); margin-top: 4px; line-height: 1.5; }

  .sev-badge {
    display: inline-block; padding: 2px 8px;
    font-family: var(--font-mono); font-size: 10px; font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.06em;
    border: 0.5px solid;
  }
  .sev-critical { color: var(--moutarde); border-color: var(--moutarde); }
  .sev-high     { color: var(--ink-soft); border-color: var(--line-strong); }
  .sev-medium   { color: var(--taupe);    border-color: var(--line); }
  .sev-low      { color: var(--taupe);    border-color: var(--line); }

  .source-badge {
    display: inline-block; padding: 2px 8px; font-size: 11px; font-weight: 500;
    border: 0.5px solid var(--line); color: var(--taupe);
  }

  .proc-tag {
    display: inline-block; padding: 1px 6px; font-size: 10px;
    background: var(--bg-side); color: var(--taupe); margin: 1px 2px;
    border: 0.5px solid var(--line);
  }

  .enf-date { font-size: 12px; color: var(--mute); white-space: nowrap; }

  .detail-title   { font-size: 16px; font-weight: 500; margin-bottom: 12px; line-height: 1.3; padding-right: 32px; color: var(--ink); }
  .detail-meta    { font-size: 12px; color: var(--mute); margin-bottom: 16px; }
  .detail-summary { font-size: 14px; line-height: 1.7; margin-bottom: 20px; color: var(--ink); }
  .detail-section { margin-bottom: 16px; }
  .detail-section h4 {
    font-size: 10.5px; font-weight: 500; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--mute); margin-bottom: 8px;
    font-family: var(--font-mono);
  }
  .detail-link {
    display: inline-block; padding: 8px 18px;
    background: transparent; color: var(--ink);
    border: 0.5px solid var(--line-strong); font-size: 13px; font-weight: 500;
    text-decoration: none; margin-top: 8px; transition: background 0.12s;
  }
  .detail-link:hover { background: var(--bg-side); }
</style>

<script>
  import { api } from '../scripts/api';

  let allItems: any[] = [];

  async function loadData(): Promise<void> {
    try {
      const [statsRes, itemsRes]: any[] = await Promise.allSettled([
        api('/enforcement/stats'),
        api('/enforcement?limit=100')
      ]);

      if (statsRes.status === 'fulfilled') {
        const s: any = statsRes.value;
        document.getElementById('stat-total')!.textContent = s.total || 0;
        document.getElementById('stat-critical')!.textContent = s.critical || 0;
        document.getElementById('stat-high')!.textContent = s.high || 0;
        document.getElementById('stat-7d')!.textContent = s.last_7d || 0;
        document.getElementById('stat-30d')!.textContent = s.last_30d || 0;

        const sourceSelect: HTMLSelectElement = document.getElementById('filter-source') as HTMLSelectElement;
        if (s.by_source) {
          Object.entries(s.by_source).sort((a: any, b: any) => b[1] - a[1]).forEach(([src, cnt]: any) => {
            const opt: HTMLOptionElement = document.createElement('option');
            opt.value = src;
            opt.textContent = `${src} (${cnt})`;
            sourceSelect.appendChild(opt);
          });
        }
      }

      if (itemsRes.status === 'fulfilled') {
        allItems = itemsRes.value.items || [];
        renderTable(allItems);
      }
    } catch (e: any) {
      console.error(e);
    }
  }

  function renderTable(items: any[]): void {
    const tbody: HTMLElement = document.getElementById('enf-body')!;
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="empty-state">Aucune sanction trouvée</td></tr>';
      return;
    }

    tbody.innerHTML = items.map((item: any) => {
      const date: string = item.published_at ? new Date(item.published_at).toLocaleDateString('fr-FR') : '-';
      const sevClass: string = `sev-${item.severity || 'low'}`;
      const procs: string = (item.impacted_procedures || []).map((p: string) => `<span class="proc-tag">${p}</span>`).join('');
      const summary: string = (item.summary || '').substring(0, 120);

      return `<tr data-show-detail="${item.id}" style="cursor:pointer">
        <td class="enf-date">${date}</td>
        <td><span class="source-badge">${item.source_name || '-'}</span></td>
        <td>
          <span class="enf-row-title">${item.title || '-'}</span>
          <div class="enf-summary">${summary}${summary.length >= 120 ? '...' : ''}</div>
        </td>
        <td><span class="sev-badge ${sevClass}">${item.severity || '-'}</span></td>
        <td>${procs || '<span style="color:var(--mute);font-size:12px">-</span>'}</td>
      </tr>`;
    }).join('');

    document.querySelectorAll('[data-show-detail]').forEach((row: any) => {
      row.addEventListener('click', () => {
        showDetail(row.dataset.showDetail);
      });
    });
  }

  function applyFilters(): void {
    const source: string = (document.getElementById('filter-source') as HTMLSelectElement).value;
    const severity: string = (document.getElementById('filter-severity') as HTMLSelectElement).value;
    let filtered: any[] = allItems;
    if (source) filtered = filtered.filter((i: any) => i.source_name === source);
    if (severity) filtered = filtered.filter((i: any) => i.severity === severity);
    renderTable(filtered);
  }

  document.getElementById('filter-source')!.addEventListener('change', applyFilters);
  document.getElementById('filter-severity')!.addEventListener('change', applyFilters);

  function showDetail(id: string): void {
    const item: any = allItems.find((i: any) => i.id === id);
    if (!item) return;

    const date: string = item.published_at ? new Date(item.published_at).toLocaleDateString('fr-FR') : '-';
    const sevClass: string = `sev-${item.severity || 'low'}`;
    const procs: string = (item.impacted_procedures || []).map((p: string) => `<span class="proc-tag">${p}</span>`).join(' ');
    const obls: string = (item.obligations_cited || []).map((o: string) => `<li>${o}</li>`).join('');

    document.getElementById('detail-content')!.innerHTML = `
      <div class="detail-title">${item.title}</div>
      <div class="detail-meta">
        <span class="source-badge">${item.source_name}</span>
        <span class="sev-badge ${sevClass}" style="margin-left:8px">${item.severity}</span>
        <span style="margin-left:12px;color:var(--mute)">${date}</span>
      </div>
      <div class="detail-summary">${item.summary || ''}</div>
      ${obls ? `<div class="detail-section"><h4>Obligations citées</h4><ul style="padding-left:16px;font-size:13px;line-height:1.8;color:var(--taupe)">${obls}</ul></div>` : ''}
      ${procs ? `<div class="detail-section"><h4>Procédures impactées</h4><div>${procs}</div></div>` : ''}
      ${item.original_url ? `<a href="${item.original_url}" target="_blank" class="detail-link">Voir la source</a>` : ''}
    `;
    document.getElementById('detail-panel')!.classList.add('open');
  }

  function closeDetail(): void {
    document.getElementById('detail-panel')!.classList.remove('open');
  }

  document.getElementById('detail-close-btn')!.addEventListener('click', closeDetail);
  document.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Escape') closeDetail(); });

  loadData();
</script>
