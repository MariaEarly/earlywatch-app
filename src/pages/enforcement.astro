---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Sanctions — Early Watch">
  <div class="enf-layout">
    <main class="enf-main">
      <h1 class="page-title">Sanctions et decisions disciplinaires</h1>
      <p class="page-subtitle">Decisions ACPR, AMF, EBA, ESMA — impact sur vos procedures LCB-FT</p>

      <div class="stats-bar" id="stats-bar">
        <div class="stat-item"><div class="stat-value" id="stat-total">-</div><div class="stat-label">Total sanctions</div></div>
        <div class="stat-item stat-critical"><div class="stat-value" id="stat-critical">-</div><div class="stat-label">Critiques</div></div>
        <div class="stat-item stat-high"><div class="stat-value" id="stat-high">-</div><div class="stat-label">Elevees</div></div>
        <div class="stat-item stat-recent"><div class="stat-value" id="stat-7d">-</div><div class="stat-label">7 derniers jours</div></div>
        <div class="stat-item"><div class="stat-value" id="stat-30d">-</div><div class="stat-label">30 derniers jours</div></div>
      </div>

      <div class="filters-bar">
        <select id="filter-source"><option value="">Toutes les sources</option></select>
        <select id="filter-severity">
          <option value="">Toutes severites</option>
          <option value="critical">Critique</option>
          <option value="high">Elevee</option>
          <option value="medium">Moyenne</option>
        </select>
      </div>

      <table class="enf-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Source</th>
            <th>Decision</th>
            <th>Severite</th>
            <th>Procedures impactees</th>
          </tr>
        </thead>
        <tbody id="enf-body">
          <tr><td colspan="5" class="empty-state">Chargement...</td></tr>
        </tbody>
      </table>
    </main>
  </div>

  <div class="detail-panel" id="detail-panel">
    <button class="detail-close" id="detail-close-btn">&times;</button>
    <div id="detail-content"></div>
  </div>
</AppLayout>

<style>
  .enf-layout { min-height: 100vh; display: flex; flex-direction: column; }
  .enf-main { flex: 1; max-width: 1200px; margin: 0 auto; padding: 32px 24px; width: 100%; }
  .page-title { font-size: 15px; font-weight: 500; color: var(--noir); margin-bottom: 4px; }
  .page-subtitle { font-size: 14px; color: var(--color-text-tertiary); margin-bottom: 28px; }

  .stats-bar {
    display: grid; grid-template-columns: repeat(5, 1fr); margin-bottom: 24px; padding: 0;
    background: var(--ew-bg); border: 0.5px solid var(--ew-border2);
    border-radius: 8px; box-shadow: none; gap: 0;
  }
  .stat-item { display: flex; flex-direction: column; gap: 2px; padding: 1.25rem 1.5rem; border-right: 0.5px solid var(--ew-border2); }
  .stat-item:last-child { border-right: none; }
  .stat-value { font-family: 'IBM Plex Mono', monospace; font-size: 32px; font-weight: 300; line-height: 1; color: var(--noir); }
  .stat-label { font-size: 12px; color: var(--color-text-tertiary); }
  .stat-critical .stat-value { color: var(--noir); }
  .stat-high .stat-value { color: var(--noir); }
  .stat-recent .stat-value { color: var(--noir); }

  .filters-bar {
    display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; align-items: center;
  }
  .filters-bar select, .filters-bar input {
    padding: 8px 12px; border: 0.5px solid var(--ew-border2);
    border-radius: 8px; background: var(--ew-bg); font-size: 13px;
    font-family: inherit; color: var(--ew-ink);
  }

  .enf-table {
    width: 100%; border-collapse: collapse; border-spacing: 0;
    border: 0.5px solid var(--ew-border2); border-radius: 8px;
    overflow: hidden; box-shadow: none; background: var(--ew-bg);
  }
  .enf-table th {
    background: var(--ew-bg); font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.08em;
    padding: 12px 14px; text-align: left; color: var(--ew-ink3);
    border-bottom: 0.5px solid var(--ew-border2);
  }
  .enf-table td {
    padding: 14px; font-size: 13px; border-bottom: 0.5px solid var(--ew-border2); vertical-align: top;
  }
  .enf-table tr:last-child td { border-bottom: none; }
  .enf-table tr:hover td { background: var(--ew-bg); }

  .empty-state { text-align: center; padding: 60px 20px; color: var(--color-text-tertiary); font-size: 14px; }

  .detail-panel {
    display: none; position: fixed; top: 0; right: 0;
    width: 480px; height: 100vh; background: var(--ew-bg);
    border-left: 0.5px solid var(--ew-border2);
    box-shadow: none;
    z-index: 200; overflow-y: auto; padding: 24px;
  }
  :global(.detail-panel.open) { display: block; }
  .detail-close {
    position: absolute; top: 12px; right: 16px;
    background: none; border: none; font-size: 20px; cursor: pointer; color: var(--noir);
  }
</style>

<style is:global>
  .enf-title { font-weight: 500; color: var(--noir); line-height: 1.4; max-width: 400px; display: block; }
  .enf-title a { color: inherit; text-decoration: none; }
  .enf-title a:hover { text-decoration: underline; }
  .enf-summary { font-size: 12px; color: var(--color-text-tertiary); margin-top: 4px; line-height: 1.5; }

  .sev-badge { display: inline-block; padding: 2px 8px; border-radius: 8px; font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 400; text-transform: uppercase; letter-spacing: 0.06em; }
  .sev-critical { background: var(--ew-accent-bg); color: var(--ew-accent-text); }
  .sev-high { background: var(--ew-bg); color: var(--ew-ink2); }
  .sev-medium { background: var(--ew-bg); color: var(--ew-ink3); }
  .sev-low { background: var(--ew-bg); color: var(--ew-ink3); }

  .source-badge {
    display: inline-block; padding: 2px 8px; border-radius: 8px;
    font-size: 11px; font-weight: 500; background: var(--ew-bg); border: 0.5px solid var(--ew-border2);
  }

  .proc-tag {
    display: inline-block; padding: 1px 6px; border-radius: 8px;
    font-size: 10px; font-weight: 500; background: var(--ew-surface); color: var(--ew-text-secondary); margin: 1px 2px;
  }

  .enf-date { font-size: 12px; color: var(--color-text-tertiary); white-space: nowrap; }

  .detail-title { font-size: 18px; font-weight: 500; margin-bottom: 12px; line-height: 1.3; padding-right: 32px; }
  .detail-meta { font-size: 12px; color: var(--color-text-tertiary); margin-bottom: 16px; }
  .detail-summary { font-size: 14px; line-height: 1.7; margin-bottom: 20px; color: var(--noir); }
  .detail-section { margin-bottom: 16px; }
  .detail-section h4 { font-size: 12px; font-weight: 500; text-transform: uppercase; color: var(--color-text-tertiary); margin-bottom: 8px; }
  .detail-link {
    display: inline-block; padding: 10px 20px; background: var(--ew-text);
    color: var(--ew-bg); border-radius: 8px; font-size: 13px; font-weight: 500;
    text-decoration: none; border: 1px solid var(--ew-text);
    box-shadow: none; margin-top: 8px;
  }
</style>

<script>
  import { api } from '../scripts/api';

  let allItems: any[] = [];

  async function loadData(): Promise<void> {
    try {
      const [statsRes, itemsRes]: any[] = await Promise.allSettled([
        api('/enforcement/stats'),
        api('/enforcement?limit=100')
      ]);

      if (statsRes.status === 'fulfilled') {
        const s: any = statsRes.value;
        document.getElementById('stat-total')!.textContent = s.total || 0;
        document.getElementById('stat-critical')!.textContent = s.critical || 0;
        document.getElementById('stat-high')!.textContent = s.high || 0;
        document.getElementById('stat-7d')!.textContent = s.last_7d || 0;
        document.getElementById('stat-30d')!.textContent = s.last_30d || 0;

        const sourceSelect: HTMLSelectElement = document.getElementById('filter-source') as HTMLSelectElement;
        if (s.by_source) {
          Object.entries(s.by_source).sort((a: any, b: any) => b[1] - a[1]).forEach(([src, cnt]: any) => {
            const opt: HTMLOptionElement = document.createElement('option');
            opt.value = src;
            opt.textContent = `${src} (${cnt})`;
            sourceSelect.appendChild(opt);
          });
        }
      }

      if (itemsRes.status === 'fulfilled') {
        allItems = itemsRes.value.items || [];
        renderTable(allItems);
      }
    } catch (e: any) {
      console.error(e);
    }
  }

  function renderTable(items: any[]): void {
    const tbody: HTMLElement = document.getElementById('enf-body')!;
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="empty-state">Aucune sanction trouvee</td></tr>';
      return;
    }

    tbody.innerHTML = items.map((item: any) => {
      const date: string = item.published_at ? new Date(item.published_at).toLocaleDateString('fr-FR') : '-';
      const sevClass: string = `sev-${item.severity || 'low'}`;
      const procs: string = (item.impacted_procedures || []).map((p: string) => `<span class="proc-tag">${p}</span>`).join('');
      const summary: string = (item.summary || '').substring(0, 120);

      return `<tr data-show-detail="${item.id}" style="cursor:pointer">
        <td class="enf-date">${date}</td>
        <td><span class="source-badge">${item.source_name || '-'}</span></td>
        <td>
          <span class="enf-title">${item.title || '-'}</span>
          <div class="enf-summary">${summary}${summary.length >= 120 ? '...' : ''}</div>
        </td>
        <td><span class="sev-badge ${sevClass}">${item.severity || '-'}</span></td>
        <td>${procs || '<span style="color:var(--color-text-tertiary);font-size:12px">-</span>'}</td>
      </tr>`;
    }).join('');

    document.querySelectorAll('[data-show-detail]').forEach((row: any) => {
      row.addEventListener('click', () => {
        showDetail(row.dataset.showDetail);
      });
    });
  }

  function applyFilters(): void {
    const source: string = (document.getElementById('filter-source') as HTMLSelectElement).value;
    const severity: string = (document.getElementById('filter-severity') as HTMLSelectElement).value;
    let filtered: any[] = allItems;
    if (source) filtered = filtered.filter((i: any) => i.source_name === source);
    if (severity) filtered = filtered.filter((i: any) => i.severity === severity);
    renderTable(filtered);
  }

  document.getElementById('filter-source')!.addEventListener('change', applyFilters);
  document.getElementById('filter-severity')!.addEventListener('change', applyFilters);

  function showDetail(id: string): void {
    const item: any = allItems.find((i: any) => i.id === id);
    if (!item) return;

    const date: string = item.published_at ? new Date(item.published_at).toLocaleDateString('fr-FR') : '-';
    const sevClass: string = `sev-${item.severity || 'low'}`;
    const procs: string = (item.impacted_procedures || []).map((p: string) => `<span class="proc-tag">${p}</span>`).join(' ');
    const obls: string = (item.obligations_cited || []).map((o: string) => `<li>${o}</li>`).join('');

    document.getElementById('detail-content')!.innerHTML = `
      <div class="detail-title">${item.title}</div>
      <div class="detail-meta">
        <span class="source-badge">${item.source_name}</span>
        <span class="sev-badge ${sevClass}" style="margin-left:8px">${item.severity}</span>
        <span style="margin-left:12px">${date}</span>
      </div>
      <div class="detail-summary">${item.summary || ''}</div>
      ${obls ? `<div class="detail-section"><h4>Obligations citees</h4><ul style="padding-left:16px;font-size:13px;line-height:1.8">${obls}</ul></div>` : ''}
      ${procs ? `<div class="detail-section"><h4>Procedures impactees</h4><div>${procs}</div></div>` : ''}
      ${item.original_url ? `<a href="${item.original_url}" target="_blank" class="detail-link">Voir la source</a>` : ''}
    `;
    document.getElementById('detail-panel')!.classList.add('open');
  }

  function closeDetail(): void {
    document.getElementById('detail-panel')!.classList.remove('open');
  }

  document.getElementById('detail-close-btn')!.addEventListener('click', closeDetail);
  document.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Escape') closeDetail(); });

  loadData();
</script>
