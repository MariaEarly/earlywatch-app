---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Early Watch — Dashboard" activePage="dashboard">
  <div class="flex">
    <aside class="sidebar" id="sidebar-left"></aside>
    <main class="content-main" id="article-list" style="padding:12px">
      <div class="loading-overlay"><div class="spinner"></div> Chargement des articles...</div>
    </main>
    <aside class="sidebar sidebar-right" id="sidebar-right"></aside>
  </div>

  <!-- Aper\u00e7u Hebdo overlay -->
  <div id="apercu-overlay" style="display:none;position:fixed;inset:0;background:rgba(26,25,24,0.4);z-index:200;display:none;align-items:center;justify-content:center">
    <div id="apercu-panel" style="background:#EDEAE3;border:1px solid #C2BFB8;border-radius:8px;width:680px;max-width:92vw;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 8px 32px rgba(0,0,0,0.12)">
      <div style="padding:18px 22px 14px;border-bottom:1px solid #D5D2CB;display:flex;justify-content:space-between;align-items:center">
        <div>
          <div id="apercu-title" style="font-size:14px;font-weight:500;color:#1A1918">Aper\u00e7u Hebdo</div>
          <div style="font-size:12px;color:#6B6860;margin-top:2px">Glissez pour r\u00e9ordonner les articles</div>
        </div>
        <button id="apercu-close" style="background:none;border:none;font-size:18px;color:#6B6860;cursor:pointer;padding:4px">&times;</button>
      </div>
      <div id="apercu-list" style="flex:1;overflow-y:auto;padding:14px 22px"></div>
      <div style="padding:14px 22px;border-top:1px solid #D5D2CB;display:flex;gap:10px;justify-content:flex-end">
        <button id="apercu-cancel" class="btn btn-sm btn-secondary" style="border-radius:4px">Annuler</button>
        <button id="apercu-export" class="btn btn-sm btn-primary" style="border-radius:4px">Exporter dans cet ordre</button>
      </div>
    </div>
  </div>

  <!-- Tracker drawer (slide-in panel from right) -->
  <div id="tracker-overlay" style="display:none">
    <div id="tracker-drawer">
      <header style="display:flex;justify-content:space-between;align-items:center;padding:16px;border-bottom:1px solid #D5D2CB">
        <h3 style="margin:0;font-size:16px">Ajouter au Tracker</h3>
        <button id="tracker-close" class="btn btn-ghost" style="font-size:18px">&times;</button>
      </header>
      <div id="tracker-form" style="padding:16px;display:flex;flex-direction:column;gap:12px">
        <label class="tracker-field">
          <span>Source</span>
          <input type="text" id="tracker-source" class="tracker-input" />
        </label>
        <label class="tracker-field">
          <span>Date</span>
          <input type="date" id="tracker-date" class="tracker-input" />
        </label>
        <label class="tracker-field">
          <span>Sujet</span>
          <input type="text" id="tracker-sujet" class="tracker-input" />
        </label>
        <label class="tracker-field">
          <span>Synth\u00e8se</span>
          <textarea id="tracker-synthese" class="tracker-input" rows="4"></textarea>
        </label>
        <label class="tracker-field">
          <span>Type</span>
          <select id="tracker-type" class="tracker-input">
            <option value="TEXTE">TEXTE</option>
            <option value="DECISION">DECISION</option>
            <option value="CONSULTATION">CONSULTATION</option>
          </select>
        </label>
        <label class="tracker-field">
          <span>Lien</span>
          <input type="url" id="tracker-lien" class="tracker-input" />
        </label>
        <label class="tracker-field">
          <span>Statut</span>
          <input type="text" id="tracker-statut" class="tracker-input" value="Publi\u00e9" />
        </label>
      </div>
      <footer style="padding:16px;border-top:1px solid #D5D2CB;display:flex;gap:8px;justify-content:flex-end">
        <button id="tracker-cancel" class="btn btn-secondary">Annuler</button>
        <button id="tracker-confirm" class="btn btn-primary">Confirmer</button>
      </footer>
    </div>
  </div>
</AppLayout>

<script>
  import { api, formatDate, statusBadge, actionBadge, toast, getUser } from '../scripts/api';

  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';

  // Mapping proc\u00e9dures : code → nom complet
  const PROC_LABELS: Record<string, string> = {
    'EB-POL-001': 'Politique g\u00e9n\u00e9rale LCB-FT',
    'EB-RISK-001': 'Classification des risques',
    'EB-KYC-001': 'Entr\u00e9e en relation \u2014 Personne physique',
    'EB-KYC-002': 'Entr\u00e9e en relation \u2014 Personne morale',
    'EB-SCR-001': 'Criblage sanctions et PPE',
    'EB-MON-001': 'Monitoring transactionnel',
    'EB-TRC-001': 'D\u00e9claration de soup\u00e7on Tracfin',
    'EB-CASP-001': 'LCB-FT sp\u00e9cifique CASP/PSAN',
    'EB-CTRL-001': 'Contr\u00f4le permanent LCB-FT',
    'EB-AGT-001': 'Agents et distributeurs',
    'EB-UBO-001': 'B\u00e9n\u00e9ficiaires effectifs',
    'EB-EDD-001': 'Vigilance renforc\u00e9e',
    'EB-PEP-001': 'Personnes politiquement expos\u00e9es',
    'EB-SCR-002': 'Criblage sanctions avanc\u00e9',
    'EB-GEL-001': 'Gel des avoirs',
    'EB-ARCH-001': 'Archivage',
    'EB-TRV-001': 'Transfert de fonds',
    'EB-CBK-001': 'Correspondance bancaire',
    'EB-FORM-001': 'Formation LCB-FT',
  };

  function procLabel(code: string): string {
    return PROC_LABELS[code] || code;
  }

  const LINK_ICON = '<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0"><path d="M10 6.5V10a1 1 0 01-1 1H2a1 1 0 01-1-1V3a1 1 0 011-1h3.5M7.5 1H11v3.5M11 1L5 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  let articles: any[] = [];
  let activeFilter: string = 'all';
  let scoreFilter: string = 'all';
  let sourceFilter: string = 'all';
  let sortMode: string = 'recent';
  let newsletterCounts: any = null;
  let trackerPendingCount: number = 0;

  function newsletterEnabled(): boolean {
    return !!getUser()?.tenant_newsletter_enabled;
  }

  async function init(): Promise<void> {
    try {
      const [articlesData, countsData, trackerData]: any[] = await Promise.all([
        api('/api/v1/articles?page_size=200&score_min=11'),
        newsletterEnabled() ? api('/api/v1/articles/newsletter/counts').catch(() => null) : Promise.resolve(null),
        api('/api/v1/tracker/pending-count').catch(() => ({ pending: 0 })),
      ]);
      articles = Array.isArray(articlesData) ? articlesData : (articlesData?.items || []);
      newsletterCounts = countsData;
      trackerPendingCount = trackerData?.pending || 0;
    } catch (e: any) {
      document.getElementById('article-list')!.innerHTML =
        `<div class="empty-state"><div class="icon">!</div><p>${e.message}</p></div>`;
      return;
    }

    renderSidebar();
    renderArticles();
    renderRightPanel();
  }

  function renderSidebar(): void {
    const counts: any = { all: articles.length, nouveau: 0, quotidien: 0, hebdo: 0, ignorer: 0 };
    articles.forEach((a: any) => { if (counts[a.status] !== undefined) counts[a.status]++; });

    const scoreCounts: any = { all: articles.length, high: 0, med: 0, low: 0 };
    articles.forEach((a: any) => {
      if ((a.score || 0) >= 50) scoreCounts.high++;
      else if ((a.score || 0) >= 25) scoreCounts.med++;
      else scoreCounts.low++;
    });

    const srcCounts: any = {};
    articles.forEach((a: any) => {
      const s: string = a.source_name || 'Autre';
      srcCounts[s] = (srcCounts[s] || 0) + 1;
    });

    document.getElementById('sidebar-left')!.innerHTML = `
      <div class="sidebar-section">
        <h3>Statut</h3>
        <div class="filter-group">
          ${filterBtn('all', 'Tous', counts.all)}
          ${filterBtn('nouveau', 'Nouveaux', counts.nouveau)}
          ${filterBtn('quotidien', 'Quotidien', counts.quotidien)}
          ${filterBtn('hebdo', 'Hebdo', counts.hebdo)}
          ${filterBtn('ignorer', 'Ignor\u00e9s', counts.ignorer)}
        </div>
      </div>
      <div class="sidebar-section">
        <h3>Score</h3>
        <div class="filter-group">
          ${scoreFilterBtn('all', 'Tous', scoreCounts.all)}
          ${scoreFilterBtn('high', 'Prioritaire (50+)', scoreCounts.high)}
          ${scoreFilterBtn('med', 'Moyen (25-49)', scoreCounts.med)}
          ${scoreFilterBtn('low', 'Faible (<25)', scoreCounts.low)}
        </div>
      </div>
      <div class="sidebar-section">
        <h3>Source</h3>
        <div class="filter-group" style="max-height:240px;overflow-y:auto">
          ${sourceFilterBtn('all', 'Toutes', articles.length)}
          ${Object.entries(srcCounts).sort((a: any, b: any) => b[1] - a[1]).map(([name, count]: any) =>
            sourceFilterBtn(name, name, count)
          ).join('')}
        </div>
      </div>`;

    document.querySelectorAll('[data-filter]').forEach((el: any) => {
      el.addEventListener('click', () => {
        activeFilter = el.dataset.filter;
        renderSidebar();
        renderArticles();
      });
    });
    document.querySelectorAll('[data-score-filter]').forEach((el: any) => {
      el.addEventListener('click', () => {
        scoreFilter = el.dataset.scoreFilter;
        renderSidebar();
        renderArticles();
      });
    });
    document.querySelectorAll('[data-source-filter]').forEach((el: any) => {
      el.addEventListener('click', () => {
        sourceFilter = el.dataset.sourceFilter;
        renderSidebar();
        renderArticles();
      });
    });
  }

  function filterBtn(key: string, label: string, count: number): string {
    const active: string = activeFilter === key ? 'active' : '';
    return `<button class="filter-item ${active}" data-filter="${key}">
      <span>${label}</span><span class="filter-count">${count}</span>
    </button>`;
  }
  function scoreFilterBtn(key: string, label: string, count: number): string {
    const active: string = scoreFilter === key ? 'active' : '';
    return `<button class="filter-item ${active}" data-score-filter="${key}">
      <span>${label}</span><span class="filter-count">${count}</span>
    </button>`;
  }
  function sourceFilterBtn(key: string, label: string, count: number): string {
    const active: string = sourceFilter === key ? 'active' : '';
    return `<button class="filter-item ${active}" data-source-filter="${key}" style="font-size:12px">
      <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${label}</span><span class="filter-count">${count}</span>
    </button>`;
  }

  function renderArticles(): void {
    let filtered: any[] = [...articles];
    if (activeFilter !== 'all') {
      filtered = filtered.filter((a: any) => a.status === activeFilter);
    }
    if (scoreFilter === 'high') filtered = filtered.filter((a: any) => (a.score || 0) >= 50);
    else if (scoreFilter === 'med') filtered = filtered.filter((a: any) => (a.score || 0) >= 25 && (a.score || 0) < 50);
    else if (scoreFilter === 'low') filtered = filtered.filter((a: any) => (a.score || 0) < 25);
    if (sourceFilter !== 'all') filtered = filtered.filter((a: any) => (a.source_name || 'Autre') === sourceFilter);

    // Filtre temporel — toujours bas\u00e9 sur created_at (date d'ingestion dans Early Watch)
    const now = new Date();
    if (sortMode === 'week') {
      const startOfWeek = new Date(now);
      startOfWeek.setDate(now.getDate() - now.getDay() + 1);
      startOfWeek.setHours(0, 0, 0, 0);
      filtered = filtered.filter((a: any) => new Date(a.created_at) >= startOfWeek);
    } else if (sortMode === '7days') {
      const cutoff = new Date(now.getTime() - 7 * 86400000);
      filtered = filtered.filter((a: any) => new Date(a.created_at) >= cutoff);
    }

    // Tri par date — NULLS LAST : articles sans published_at en dernier
    filtered.sort((a: any, b: any) => {
      const hasA = !!a.published_at;
      const hasB = !!b.published_at;
      // Articles sans date de publication → toujours en dernier (ou premier si 'oldest')
      if (hasA !== hasB) {
        if (sortMode === 'oldest') return hasA ? -1 : 1;
        return hasA ? -1 : 1;
      }
      const da = new Date(a.published_at || a.created_at).getTime();
      const db = new Date(b.published_at || b.created_at).getTime();
      return sortMode === 'oldest' ? da - db : db - da;
    });

    const sortSelectHtml = `<div style="display:flex;justify-content:flex-end;margin-bottom:8px">
      <select id="sort-select" style="font-family:'IBM Plex Sans',sans-serif;font-size:12px;padding:5px 10px;border:1px solid #C2BFB8;border-radius:4px;background:#EDEAE3;color:#1A1918;cursor:pointer;outline:none">
        <option value="recent"${sortMode === 'recent' ? ' selected' : ''}>Plus r\u00e9cent</option>
        <option value="oldest"${sortMode === 'oldest' ? ' selected' : ''}>Plus ancien</option>
        <option value="week"${sortMode === 'week' ? ' selected' : ''}>Cette semaine</option>
        <option value="7days"${sortMode === '7days' ? ' selected' : ''}>7 derniers jours</option>
      </select>
    </div>`;

    if (filtered.length === 0) {
      document.getElementById('article-list')!.innerHTML = sortSelectHtml + `
        <div class="empty-state">
          <div class="icon">&#128196;</div>
          <p>Aucun article dans cette vue</p>
        </div>`;
      bindSortSelect();
      return;
    }

    document.getElementById('article-list')!.innerHTML = sortSelectHtml + filtered.map((a: any) => `
      <div class="article-card" data-article-nav="${a.id}">
        <div class="article-meta">
          <span>${a.source_name || 'Source inconnue'}</span>
          <span>&middot;</span>
          <span>${a.published_at ? formatDate(a.published_at) : `<span class="date-unknown-badge" style="background:#E8A23E;color:#fff;font-size:10px;padding:1px 6px;border-radius:3px;font-style:normal">Date inconnue</span><a href="#" class="fix-date-link" data-fix-date="${a.id}" onclick="event.stopPropagation();event.preventDefault()" style="font-size:10px;color:#9B9790;margin-left:4px;text-decoration:underline">Corriger</a>`}</span>
          ${a.detected_action_type ? actionBadge(a.detected_action_type) : ''}
          <span style="margin-left:auto">${statusBadge(a.status)}</span>
        </div>
        <div class="article-title-row">
          ${a.original_url
            ? `<a href="${escHtml(a.original_url)}" target="_blank" rel="noopener" class="article-title" onclick="event.stopPropagation()">${escHtml(a.title || 'Sans titre')}<span class="title-ext-icon">${LINK_ICON}</span></a>`
            : `<div class="article-title">${escHtml(a.title || 'Sans titre')}</div>`
          }
        </div>
        ${a.has_impact && a.impacted_procedures && a.impacted_procedures.length > 0 ? `
          <div class="article-impact-row" onclick="event.stopPropagation()">
            <span class="impact-badge">${a.severity === 'critical' ? '<span class="impact-dot-critical"></span>' : ''}Impacte \u2192 ${a.impacted_procedures.map((p: string) => `<span class="impact-ref" title="${escHtml(p)}">${escHtml(procLabel(p))}</span>`).join(' \u00b7 ')}</span>
            <a href="${BASE}controle" class="impact-link">Voir reminder</a>
          </div>` : ''}
        <div class="article-actions">
          <button class="btn btn-sm btn-triage${a.status === 'quotidien' ? (a.lifecycle_status === 'published' ? ' btn-triage-published' : ' btn-triage-active') : ''}" data-triage="${a.id}" data-triage-status="quotidien">Quotidien${a.status === 'quotidien' ? ' <span class="triage-reset" data-reset="' + a.id + '">\u00d7</span>' : ''}</button>
          <button class="btn btn-sm btn-triage${a.status === 'hebdo' ? (a.lifecycle_status === 'published' ? ' btn-triage-published' : ' btn-triage-active') : ''}" data-triage="${a.id}" data-triage-status="hebdo">Hebdo${a.status === 'hebdo' ? ' <span class="triage-reset" data-reset="' + a.id + '">\u00d7</span>' : ''}</button>
          <button class="btn btn-sm btn-triage${a.status === 'ignorer' ? (a.lifecycle_status === 'published' ? ' btn-triage-published' : ' btn-triage-active') : ''}" data-triage="${a.id}" data-triage-status="ignorer">Ignorer${a.status === 'ignorer' ? ' <span class="triage-reset" data-reset="' + a.id + '">\u00d7</span>' : ''}</button>
          ${newsletterEnabled() && (a.status === 'quotidien' || a.status === 'hebdo') ? `
            <button class="btn btn-sm ${a.published_to_newsletter ? 'btn-primary' : 'btn-secondary'}"
                    data-publish="${a.id}"
                    ${a.published_to_newsletter ? 'disabled title="Publi\u00e9 le ' + formatDate(a.published_to_newsletter_at) + '"' : ''}>
              ${a.published_to_newsletter ? '\u2713 Publi\u00e9' : 'Publier'}
            </button>` : ''}
          <span class="action-sep">|</span>
          ${a.tracker_added
            ? `<span class="badge-tracker-added">\u2713 Tracker</span>`
            : `<button class="btn btn-sm btn-triage btn-tracker${(!a.tracker_added && (a.severity === 'high' || a.severity === 'critical') && a.lifecycle_status !== 'ignored') ? ' btn-tracker-pending' : ''}" data-tracker="${a.id}" data-source="${escHtml(a.source_name || '')}" data-date="${a.published_at || ''}" data-title="${escHtml(a.title || '')}" data-synthese="${escHtml(a.reminder_text || '')}" data-type="${a.impact_type || 'info'}" data-url="${escHtml(a.original_url || '')}">+ Tracker</button>`
          }
        </div>
      </div>
    `).join('');

    bindSortSelect();

    // Bind events
    document.querySelectorAll('[data-article-nav]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        if (e.target.closest('button') || e.target.closest('a')) return;
        window.location.href = `${BASE}article?id=${el.dataset.articleNav}`;
      });
    });
    document.querySelectorAll('[data-triage]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        // If clicking the reset ✕, reset to nouveau instead
        if ((e.target as HTMLElement).closest('.triage-reset')) {
          triage(el.dataset.triage, 'nouveau');
          return;
        }
        triage(el.dataset.triage, el.dataset.triageStatus);
      });
    });
    document.querySelectorAll('[data-publish]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        publishArticle(el.dataset.publish);
      });
    });
    // Bind "Corriger la date" links
    document.querySelectorAll('.fix-date-link').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        e.preventDefault();
        const articleId = el.dataset.fixDate;
        const parent = el.parentElement;
        if (!parent) return;
        parent.innerHTML = `<input type="date" class="date-fix-input" data-date-article="${articleId}" style="font-size:11px;padding:1px 4px;border:1px solid #C2BFB8;border-radius:3px;font-family:'IBM Plex Sans',sans-serif;background:#EDEAE3"><button class="date-fix-ok" data-date-ok="${articleId}" style="font-size:10px;margin-left:3px;padding:1px 6px;border:1px solid #5C6347;border-radius:3px;background:#5C6347;color:#fff;cursor:pointer">OK</button>`;
        parent.querySelector('.date-fix-ok')!.addEventListener('click', async (ev: any) => {
          ev.stopPropagation();
          const input = parent.querySelector('.date-fix-input') as HTMLInputElement;
          if (!input.value) return;
          try {
            await api(`/api/v1/articles/${articleId}/date`, { method: 'PATCH', body: { published_at: input.value } });
            const idx = articles.findIndex((a: any) => a.id === articleId);
            if (idx !== -1) articles[idx].published_at = input.value + 'T00:00:00Z';
            renderArticles();
          } catch (err) { console.error('Date fix failed:', err); }
        });
      });
    });
  }

  function bindSortSelect(): void {
    const sortEl = document.getElementById('sort-select') as HTMLSelectElement;
    if (sortEl) {
      sortEl.addEventListener('change', () => {
        sortMode = sortEl.value;
        renderArticles();
      });
    }
  }

  async function publishArticle(id: string): Promise<void> {
    try {
      const res: any = await api(`/api/v1/articles/${id}/published`, { method: 'POST', body: {} });
      const idx: number = articles.findIndex((a: any) => a.id === id);
      if (idx !== -1) {
        articles[idx].published_to_newsletter = true;
        articles[idx].published_to_newsletter_at = res.published_to_newsletter_at;
        articles[idx].lifecycle_status = 'published';
      }
      if (newsletterEnabled()) {
        newsletterCounts = await api('/api/v1/articles/newsletter/counts').catch(() => newsletterCounts);
      }
      renderArticles();
      renderRightPanel();
      toast('Article publi\u00e9 dans la newsletter');
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  const LIFECYCLE_MAP: Record<string, string> = {
    nouveau: 'inbox', important: 'inbox', relu: 'inbox',
    quotidien: 'triaged', hebdo: 'triaged',
    ignorer: 'ignored', archive: 'published',
  };

  async function triage(id: string, status: string): Promise<void> {
    try {
      await api(`/api/v1/articles/${id}/triage`, { method: 'PATCH', body: { status } });
      const idx: number = articles.findIndex((a: any) => a.id === id);
      if (idx !== -1) {
        articles[idx].status = status;
        articles[idx].lifecycle_status = LIFECYCLE_MAP[status] || articles[idx].lifecycle_status;
      }
      renderSidebar();
      renderArticles();
      toast(`Article \u2192 ${status === 'quotidien' ? 'Quotidien' : status === 'hebdo' ? 'Hebdo' : 'Ignor\u00e9'}`);
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  function renderRightPanel(): void {
    const nc: any = newsletterCounts;
    const quotidienCount: number = nc ? nc.quotidien_total : 0;
    const hebdoCount: number = nc ? nc.hebdo_total : 0;
    const qDisabled: string = quotidienCount === 0 ? ';opacity:0.4;cursor:not-allowed;pointer-events:none' : '';
    const hDisabled: string = hebdoCount === 0 ? ';opacity:0.4;cursor:not-allowed;pointer-events:none' : '';
    // Tracker eligible — uses backend count (includes archives)
    const trackerBlock: string = trackerPendingCount > 0 ? `
      <div class="sidebar-section">
        <h3>Tracker</h3>
        <div style="font-size:11px;color:#6B6860">
          <span style="color:#E8A23E;font-weight:600">${trackerPendingCount}</span> article${trackerPendingCount > 1 ? 's' : ''} éligible${trackerPendingCount > 1 ? 's' : ''} non ajouté${trackerPendingCount > 1 ? 's' : ''}
        </div>
      </div>` : '';

    // Flash articles: triaged quotidien, not yet published
    const flashArticles = articles.filter((a: any) => a.lifecycle_status === 'triaged' && a.status === 'quotidien' && !a.published_to_newsletter);
    const flashBlock: string = (newsletterEnabled() && flashArticles.length > 0) ? `
      <div class="sidebar-section">
        <h3 style="display:flex;align-items:center;gap:6px"><span style="color:#E8A23E;font-size:10px">&#9679;</span> Flash</h3>
        <div style="display:flex;flex-direction:column;gap:4px">
          ${flashArticles.map((a: any) => `
            <div style="display:flex;align-items:center;gap:6px;padding:4px 0;border-bottom:1px solid #D5D2CB">
              <span style="flex:1;font-size:11px;color:var(--text-primary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escHtml(a.title)}">${escHtml(a.title.slice(0, 50))}${a.title.length > 50 ? '...' : ''}</span>
              <button class="btn btn-sm btn-secondary" data-flash-publish="${a.id}" style="padding:1px 6px;font-size:9px;white-space:nowrap">Publier</button>
            </div>`).join('')}
        </div>
      </div>` : '';

    const newsletterBlock: string = (newsletterEnabled() && nc) ? `
      <div class="sidebar-section">
        <h3>Digest</h3>
        <div style="padding:6px 0;border-bottom:1px solid #D5D2CB">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px">
            <span style="font-size:12px;font-weight:500;color:var(--text-primary)">Quotidien</span>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6B6860;white-space:nowrap">${nc.quotidien_published}/${nc.quotidien_total} publi\u00e9</span>
          </div>
          <div style="display:flex;gap:6px">
            <button class="btn btn-sm btn-secondary" data-copy-md="quotidien" style="padding:2px 8px;font-size:10px;border-radius:4px;flex:1">Copier</button>
            <button class="btn btn-sm btn-secondary" id="btn-apercu-quotidien" style="padding:2px 8px;font-size:10px;border-radius:4px;flex:1${qDisabled}" ${quotidienCount === 0 ? 'disabled' : ''}>Aper\u00e7u</button>
          </div>
        </div>
        <div style="padding:6px 0">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px">
            <span style="font-size:12px;font-weight:500;color:var(--text-primary)">Hebdo</span>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6B6860;white-space:nowrap">${nc.hebdo_published}/${nc.hebdo_total} publi\u00e9</span>
          </div>
          <div style="display:flex;gap:6px">
            <button class="btn btn-sm btn-secondary" data-copy-md="hebdo" style="padding:2px 8px;font-size:10px;border-radius:4px;flex:1">Copier</button>
            <button class="btn btn-sm btn-secondary" id="btn-apercu-hebdo" style="padding:2px 8px;font-size:10px;border-radius:4px;flex:1${hDisabled}" ${hebdoCount === 0 ? 'disabled' : ''}>Aper\u00e7u</button>
          </div>
        </div>
        <div style="padding:8px 0 0;border-top:1px solid #D5D2CB;margin-top:6px">
          <button class="btn btn-sm btn-primary" id="btn-publish-all" style="width:100%;font-size:11px;padding:6px 0"
            ${(nc.quotidien_total + nc.hebdo_total) === 0 ? 'disabled style="width:100%;font-size:11px;padding:6px 0;opacity:0.4;cursor:not-allowed"' : ''}>
            Clôturer la session
          </button>
          <div style="font-size:10px;color:#9B9790;text-align:center;margin-top:4px">Marque tous les triagés comme publiés</div>
        </div>
      </div>` : '';

    document.getElementById('sidebar-right')!.innerHTML = `
      ${flashBlock}
      ${newsletterBlock}
      ${trackerBlock}
      <div class="sidebar-section">
        <h3>Export</h3>
        <div class="flex flex-col gap-4" style="gap:6px">
          <button class="btn btn-secondary btn-sm" data-export="markdown">Export Markdown</button>
          <button class="btn btn-secondary btn-sm" id="btn-export-monthly">Export mensuel</button>
        </div>
      </div>`;

    document.querySelectorAll('[data-export]').forEach((el: any) => {
      el.addEventListener('click', () => {
        exportArticles(el.dataset.export, el.dataset.exportType);
      });
    });

    // Bind copy-to-clipboard buttons in newsletter section
    document.querySelectorAll('[data-copy-md]').forEach((el: any) => {
      el.addEventListener('click', () => {
        copyMarkdownToClipboard(el.dataset.copyMd, el);
      });
    });

    // Bind aper\u00e7u buttons
    const apercuHebdo = document.getElementById('btn-apercu-hebdo');
    if (apercuHebdo) {
      apercuHebdo.addEventListener('click', () => openApercu('hebdo'));
    }
    const apercuQuotidien = document.getElementById('btn-apercu-quotidien');
    if (apercuQuotidien) {
      apercuQuotidien.addEventListener('click', () => openApercu('quotidien'));
    }

    // Bind bulk publish button — single API call
    const publishAllBtn = document.getElementById('btn-publish-all');
    if (publishAllBtn) {
      publishAllBtn.addEventListener('click', async () => {
        const triaged = articles.filter((a: any) => a.lifecycle_status === 'triaged' && (a.status === 'quotidien' || a.status === 'hebdo'));
        if (triaged.length === 0) return;
        (publishAllBtn as HTMLButtonElement).disabled = true;
        publishAllBtn.textContent = 'Publication...';
        try {
          const res: any = await api('/api/v1/articles/publish-all', { method: 'POST', body: {} });
          // Update local state
          for (const a of triaged) {
            const idx = articles.findIndex((x: any) => x.id === a.id);
            if (idx !== -1) {
              articles[idx].published_to_newsletter = true;
              articles[idx].lifecycle_status = 'published';
            }
          }
          newsletterCounts = await api('/api/v1/articles/newsletter/counts').catch(() => newsletterCounts);
          renderArticles();
          renderRightPanel();
          toast(`${res.published || triaged.length} article${(res.published || triaged.length) > 1 ? 's' : ''} publiés — session clôturée`);
        } catch (e: any) {
          toast('Erreur: ' + (e.message || 'publication échouée'), 'error');
          (publishAllBtn as HTMLButtonElement).disabled = false;
          publishAllBtn.textContent = 'Clôturer la session';
        }
      });
    }

    // Bind Flash publish buttons — individual article publish
    document.querySelectorAll('[data-flash-publish]').forEach((el: any) => {
      el.addEventListener('click', async () => {
        const id = el.dataset.flashPublish;
        el.disabled = true;
        el.textContent = '...';
        try {
          await api(`/api/v1/articles/${id}/published`, { method: 'POST', body: {} });
          const idx = articles.findIndex((a: any) => a.id === id);
          if (idx !== -1) {
            articles[idx].published_to_newsletter = true;
            articles[idx].lifecycle_status = 'published';
          }
          newsletterCounts = await api('/api/v1/articles/newsletter/counts').catch(() => newsletterCounts);
          renderArticles();
          renderRightPanel();
          toast('Article publié — édition Flash');
        } catch (e: any) {
          toast('Erreur: ' + (e.message || 'publication échouée'), 'error');
          el.disabled = false;
          el.textContent = 'Publier';
        }
      });
    });

    // Bind Export mensuel button
    const exportMonthlyBtn = document.getElementById('btn-export-monthly');
    if (exportMonthlyBtn) {
      exportMonthlyBtn.addEventListener('click', async () => {
        // Use current month, or previous month if before the 5th
        const now = new Date();
        let year = now.getFullYear();
        let month = now.getMonth() + 1; // 1-indexed
        if (now.getDate() < 5) {
          month--;
          if (month === 0) { month = 12; year--; }
        }
        const monthStr = `${year}-${String(month).padStart(2, '0')}`;
        (exportMonthlyBtn as HTMLButtonElement).disabled = true;
        exportMonthlyBtn.textContent = `Export ${monthStr}...`;
        try {
          const md = await api(`/api/v1/articles/monthly-recap/markdown?month=${monthStr}`);
          // md is returned as text (not JSON) because of content-type check in api()
          const blob = new Blob([md as string], { type: 'text/markdown;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `early-brief-recap-${monthStr}.md`;
          a.click();
          URL.revokeObjectURL(url);
          toast(`Récap ${monthStr} exporté`);
        } catch (e: any) {
          toast('Erreur: ' + (e.message || 'export échoué'), 'error');
        }
        (exportMonthlyBtn as HTMLButtonElement).disabled = false;
        exportMonthlyBtn.textContent = 'Export mensuel';
      });
    }
  }

  // ---- Aper\u00e7u Newsletter (drag & drop) ----
  let apercuOrder: any[] = [];
  let apercuType: string = 'hebdo';

  function openApercu(type: string): void {
    apercuType = type;
    const statusFilter = type === 'quotidien'
      ? (a: any) => a.status === 'quotidien'
      : (a: any) => a.status === 'hebdo' || a.status === 'quotidien';
    apercuOrder = articles.filter(statusFilter)
      .sort((a: any, b: any) => {
        if (!!a.published_at !== !!b.published_at) return a.published_at ? -1 : 1;
        return new Date(b.published_at || b.created_at).getTime() - new Date(a.published_at || a.created_at).getTime();
      });

    const overlay = document.getElementById('apercu-overlay')!;
    overlay.style.display = 'flex';
    document.getElementById('apercu-title')!.textContent = `Aper\u00e7u ${type === 'quotidien' ? 'Quotidien' : 'Hebdo'}`;
    renderApercuList();

    document.getElementById('apercu-close')!.onclick = closeApercu;
    document.getElementById('apercu-cancel')!.onclick = closeApercu;
    document.getElementById('apercu-export')!.onclick = exportApercuOrder;
  }

  function closeApercu(): void {
    document.getElementById('apercu-overlay')!.style.display = 'none';
  }

  let dragIdx: number = -1;

  function renderApercuList(): void {
    const list = document.getElementById('apercu-list')!;
    if (!apercuOrder.length) {
      list.innerHTML = '<div style="padding:30px;text-align:center;color:#6B6860;font-size:13px">Aucun article hebdo</div>';
      return;
    }
    list.innerHTML = apercuOrder.map((a: any, i: number) => `
      <div class="apercu-item" draggable="true" data-apercu-idx="${i}" style="display:flex;align-items:center;gap:12px;padding:10px 12px;margin-bottom:6px;background:#EDEAE3;border:1px solid #D5D2CB;border-radius:8px;cursor:grab;transition:opacity .15s,border .15s">
        <span style="color:#B0ADA7;font-size:16px;cursor:grab;user-select:none;flex-shrink:0">\u2807</span>
        <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6B6860;flex-shrink:0;width:20px;text-align:center">${i + 1}</span>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:500;color:#1A1918;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escHtml(a.title || 'Sans titre')}</div>
          <div style="font-size:11px;color:#6B6860;margin-top:2px">${a.source_name || ''} \u00b7 ${a.published_at ? formatDate(a.published_at) : 'Date inconnue'}</div>
        </div>
      </div>
    `).join('');

    // Bind drag events
    list.querySelectorAll('.apercu-item').forEach((el: any) => {
      el.addEventListener('dragstart', (e: DragEvent) => {
        dragIdx = parseInt(el.dataset.apercuIdx);
        el.style.opacity = '0.5';
        e.dataTransfer!.effectAllowed = 'move';
      });
      el.addEventListener('dragend', () => {
        el.style.opacity = '1';
        list.querySelectorAll('.apercu-item').forEach((x: any) => {
          x.style.border = '1px solid #D5D2CB';
        });
      });
      el.addEventListener('dragover', (e: DragEvent) => {
        e.preventDefault();
        e.dataTransfer!.dropEffect = 'move';
        el.style.border = '1px dashed #5C6347';
      });
      el.addEventListener('dragleave', () => {
        el.style.border = '1px solid #D5D2CB';
      });
      el.addEventListener('drop', (e: DragEvent) => {
        e.preventDefault();
        const dropIdx = parseInt(el.dataset.apercuIdx);
        if (dragIdx !== dropIdx && dragIdx >= 0) {
          const item = apercuOrder.splice(dragIdx, 1)[0];
          apercuOrder.splice(dropIdx, 0, item);
          renderApercuList();
        }
      });
    });
  }

  async function exportApercuOrder(): Promise<void> {
    const label = apercuType === 'quotidien' ? 'Quotidien' : 'Hebdo';
    const today = new Date().toLocaleDateString('fr-FR');
    const lines = [`# Early Watch ${label} \u2014 ${today}`, ''];
    apercuOrder.forEach((a: any, i: number) => {
      const pub = a.published_at ? new Date(a.published_at).toLocaleDateString('fr-FR') : 'Date inconnue';
      lines.push(`## ${i + 1}. ${a.title}`);
      lines.push('');
      if (a.summary) { lines.push(a.summary); lines.push(''); }
      lines.push(`**Source :** ${a.source_name || 'Source inconnue'} \u2014 ${pub}${!a.published_at ? ' (date non confirm\u00e9e)' : ''}`);
      lines.push(`**Lien :** ${a.original_url || 'N/A'}`);
      lines.push('');
      lines.push('---');
      lines.push('');
    });
    const blob = new Blob([lines.join('\n')], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `earlywatch-${apercuType}-${new Date().toISOString().slice(0,10)}.md`;
    link.click();
    URL.revokeObjectURL(url);
    closeApercu();
    toast('Export hebdo t\u00e9l\u00e9charg\u00e9');
  }

  async function copyMarkdownToClipboard(type: string, btn: HTMLButtonElement): Promise<void> {
    try {
      const data: any = await api(`/api/v1/articles/export/markdown?type=${type}`);
      const text: string = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
      await navigator.clipboard.writeText(text);
      const original = btn.textContent;
      btn.textContent = '\u2713 Copi\u00e9 !';
      btn.style.color = '#5C6347';
      btn.style.fontWeight = '500';
      setTimeout(() => {
        btn.textContent = original;
        btn.style.color = '';
        btn.style.fontWeight = '';
      }, 2000);
    } catch (e: any) {
      toast(e.message || 'Erreur de copie', 'error');
    }
  }

  async function exportArticles(format: string, type?: string): Promise<void> {
    try {
      let path: string = format === 'markdown' ? '/api/v1/articles/export/markdown' : '/api/v1/articles/export';
      if (type) path += `?type=${type}`;
      const data: any = await api(path);
      const blob: Blob = new Blob([typeof data === 'string' ? data : JSON.stringify(data, null, 2)], { type: 'text/plain' });
      const url: string = URL.createObjectURL(blob);
      const a: HTMLAnchorElement = document.createElement('a');
      a.href = url;
      const suffix: string = type ? `-${type}` : '';
      a.download = `earlywatch-export${suffix}.${format === 'markdown' ? 'md' : 'json'}`;
      a.click();
      URL.revokeObjectURL(url);
      toast('Export t\u00e9l\u00e9charg\u00e9');
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  function escHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // --- Tracker drawer ---
  let trackerArticleId: string | null = null;

  document.addEventListener('click', (e: Event) => {
    const btn = (e.target as HTMLElement).closest('[data-tracker]') as HTMLElement | null;
    if (!btn) return;

    trackerArticleId = btn.dataset.tracker!;

    // Pre-fill form from data attributes
    (document.getElementById('tracker-source') as HTMLInputElement).value = btn.dataset.source || '';
    (document.getElementById('tracker-date') as HTMLInputElement).value = btn.dataset.date ? btn.dataset.date.slice(0, 10) : '';
    (document.getElementById('tracker-sujet') as HTMLInputElement).value = btn.dataset.title || '';
    (document.getElementById('tracker-synthese') as HTMLTextAreaElement).value = btn.dataset.synthese || '';
    (document.getElementById('tracker-lien') as HTMLInputElement).value = btn.dataset.url || '';
    (document.getElementById('tracker-statut') as HTMLInputElement).value = 'Publi\u00e9';

    // Map impact_type to tracker type
    const typeMap: Record<string, string> = { nouvelle_regle: 'TEXTE', mise_a_jour: 'TEXTE', sanction: 'DECISION', appel_vigilance: 'CONSULTATION', consultation: 'CONSULTATION', info: 'TEXTE' };
    (document.getElementById('tracker-type') as HTMLSelectElement).value = typeMap[btn.dataset.type || ''] || 'TEXTE';

    document.getElementById('tracker-overlay')!.style.display = 'flex';
  });

  document.getElementById('tracker-close')?.addEventListener('click', () => {
    document.getElementById('tracker-overlay')!.style.display = 'none';
  });
  document.getElementById('tracker-cancel')?.addEventListener('click', () => {
    document.getElementById('tracker-overlay')!.style.display = 'none';
  });
  document.getElementById('tracker-overlay')?.addEventListener('click', (e: Event) => {
    if (e.target === e.currentTarget) (e.currentTarget as HTMLElement).style.display = 'none';
  });

  document.getElementById('tracker-confirm')?.addEventListener('click', async () => {
    const body = {
      source: (document.getElementById('tracker-source') as HTMLInputElement).value,
      date: (document.getElementById('tracker-date') as HTMLInputElement).value,
      sujet: (document.getElementById('tracker-sujet') as HTMLInputElement).value,
      synthese: (document.getElementById('tracker-synthese') as HTMLTextAreaElement).value,
      type: (document.getElementById('tracker-type') as HTMLSelectElement).value,
      lien: (document.getElementById('tracker-lien') as HTMLInputElement).value,
      statut: (document.getElementById('tracker-statut') as HTMLInputElement).value,
    };

    try {
      const res: any = await api(`/api/v1/tracker/propose?article_id=${trackerArticleId}`, {
        method: 'POST',
        body: body,
      });

      if (res.success) {
        // Update local data
        const idx = articles.findIndex((a: any) => a.id === trackerArticleId);
        if (idx !== -1) articles[idx].tracker_added = true;

        // Replace button with badge
        const btn = document.querySelector(`[data-tracker="${trackerArticleId}"]`) as HTMLElement | null;
        if (btn) {
          const badge = document.createElement('span');
          badge.className = 'badge-tracker-added';
          badge.textContent = '\u2713 Tracker';
          btn.parentNode!.replaceChild(badge, btn);
          // Also remove the separator before it
          const sep = badge.previousElementSibling as HTMLElement | null;
          if (sep && sep.classList.contains('action-sep')) sep.remove();
        }
        document.getElementById('tracker-overlay')!.style.display = 'none';
        // Refresh tracker pending count from backend
        const tc: any = await api('/api/v1/tracker/pending-count').catch(() => ({ pending: 0 }));
        trackerPendingCount = tc?.pending || 0;
        renderRightPanel();
        toast('Article ajout\u00e9 au Tracker');
      } else {
        toast('Erreur tracker', 'error');
      }
    } catch (err: any) {
      toast('Erreur: ' + err.message, 'error');
    }
  });

  init();
</script>

