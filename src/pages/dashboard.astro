---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Early Watch — Inbox" activePage="dashboard" layout="3col">

  <!-- ── Col 2 : header + tabs + liste articles ── -->
  <div class="ew-header">
    <h1 class="ew-h-title">Inbox</h1>
    <div class="ew-h-date" id="ew-today"></div>
    <!-- Sélecteur vue client — visible uniquement pour superadmin -->
    <button
      id="btn-demo-client"
      style="display:none;font-size:11px;font-family:var(--font-mono);letter-spacing:0.08em;color:var(--taupe);background:none;border:0.5px solid var(--line-strong);border-radius:var(--radius);padding:5px 12px;cursor:pointer;transition:color 0.12s,border-color 0.12s"
      title="Basculer vers la vue client Demo PSP"
    >
      Voir comme client Demo PSP →
    </button>
  </div>
  <div id="article-list">
    <div class="ew-loading"><div class="ew-spinner"></div></div>
  </div>

  <!-- ── Col 3 : panel droit (rempli dynamiquement par renderRightPanel) ── -->
  <aside slot="right" class="ew-right" id="sidebar-right">
    <div class="ew-loading"><div class="ew-spinner"></div></div>
  </aside>

</AppLayout>

<!-- ── Aperçu Newsletter overlay ── -->
<div id="apercu-overlay" style="display:none;position:fixed;inset:0;background:rgba(26,24,20,0.45);z-index:200;align-items:center;justify-content:center">
  <div id="apercu-panel" style="background:var(--bg);border:0.5px solid var(--line-strong);border-radius:8px;width:680px;max-width:92vw;max-height:85vh;display:flex;flex-direction:column">
    <div style="padding:18px 22px 14px;border-bottom:0.5px solid var(--line);display:flex;justify-content:space-between;align-items:center">
      <div>
        <div id="apercu-title" style="font-size:14px;font-weight:500;color:var(--ink)">Aperçu Hebdo</div>
        <div style="font-size:12px;color:var(--taupe);margin-top:2px">Glissez pour réordonner les articles</div>
      </div>
      <button id="apercu-close" style="background:none;border:none;font-size:20px;color:var(--taupe);cursor:pointer;padding:4px;line-height:1">&times;</button>
    </div>
    <div id="apercu-list" style="flex:1;overflow-y:auto;padding:14px 22px"></div>
    <div style="padding:14px 22px;border-top:0.5px solid var(--line);display:flex;gap:10px;justify-content:flex-end">
      <button id="apercu-cancel" class="ew-btn">Annuler</button>
      <button id="apercu-export" class="ew-btn ew-btn-primary">Exporter dans cet ordre</button>
    </div>
  </div>
</div>

<!-- ── Modale confirmation clôture ── -->
<div id="cloturer-overlay" style="display:none;position:fixed;inset:0;background:rgba(26,24,20,0.45);z-index:1100;align-items:center;justify-content:center">
  <div id="cloturer-modal" style="background:var(--bg);border:0.5px solid var(--line-strong);border-radius:8px;width:440px;max-width:90vw">
    <div style="padding:20px 24px 16px">
      <div style="font-weight:500;font-size:15px;color:var(--ink);margin-bottom:10px">Articles non ajoutés au tracker</div>
      <p id="cloturer-msg" style="font-size:13px;color:var(--ink-soft);margin:0 0 6px;line-height:1.5"></p>
      <p style="font-size:12px;color:var(--taupe);margin:0;line-height:1.4">Vous pourrez les retrouver dans les Archives.</p>
    </div>
    <div style="padding:14px 24px;border-top:0.5px solid var(--line);display:flex;gap:10px;justify-content:flex-end">
      <button id="cloturer-cancel" class="ew-btn">Annuler</button>
      <button id="cloturer-confirm" style="font-size:13px;padding:7px 18px;border:none;background:var(--ink);color:var(--bg);border-radius:6px;cursor:pointer;font-family:var(--font)">Clôturer quand même</button>
    </div>
  </div>
</div>

<!-- ── Tracker drawer ── -->
<div id="tracker-overlay" style="display:none;position:fixed;inset:0;background:rgba(26,24,20,0.35);z-index:1000;justify-content:flex-end">
  <div id="tracker-drawer" style="width:420px;max-width:90vw;height:100vh;background:var(--bg);display:flex;flex-direction:column;animation:ew-slide-in 0.2s ease-out">
    <header style="display:flex;justify-content:space-between;align-items:center;padding:16px 22px;border-bottom:0.5px solid var(--line)">
      <div style="font-size:14px;font-weight:500;color:var(--ink)">Ajouter au Tracker</div>
      <button id="tracker-close" style="background:none;border:none;font-size:20px;color:var(--taupe);cursor:pointer;padding:4px;line-height:1">&times;</button>
    </header>
    <div id="tracker-form" style="flex:1;overflow-y:auto;padding:16px 22px;display:flex;flex-direction:column;gap:14px">
      <div class="ew-field"><label class="ew-label">Source</label><input type="text" id="tracker-source" class="ew-input" /></div>
      <div class="ew-field"><label class="ew-label">Date</label><input type="date" id="tracker-date" class="ew-input" /></div>
      <div class="ew-field"><label class="ew-label">Sujet</label><input type="text" id="tracker-sujet" class="ew-input" /></div>
      <div class="ew-field"><label class="ew-label">Synthèse</label><textarea id="tracker-synthese" class="ew-input ew-textarea" rows="4"></textarea></div>
      <div class="ew-field"><label class="ew-label">Type</label>
        <select id="tracker-type" class="ew-input">
          <option value="TEXTE">TEXTE</option>
          <option value="DECISION">DECISION</option>
          <option value="CONSULTATION">CONSULTATION</option>
        </select>
      </div>
      <div class="ew-field"><label class="ew-label">Lien</label><input type="url" id="tracker-lien" class="ew-input" /></div>
      <div class="ew-field"><label class="ew-label">Statut</label><input type="text" id="tracker-statut" class="ew-input" value="Publié" /></div>
    </div>
    <footer style="padding:14px 22px;border-top:0.5px solid var(--line);display:flex;gap:8px;justify-content:flex-end">
      <button id="tracker-cancel" class="ew-btn">Annuler</button>
      <button id="tracker-confirm" class="ew-btn ew-btn-primary">Confirmer</button>
    </footer>
  </div>
</div>

<script>
  import { api, formatDate, toast, getUser } from '../scripts/api';
  import { bootstrapAuth } from '../scripts/bootstrap-auth';
  import { sourceAvatarHTML } from '../scripts/sigles.js';
  import { renderEwTab, renderSortDropdown, bindSortDropdown, SORT_LABELS } from '../scripts/article-card.js';

  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';

  // ── Date helpers ─────────────────────────────────────────────────────────

  function sortDate(a: any): number {
    return a.published_at
      ? new Date(a.published_at).getTime()
      : new Date(a.created_at).getTime();
  }

  function displayDate(a: any): string {
    const pub = a.published_at;
    if (pub) {
      const d = new Date(pub);
      const imprecise = d.getUTCDate() === 1 && d.getUTCHours() === 0 && d.getUTCMinutes() === 0;
      if (!imprecise) return formatDate(pub);
      const months = ['janv.','fév.','mars','avr.','mai','juin','juil.','août','sept.','oct.','nov.','déc.'];
      return `${months[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
    }
    if (a.created_at) return formatDate(a.created_at);
    return `<span class="ew-badge ew-badge-error" style="font-size:9px">Date inconnue</span>`
      + `<a href="#" class="fix-date-link" data-fix-date="${a.id}" onclick="event.stopPropagation();event.preventDefault()" style="font-size:10px;color:var(--mute);margin-left:4px;text-decoration:underline">Corriger</a>`;
  }

  function todayFR(): string {
    return new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  }

  // ── Labels ───────────────────────────────────────────────────────────────

  const PROC_LABELS: Record<string, string> = {
    'EB-POL-001': 'Politique générale LCB-FT',
    'EB-RISK-001': 'Classification des risques',
    'EB-KYC-001': 'Entrée en relation — Personne physique',
    'EB-KYC-002': 'Entrée en relation — Personne morale',
    'EB-SCR-001': 'Criblage sanctions et PPE',
    'EB-MON-001': 'Monitoring transactionnel',
    'EB-TRC-001': 'Déclaration de soupçon Tracfin',
    'EB-CASP-001': 'LCB-FT spécifique CASP/PSAN',
    'EB-CTRL-001': 'Contrôle permanent LCB-FT',
    'EB-AGT-001': 'Agents et distributeurs',
    'EB-UBO-001': 'Bénéficiaires effectifs',
    'EB-EDD-001': 'Vigilance renforcée',
    'EB-PEP-001': 'Personnes politiquement exposées',
    'EB-SCR-002': 'Criblage sanctions avancé',
    'EB-GEL-001': 'Gel des avoirs',
    'EB-ARCH-001': 'Archivage',
    'EB-TRV-001': 'Transfert de fonds',
    'EB-CBK-001': 'Correspondance bancaire',
    'EB-FORM-001': 'Formation LCB-FT',
  };
  function procLabel(code: string): string { return PROC_LABELS[code] || code; }

  const IMPACT_LABELS: Record<string, string> = {
    sanction: 'Sanction', nouvelle_regle: 'Nouvelle règle',
    mise_a_jour: 'Mise à jour', appel_vigilance: 'Appel vigilance',
  };
  function impactLabel(t: string): string { return IMPACT_LABELS[t] || t; }

  const LINK_ICON = '<svg width="11" height="11" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;margin-left:4px;vertical-align:middle;color:var(--mute)"><path d="M10 6.5V10a1 1 0 01-1 1H2a1 1 0 01-1-1V3a1 1 0 011-1h3.5M7.5 1H11v3.5M11 1L5 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  // ── State ────────────────────────────────────────────────────────────────

  let articles: any[] = [];
  let activeFilter = 'all';
  let sortMode = 'recent';
  let newsletterCounts: any = null;
  let trackerPendingCount = 0;

  function newsletterEnabled(): boolean {
    return !!getUser()?.tenant_newsletter_enabled;
  }

  // ── Init ─────────────────────────────────────────────────────────────────

  async function init(): Promise<void> {
    // Date dans le header
    const todayEl = document.getElementById('ew-today');
    if (todayEl) {
      todayEl.textContent = todayFR();
      todayEl.style.textTransform = 'capitalize';
    }

    try {
      const [articlesData, countsData, trackerData]: any[] = await Promise.all([
        api('/api/v1/articles?page_size=200&score_min=11'),
        newsletterEnabled() ? api('/api/v1/articles/newsletter/counts').catch(() => null) : Promise.resolve(null),
        api('/api/v1/tracker/pending-count').catch(() => ({ pending: 0 })),
      ]);
      articles = Array.isArray(articlesData) ? articlesData : (articlesData?.items || []);
      newsletterCounts = countsData;
      trackerPendingCount = trackerData?.pending || 0;

      // Expose inbox count pour le badge nav
      const inbox = articles.filter((a: any) =>
        a.lifecycle_status === 'inbox' || a.lifecycle_status === 'triaged'
      );
      sessionStorage.setItem('ew_inbox_count', String(inbox.length));

    } catch (e: any) {
      document.getElementById('article-list')!.innerHTML =
        `<div class="ew-empty"><div class="ew-empty-title">Erreur de chargement</div><div class="ew-empty-sub">${e.message}</div></div>`;
      return;
    }

    renderTabs();
    renderArticles();
    renderRightPanel();
  }

  // ── Tabs ─────────────────────────────────────────────────────────────────

  function renderTabs(): void {
    const visible: any[] = articles.filter((a: any) =>
      a.lifecycle_status === 'inbox' || a.lifecycle_status === 'triaged'
    );
    const cnt: any = { all: visible.length, nouveau: 0, quotidien: 0, hebdo: 0, ignorer: 0 };
    visible.forEach((a: any) => { if (cnt[a.status] !== undefined) cnt[a.status]++; });

    const tabHtml = `
      <div class="ew-tabs" id="ew-tabs">
        ${renderEwTab('all',       'Tous',      cnt.all,      activeFilter)}
        ${renderEwTab('nouveau',   'Nouveaux',  cnt.nouveau,  activeFilter)}
        ${renderEwTab('quotidien', 'Quotidien', cnt.quotidien,activeFilter)}
        ${renderEwTab('hebdo',     'Hebdo',     cnt.hebdo,    activeFilter)}
        ${renderEwTab('ignorer',   'Ignorés',   cnt.ignorer,  activeFilter)}
        ${renderSortDropdown(sortMode)}
      </div>`;

    const container = document.getElementById('article-list')!;
    const existing = container.querySelector('#ew-tabs');
    if (existing) {
      existing.outerHTML = tabHtml;
    } else {
      container.insertAdjacentHTML('afterbegin', tabHtml);
    }

    container.querySelectorAll('[data-tab]').forEach((el: any) => {
      el.addEventListener('click', () => {
        activeFilter = el.dataset.tab;
        renderTabs();
        renderArticles();
      });
    });

    bindSortDropdown((key: string) => {
      sortMode = key;
      renderTabs();
      renderArticles();
    });
  }

  // ── Articles ─────────────────────────────────────────────────────────────

  function renderArticles(): void {
    let filtered: any[] = articles.filter((a: any) =>
      a.lifecycle_status === 'inbox' || a.lifecycle_status === 'triaged'
    );
    if (activeFilter !== 'all') filtered = filtered.filter((a: any) => a.status === activeFilter);

    const now = new Date();
    if (sortMode === 'week') {
      const start = new Date(now); start.setDate(now.getDate() - now.getDay() + 1); start.setHours(0,0,0,0);
      filtered = filtered.filter((a: any) => sortDate(a) >= start.getTime());
    } else if (sortMode === '7days') {
      filtered = filtered.filter((a: any) => sortDate(a) >= now.getTime() - 7 * 86400000);
    }

    filtered.sort((a: any, b: any) => {
      return sortMode === 'oldest' ? sortDate(a) - sortDate(b) : sortDate(b) - sortDate(a);
    });

    const container = document.getElementById('article-list')!;
    const tabs = container.querySelector('#ew-tabs');

    if (filtered.length === 0) {
      container.innerHTML = `<div class="ew-empty">
        <div class="ew-empty-title">Aucun article dans cette vue</div>
        <div class="ew-empty-sub">Modifie le filtre ou reviens plus tard.</div>
        <div class="ew-empty-hint">Dernière ingestion automatique · 4×/jour</div>
      </div>`;
      if (tabs) container.insertAdjacentElement('afterbegin', tabs);
      return;
    }

    // Rendre la liste V9
    const listHtml = `<div class="ew-list" id="ew-list">${filtered.map((a: any) => articleCard(a)).join('')}</div>`;
    container.innerHTML = listHtml;
    if (tabs) container.insertAdjacentElement('afterbegin', tabs);

    // Bind événements
    container.querySelectorAll('[data-article-nav]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        if (e.target.closest('button,a,select')) return;
        window.location.href = `${BASE}article?id=${el.dataset.articleNav}`;
      });
    });
    container.querySelectorAll('[data-triage]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        if ((e.target as HTMLElement).closest('.triage-reset')) {
          triage(el.dataset.triage, 'nouveau');
          return;
        }
        triage(el.dataset.triage, el.dataset.triageStatus);
      });
    });
    container.querySelectorAll('.fix-date-link').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation(); e.preventDefault();
        const id = el.dataset.fixDate;
        const parent = el.parentElement;
        if (!parent) return;
        parent.innerHTML = `<input type="date" class="ew-input" style="font-size:11px;padding:2px 6px;width:auto;display:inline" data-date-article="${id}"><button style="font-size:10px;margin-left:4px;padding:2px 8px;border:none;background:var(--ink);color:var(--bg);border-radius:4px;cursor:pointer" data-date-ok="${id}">OK</button>`;
        parent.querySelector('[data-date-ok]')!.addEventListener('click', async (ev: any) => {
          ev.stopPropagation();
          const input = parent.querySelector('[data-date-article]') as HTMLInputElement;
          if (!input.value) return;
          try {
            await api(`/api/v1/articles/${id}/date`, { method: 'PATCH', body: { published_at: input.value } });
            const idx = articles.findIndex((a: any) => a.id === id);
            if (idx !== -1) articles[idx].published_at = input.value + 'T00:00:00Z';
            renderArticles();
          } catch (err) { console.error('Date fix failed:', err); }
        });
      });
    });
  }

  function articleCard(a: any): string {
    const isIgnored = a.status === 'ignorer';
    const isActive = (status: string) => a.status === status && a.lifecycle_status !== 'published';
    const isPublished = (status: string) => a.status === status && a.lifecycle_status === 'published';

    const qClass = isActive('quotidien') ? ' ew-btn-active' : isPublished('quotidien') ? ' ew-btn-ghost' : '';
    const hClass = isActive('hebdo') ? ' ew-btn-active' : isPublished('hebdo') ? ' ew-btn-ghost' : '';

    const trackerBtn = a.tracker_added
      ? `<span class="ew-badge ew-badge-ok" style="font-family:var(--font-mono);font-size:9px">✓ Tracker</span>`
      : `<button class="ew-btn ew-btn-ghost" data-tracker="${a.id}" data-source="${escHtml(a.source_name||'')}" data-date="${a.published_at||''}" data-title="${escHtml(a.title||'')}" data-synthese="${escHtml(a.reminder_text||'')}" data-type="${a.impact_type||'info'}" data-url="${escHtml(a.original_url||'')}">+ Tracker</button>`;

    const pubBtn = a.pub_added
      ? `<span class="ew-badge ew-badge-ok" style="font-family:var(--font-mono);font-size:9px">✓ Pub</span>`
      : `<button class="ew-btn ew-btn-ghost" data-pub="${a.id}" data-source="${escHtml(a.source_name||'')}" data-date="${a.published_at||''}" data-title="${escHtml(a.title||'')}" data-url="${escHtml(a.original_url||'')}">+ Pub</button>`;

    const impactRow = (a.has_impact && a.impacted_procedures?.length)
      ? `<div style="display:flex;align-items:center;gap:6px;margin-top:16px;flex-wrap:wrap" onclick="event.stopPropagation()">
          <span style="font-size:11px;color:#888">Impacte →</span>
          ${a.impacted_procedures.map((p: string) => `<span style="font-size:11px;font-weight:500;color:#5C6347" title="${escHtml(p)}">${escHtml(procLabel(p))}</span>`).join(' · ')}
          <a href="${BASE}controle" style="font-size:11px;color:#5C6347;text-decoration:underline;margin-left:auto" onclick="event.stopPropagation()">Voir reminder</a>
        </div>` : '';

    const newBadge = a.status === 'nouveau'
      ? `<span class="tag-new-right">Nouveau</span>` : '';

    return `
      <div class="ew-item${isIgnored ? ' is-ignored' : ''}" data-article-nav="${a.id}" style="cursor:pointer">
        ${sourceAvatarHTML(a.source_name)}
        <div class="ew-item-body">
          <div class="ew-meta">
            <span class="src">${escHtml(a.source_name || 'Source inconnue')}</span>
            <span class="dot">·</span>
            <span class="date">${displayDate(a)}</span>
            ${a.impact_type ? `<span class="dot">·</span><span style="font-size:9px;font-weight:500;letter-spacing:0.12em;color:var(--taupe)">${escHtml(impactLabel(a.impact_type)).toUpperCase()}</span>` : ''}
          </div>
          <h3 class="ew-title">
            ${a.original_url
              ? `<a href="${escHtml(a.original_url)}" target="_blank" rel="noopener" style="color:inherit;text-decoration:none" onclick="event.stopPropagation()">${escHtml(a.title || 'Sans titre')}${LINK_ICON}</a>`
              : escHtml(a.title || 'Sans titre')
            }
          </h3>
          ${impactRow}
          <div class="ew-actions" style="margin-top:16px">
            <button class="ew-btn ew-btn-primary${qClass}" data-triage="${a.id}" data-triage-status="quotidien">Quotidien${a.status === 'quotidien' ? ` <span class="triage-reset" data-reset="${a.id}">×</span>` : ''}</button>
            <button class="ew-btn${hClass}" data-triage="${a.id}" data-triage-status="hebdo">Hebdo${a.status === 'hebdo' ? ` <span class="triage-reset" data-reset="${a.id}">×</span>` : ''}</button>
            <div class="ew-act-sep"></div>
            ${trackerBtn}
            <div class="ew-act-sep"></div>
            ${pubBtn}
            <div class="ew-act-sep"></div>
            <button class="ew-btn ew-btn-ghost${a.status === 'ignorer' ? ' ew-btn-active' : ''}" data-triage="${a.id}" data-triage-status="ignorer">Ignorer</button>
          </div>
        </div>
        <div class="ew-item-side">${newBadge}</div>
      </div>`;
  }

  // ── Triage ───────────────────────────────────────────────────────────────

  const LIFECYCLE_MAP: Record<string, string> = {
    nouveau: 'inbox', important: 'inbox', relu: 'inbox',
    quotidien: 'triaged', hebdo: 'triaged',
    ignorer: 'ignored', archive: 'published',
  };

  async function triage(id: string, status: string): Promise<void> {
    try {
      await api(`/api/v1/articles/${id}/triage`, { method: 'PATCH', body: { status } });
      const idx = articles.findIndex((a: any) => a.id === id);
      if (idx !== -1) {
        articles[idx].status = status;
        articles[idx].lifecycle_status = LIFECYCLE_MAP[status] || articles[idx].lifecycle_status;
      }
      renderTabs(); renderArticles();
      const label = status === 'quotidien' ? 'Article — Quotidien' : status === 'hebdo' ? 'Article — Hebdo' : 'Article ignoré';
      toast(label);
    } catch (e: any) { toast(e.message, 'error'); }
  }

  // ── Right panel ──────────────────────────────────────────────────────────

  function renderRightPanel(): void {
    const nc: any = newsletterCounts;
    const qTotal = nc?.quotidien_total || 0;
    const qPub   = nc?.quotidien_published || 0;
    const hTotal = nc?.hebdo_total || 0;
    const hPub   = nc?.hebdo_published || 0;
    const canClose = (qTotal + hTotal) > 0;

    const digestSection = nc ? `
      <div>
        <div class="ew-r-title">Digest</div>
        <div class="ew-digest-block">
          <div class="ew-digest-label">Quotidien</div>
          <div class="ew-digest-num"><span class="accent">${qPub}</span><span class="total"> / ${qTotal}</span></div>
          <div class="ew-digest-actions">
            <button class="ew-digest-btn" data-copy-md="quotidien">Copier</button>
            <button class="ew-digest-btn" id="btn-apercu-quotidien" ${qTotal === 0 ? 'disabled style="opacity:.4"' : ''}>Aperçu</button>
          </div>
        </div>
        <div class="ew-digest-block">
          <div class="ew-digest-label">Hebdo</div>
          <div class="ew-digest-num"><span class="accent">${hPub}</span><span class="total"> / ${hTotal}</span></div>
          <div class="ew-digest-actions">
            <button class="ew-digest-btn" data-copy-md="hebdo">Copier</button>
            <button class="ew-digest-btn" id="btn-apercu-hebdo" ${hTotal === 0 ? 'disabled style="opacity:.4"' : ''}>Aperçu</button>
          </div>
        </div>
        <button class="ew-close" id="btn-publish-all" ${!canClose ? 'disabled style="opacity:.4"' : ''}>Archiver la sélection</button>
        <div class="ew-close-note">Archive tous les articles triagés. Compteurs remis à 0.</div>
      </div>` : `
      <div>
        <div class="ew-r-title">Digest</div>
        <div style="font-size:12px;color:var(--mute)">Newsletter non activée.</div>
      </div>`;

    const trackerSection = trackerPendingCount > 0 ? `
      <div>
        <div class="ew-r-title">Tracker</div>
        <div class="ew-tracker-num">${trackerPendingCount}</div>
        <div class="ew-tracker-desc">article${trackerPendingCount > 1 ? 's' : ''} éligible${trackerPendingCount > 1 ? 's' : ''} non ajouté${trackerPendingCount > 1 ? 's' : ''} au tracker réglementaire.</div>
      </div>` : `
      <div>
        <div class="ew-r-title">Tracker</div>
        <div style="font-size:12px;color:var(--mute)">Aucun article en attente.</div>
      </div>`;

    document.getElementById('sidebar-right')!.innerHTML = `
      ${digestSection}
      <div class="ew-divider"></div>
      ${trackerSection}
      <div class="ew-divider"></div>
      <div>
        <div class="ew-r-title">Export</div>
        <div class="ew-export-list">
          <div class="ew-export-item" data-export="markdown" data-export-type="quotidien" style="cursor:pointer"><span>Quotidien</span><span class="ext">.md</span></div>
          <div class="ew-export-item" data-export="markdown" data-export-type="hebdo" style="cursor:pointer"><span>Hebdo</span><span class="ext">.md</span></div>
          <div class="ew-export-item" id="btn-export-monthly" style="cursor:pointer"><span>Mensuel</span><span class="ext">.md</span></div>
        </div>
      </div>`;

    // Bind
    document.querySelectorAll('[data-copy-md]').forEach((el: any) => {
      el.addEventListener('click', () => copyMarkdownToClipboard(el.dataset.copyMd, el));
    });
    document.querySelectorAll('[data-export]').forEach((el: any) => {
      el.addEventListener('click', () => exportArticles(el.dataset.export, el.dataset.exportType));
    });
    document.getElementById('btn-apercu-quotidien')?.addEventListener('click', () => openApercu('quotidien'));
    document.getElementById('btn-apercu-hebdo')?.addEventListener('click', () => openApercu('hebdo'));

    const publishAllBtn = document.getElementById('btn-publish-all');
    if (publishAllBtn) {
      publishAllBtn.addEventListener('click', () => {
        const triaged = articles.filter((a: any) => a.lifecycle_status === 'triaged');
        if (!triaged.length) return;
        if (trackerPendingCount > 0) {
          document.getElementById('cloturer-msg')!.textContent =
            `${trackerPendingCount} article${trackerPendingCount > 1 ? 's' : ''} éligible${trackerPendingCount > 1 ? 's' : ''} n'${trackerPendingCount > 1 ? 'ont' : 'a'} pas été ajouté${trackerPendingCount > 1 ? 's' : ''} au tracker.`;
          const ov = document.getElementById('cloturer-overlay')!;
          ov.style.display = 'flex';
        } else {
          executePublishAll();
        }
      });
    }

    document.getElementById('cloturer-cancel')?.addEventListener('click', () => {
      document.getElementById('cloturer-overlay')!.style.display = 'none';
    });
    document.getElementById('cloturer-overlay')?.addEventListener('click', (e: Event) => {
      if (e.target === e.currentTarget) (e.currentTarget as HTMLElement).style.display = 'none';
    });
    document.getElementById('cloturer-confirm')?.addEventListener('click', () => {
      document.getElementById('cloturer-overlay')!.style.display = 'none';
      executePublishAll();
    });

    const exportMonthlyBtn = document.getElementById('btn-export-monthly');
    if (exportMonthlyBtn) {
      exportMonthlyBtn.addEventListener('click', async () => {
        const now = new Date();
        let year = now.getFullYear(), month = now.getMonth() + 1;
        if (now.getDate() < 5) { month--; if (month === 0) { month = 12; year--; } }
        const monthStr = `${year}-${String(month).padStart(2, '0')}`;
        (exportMonthlyBtn as any).style.opacity = '.5';
        try {
          const md = await api(`/api/v1/articles/monthly-recap/markdown?month=${monthStr}`);
          const blob = new Blob([md as string], { type: 'text/markdown;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url; a.download = `early-brief-recap-${monthStr}.md`; a.click();
          URL.revokeObjectURL(url);
          toast(`Récap ${monthStr} exporté`);
        } catch (e: any) { toast(e.message || 'Erreur export', 'error'); }
        (exportMonthlyBtn as any).style.opacity = '1';
      });
    }
  }

  async function executePublishAll(): Promise<void> {
    const btn = document.getElementById('btn-publish-all') as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.textContent = 'Publication...'; }
    try {
      const res: any = await api('/api/v1/articles/publish-all', { method: 'POST', body: {} });
      articles.filter((a: any) => a.lifecycle_status === 'triaged').forEach((a: any) => {
        const idx = articles.findIndex((x: any) => x.id === a.id);
        if (idx !== -1) { articles[idx].published_to_newsletter = true; articles[idx].lifecycle_status = 'published'; }
      });
      newsletterCounts = await api('/api/v1/articles/newsletter/counts').catch(() => newsletterCounts);
      const tc: any = await api('/api/v1/tracker/pending-count').catch(() => ({ pending: 0 }));
      trackerPendingCount = tc?.pending || 0;
      renderArticles(); renderRightPanel();
      toast(`${res.published || 0} article${(res.published||0) > 1 ? 's' : ''} publiés — session clôturée`);
    } catch (e: any) {
      toast('Erreur: ' + (e.message || 'publication échouée'), 'error');
      if (btn) { btn.disabled = false; btn.textContent = 'Archiver la sélection'; }
    }
  }

  // ── Aperçu drag & drop ───────────────────────────────────────────────────

  let apercuOrder: any[] = [];
  let apercuType = 'hebdo';
  let dragIdx = -1;

  async function openApercu(type: string): Promise<void> {
    apercuType = type;
    const overlay = document.getElementById('apercu-overlay')!;
    overlay.style.display = 'flex';
    document.getElementById('apercu-title')!.textContent = `Aperçu ${type === 'quotidien' ? 'Quotidien' : 'Hebdo'}`;
    // Affiche un loader pendant le fetch — évite d'afficher une liste vide
    document.getElementById('apercu-list')!.innerHTML =
      '<div style="padding:30px;text-align:center;color:var(--taupe);font-size:13px">Chargement…</div>';
    document.getElementById('apercu-close')!.onclick = closeApercu;
    document.getElementById('apercu-cancel')!.onclick = closeApercu;
    document.getElementById('apercu-export')!.onclick = exportApercuOrder;
    try {
      // Appel API : retourne tous les articles triagés (y compris lifecycle='published')
      // au lieu de filtrer l'array local qui n'inclut que inbox+triaged.
      const data: any = await api(`/api/v1/articles/export?type=${type}`);
      apercuOrder = Array.isArray(data) ? data : (data?.items || []);
      renderApercuList();
    } catch (e: any) {
      document.getElementById('apercu-list')!.innerHTML =
        '<div style="padding:30px;text-align:center;color:var(--rouge);font-size:13px">Erreur de chargement</div>';
    }
  }

  function closeApercu(): void {
    document.getElementById('apercu-overlay')!.style.display = 'none';
  }

  function renderApercuList(): void {
    const list = document.getElementById('apercu-list')!;
    if (!apercuOrder.length) {
      list.innerHTML = '<div style="padding:30px;text-align:center;color:var(--taupe);font-size:13px">Aucun article</div>';
      return;
    }
    list.innerHTML = apercuOrder.map((a: any, i: number) => `
      <div class="apercu-item" draggable="true" data-apercu-idx="${i}" style="display:flex;align-items:center;gap:12px;padding:10px 12px;margin-bottom:6px;background:var(--bg);border:0.5px solid var(--line-strong);border-radius:6px;cursor:grab">
        <span style="color:var(--mute);font-size:16px;user-select:none">⠇</span>
        <span style="font-family:var(--font-mono);font-size:11px;color:var(--mute);width:18px;flex-shrink:0">${i + 1}</span>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:500;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escHtml(a.title||'Sans titre')}</div>
          <div style="font-size:11px;color:var(--taupe);margin-top:2px">${escHtml(a.source_name||'')} · ${displayDate(a)}</div>
        </div>
      </div>`).join('');

    list.querySelectorAll('.apercu-item').forEach((el: any) => {
      el.addEventListener('dragstart', (e: DragEvent) => { dragIdx = +el.dataset.apercuIdx; el.style.opacity = '.5'; e.dataTransfer!.effectAllowed = 'move'; });
      el.addEventListener('dragend', () => { el.style.opacity = '1'; list.querySelectorAll('.apercu-item').forEach((x: any) => x.style.border = '0.5px solid var(--line-strong)'); });
      el.addEventListener('dragover', (e: DragEvent) => { e.preventDefault(); el.style.border = '1px dashed var(--moutarde)'; });
      el.addEventListener('dragleave', () => { el.style.border = '0.5px solid var(--line-strong)'; });
      el.addEventListener('drop', (e: DragEvent) => {
        e.preventDefault();
        const dropIdx = +el.dataset.apercuIdx;
        if (dragIdx !== dropIdx && dragIdx >= 0) {
          const item = apercuOrder.splice(dragIdx, 1)[0];
          apercuOrder.splice(dropIdx, 0, item);
          renderApercuList();
        }
      });
    });
  }

  async function exportApercuOrder(): Promise<void> {
    const label = apercuType === 'quotidien' ? 'Quotidien' : 'Hebdo';
    const today = new Date().toLocaleDateString('fr-FR');
    const lines = [`# Early Watch ${label} — ${today}`, ''];
    apercuOrder.forEach((a: any, i: number) => {
      const pub = a.published_at ? new Date(a.published_at).toLocaleDateString('fr-FR') : 'Date inconnue';
      lines.push(`## ${i + 1}. ${a.title}`, '');
      if (a.summary) { lines.push(a.summary, ''); }
      lines.push(`**Source :** ${a.source_name||'Source inconnue'} — ${pub}`);
      lines.push(`**Lien :** ${a.original_url||'N/A'}`, '', '---', '');
    });
    const blob = new Blob([lines.join('\n')], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url; link.download = `earlywatch-${apercuType}-${new Date().toISOString().slice(0,10)}.md`; link.click();
    URL.revokeObjectURL(url);
    closeApercu(); toast('Export téléchargé');
  }

  // ── Copy & Export ─────────────────────────────────────────────────────────

  async function copyMarkdownToClipboard(type: string, btn: HTMLButtonElement): Promise<void> {
    try {
      const data: any = await api(`/api/v1/articles/export/markdown?type=${type}`);
      await navigator.clipboard.writeText(typeof data === 'string' ? data : JSON.stringify(data, null, 2));
      const orig = btn.textContent;
      btn.textContent = '✓ Copié !';
      setTimeout(() => { btn.textContent = orig; }, 2000);
    } catch (e: any) { toast(e.message || 'Erreur de copie', 'error'); }
  }

  async function exportArticles(format: string, type?: string): Promise<void> {
    try {
      let path = format === 'markdown' ? '/api/v1/articles/export/markdown' : '/api/v1/articles/export';
      if (type) path += `?type=${type}`;
      const data: any = await api(path);
      const blob = new Blob([typeof data === 'string' ? data : JSON.stringify(data, null, 2)], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `earlywatch-export${type ? '-' + type : ''}.${format === 'markdown' ? 'md' : 'json'}`; a.click();
      URL.revokeObjectURL(url);
      toast('Export téléchargé');
    } catch (e: any) { toast(e.message || 'Erreur export', 'error'); }
  }

  // ── Tracker drawer ────────────────────────────────────────────────────────

  let trackerArticleId: string | null = null;

  document.addEventListener('click', (e: Event) => {
    const btn = (e.target as HTMLElement).closest('[data-tracker]') as HTMLElement | null;
    if (!btn) return;
    trackerArticleId = btn.dataset.tracker!;
    (document.getElementById('tracker-source') as HTMLInputElement).value = btn.dataset.source || '';
    (document.getElementById('tracker-date') as HTMLInputElement).value = btn.dataset.date ? btn.dataset.date.slice(0,10) : '';
    (document.getElementById('tracker-sujet') as HTMLInputElement).value = btn.dataset.title || '';
    (document.getElementById('tracker-synthese') as HTMLTextAreaElement).value = btn.dataset.synthese || '';
    (document.getElementById('tracker-lien') as HTMLInputElement).value = btn.dataset.url || '';
    (document.getElementById('tracker-statut') as HTMLInputElement).value = 'Publié';
    const typeMap: Record<string, string> = { nouvelle_regle: 'TEXTE', mise_a_jour: 'TEXTE', sanction: 'DECISION', appel_vigilance: 'CONSULTATION', info: 'TEXTE' };
    (document.getElementById('tracker-type') as HTMLSelectElement).value = typeMap[btn.dataset.type||''] || 'TEXTE';
    document.getElementById('tracker-overlay')!.style.display = 'flex';
  });

  document.getElementById('tracker-close')?.addEventListener('click', () => { document.getElementById('tracker-overlay')!.style.display = 'none'; });
  document.getElementById('tracker-cancel')?.addEventListener('click', () => { document.getElementById('tracker-overlay')!.style.display = 'none'; });
  document.getElementById('tracker-overlay')?.addEventListener('click', (e: Event) => {
    if (e.target === e.currentTarget) (e.currentTarget as HTMLElement).style.display = 'none';
  });

  document.getElementById('tracker-confirm')?.addEventListener('click', async () => {
    const body = {
      source:   (document.getElementById('tracker-source') as HTMLInputElement).value,
      date:     (document.getElementById('tracker-date') as HTMLInputElement).value,
      sujet:    (document.getElementById('tracker-sujet') as HTMLInputElement).value,
      synthese: (document.getElementById('tracker-synthese') as HTMLTextAreaElement).value,
      type:     (document.getElementById('tracker-type') as HTMLSelectElement).value,
      lien:     (document.getElementById('tracker-lien') as HTMLInputElement).value,
      statut:   (document.getElementById('tracker-statut') as HTMLInputElement).value,
    };
    try {
      const res: any = await api(`/api/v1/tracker/propose?article_id=${trackerArticleId}`, { method: 'POST', body });
      if (res.success) {
        const idx = articles.findIndex((a: any) => a.id === trackerArticleId);
        if (idx !== -1) articles[idx].tracker_added = true;
        document.getElementById('tracker-overlay')!.style.display = 'none';
        const tc: any = await api('/api/v1/tracker/pending-count').catch(() => ({ pending: 0 }));
        trackerPendingCount = tc?.pending || 0;
        renderArticles(); renderRightPanel();
        toast('Article ajouté au Tracker');
      } else { toast('Erreur tracker', 'error'); }
    } catch (err: any) { toast('Erreur: ' + err.message, 'error'); }
  });

  document.addEventListener('click', async (e: Event) => {
    const btn = (e.target as HTMLElement).closest('[data-pub]') as HTMLElement | null;
    if (!btn) return;
    e.stopPropagation();
    const articleId = btn.dataset.pub!;
    const article = articles.find((a: any) => a.id === articleId);
    try {
      await api(`/api/v1/tracker/pub/propose?article_id=${articleId}`, {
        method: 'POST',
        body: {
          date: article?.published_at ? article.published_at.slice(0, 10) : '',
          source: article?.source_name || '',
          type: 'Intelligence',
          titre: article?.title || '',
          lien: article?.original_url || '',
        },
      });
      const idx = articles.findIndex((a: any) => a.id === articleId);
      if (idx !== -1) articles[idx].pub_added = true;
      renderArticles(); renderRightPanel();
      toast('Ajouté aux autres publications');
    } catch (err: any) { toast('Erreur: ' + err.message, 'error'); }
  });

  // ── Utils ─────────────────────────────────────────────────────────────────

  function escHtml(s: string): string {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  bootstrapAuth();
  init();
</script>

<style is:global>
  /* Slide-in animation pour les drawers */
  @keyframes ew-slide-in {
    from { transform: translateX(100%); }
    to   { transform: translateX(0); }
  }

  /* Reset triage — ✕ dans le bouton actif */
  .triage-reset {
    color: var(--mute);
    font-size: 10px;
    margin-left: 3px;
    cursor: pointer;
    transition: color 0.1s;
  }
  .triage-reset:hover { color: var(--ink); }

  /* Badge tracker/pub confirmé */
  .ew-badge-ok {
    background: var(--bg-hover);
    color: var(--taupe);
    border: 0.5px solid var(--line-strong);
    padding: 2px 8px;
    border-radius: 2px;
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  /* Textarea dans les drawers */
  .ew-textarea { resize: vertical; min-height: 72px; }

  /* Scrollbar gutter pour les listes longues */
  #ew-list { scrollbar-gutter: stable; }

  /* Les overlays sont contrôlés uniquement par JS (style.display = 'flex'/'none') */
  #apercu-overlay { display: none; }
  #cloturer-overlay { display: none; }
  #tracker-overlay { display: none; }
</style>

<!-- ── Sélecteur vue client (superadmin uniquement) ── -->
<script>
  import { getUser, api, startImpersonation } from '../scripts/api';
  import { bootstrapAuth } from '../scripts/bootstrap-auth';
  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';

  async function initDemoButton() {
    const user = getUser();
    if (!user || user.role !== 'superadmin') return;

    const btn = document.getElementById('btn-demo-client') as HTMLButtonElement;
    if (!btn) return;
    btn.style.display = 'inline-block';

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Chargement…';
      try {
        // Trouver le tenant Demo PSP
        const { tenants } = await api('/api/v1/admin/tenants');
        const demo = (tenants as any[]).find((t: any) => t.name === 'Demo PSP');
        if (!demo) { alert('Tenant Demo PSP introuvable. Lancez setup_demo_psp.py d\'abord.'); return; }

        // Obtenir le token d'impersonation
        const result = await api('/api/v1/admin/impersonate', {
          method: 'POST',
          body: { tenant_id: demo.id },
        });
        startImpersonation(result.access_token, result.user);
        window.location.href = BASE + 'app/tableau-de-bord';
      } catch (e: any) {
        alert('Erreur : ' + e.message);
        btn.disabled = false;
        btn.textContent = 'Voir comme client Demo PSP →';
      }
    });
  }

  bootstrapAuth();
  initDemoButton();
</script>
