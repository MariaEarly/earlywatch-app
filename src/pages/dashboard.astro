    color: #1A1918;
  }

  /* Tracker button & drawer */
  .action-sep { color: #B0ADA7; margin: 0 4px; font-size: 12px; }

  .btn-tracker {
    /* Inherits from .btn .btn-sm .btn-triage via HTML classes */
