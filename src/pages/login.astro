---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Early Watch — Connexion">
  <form id="login-form">
    <label for="email">Email</label>
    <input type="email" id="email" autocomplete="email" required>
    <label for="password">Mot de passe</label>
    <div class="pwd-wrapper">
      <input type="password" id="password" autocomplete="current-password" required>
      <button type="button" class="pwd-toggle" id="pwd-eye" aria-label="Afficher le mot de passe">
        <svg id="eye-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        <svg id="eye-closed" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
      </button>
    </div>
    <div class="auth-error" id="err">Email ou mot de passe incorrect.</div>
    <button type="submit" class="auth-btn" id="btn">Se connecter</button>
  </form>
  <div class="auth-footer">
    <a href={`${import.meta.env.BASE_URL}forgot-password`}>Mot de passe oublié ?</a>
    &nbsp;&middot;&nbsp;
    <a href="mailto:maria@early.consulting">Besoin d'accès ?</a>
  </div>

  <script>
    import { API, getToken } from '../scripts/api';

    const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';

    // Already logged in?
    const t = sessionStorage.getItem('ew_token');
    if (t) {
      fetch(`${API}/api/v1/auth/me`, { headers: { 'Authorization': `Bearer ${t}` } })
        .then(r => { if (r.ok) return r.json(); throw 0; })
        .then(u => { window.location.href = BASE + (u.role === 'superadmin' ? 'superadmin' : 'conformite'); })
        .catch(() => {});
    }

    // Password eye toggle
    const pwdEye = document.getElementById('pwd-eye');
    const pwdInput = document.getElementById('password') as HTMLInputElement;
    const eyeOpen = document.getElementById('eye-open');
    const eyeClosed = document.getElementById('eye-closed');
    pwdEye?.addEventListener('click', () => {
      const show = pwdInput.type === 'password';
      pwdInput.type = show ? 'text' : 'password';
      if (eyeOpen) eyeOpen.style.display = show ? 'none' : 'block';
      if (eyeClosed) eyeClosed.style.display = show ? 'block' : 'none';
    });

    document.getElementById('login-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn') as HTMLButtonElement;
      const err = document.getElementById('err')!;
      const email = document.getElementById('email') as HTMLInputElement;
      const pwd = document.getElementById('password') as HTMLInputElement;

      email.classList.remove('error');
      pwd.classList.remove('error');
      err.classList.remove('show');
      btn.disabled = true;
      btn.innerHTML = '<span class="auth-spinner"></span>Connexion\u2026';

      try {
        const r = await fetch(`${API}/api/v1/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email.value.trim(), password: pwd.value }),
        });

        if (!r.ok) {
          const d = await r.json().catch(() => ({}));
          throw new Error(d.detail || 'Identifiants incorrects');
        }

        const d = await r.json();
        sessionStorage.setItem('ew_token', d.access_token);
        sessionStorage.setItem('ew_user', JSON.stringify(d.user));
        window.location.href = BASE + (d.user?.role === 'superadmin' ? 'superadmin' : 'conformite');

      } catch (ex: any) {
        email.classList.add('error');
        pwd.classList.add('error');
        err.textContent = ex.message || 'Erreur de connexion';
        err.classList.add('show');
        btn.disabled = false;
        btn.textContent = 'Se connecter';
      }
    });
  </script>
</AuthLayout>
