---
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import '../styles/design-tokens.css';
import '../styles/components.css';

interface Props {
  title: string;
  activePage?: string;
  /**
   * '2col' (défaut) : sidebar 220px + main 1fr  — toutes les pages sauf dashboard
   * '3col'          : sidebar 220px + main 1fr + panel 300px — dashboard inbox uniquement
   */
  layout?: '2col' | '3col';
}

const { title, activePage = '', layout = '2col' } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
</head>
<body>
  <div class={layout === '3col' ? 'ew-frame' : 'ew-frame-2col'}>
    <Nav activePage={activePage} />
    <main class="ew-main" id="ew-main">
      <slot />
    </main>
    {layout === '3col' && <slot name="right" />}
  </div>
  <div class="ew-toast-container" id="toast-container"></div>

  <script>
    import { requireAuth } from '../scripts/api';
    if (!requireAuth()) throw new Error('redirect');
  </script>
</body>
</html>
