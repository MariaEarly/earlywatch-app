---
import '../styles/design-tokens.css';
import '../styles/components.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
</head>
<body>
  <div class="ew-login-page">
    <div class="ew-login-wrap">
      <div class="ew-login-logo">Early <span>Watch</span></div>
      <slot />
    </div>
  </div>
</body>
</html>
