---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      font-family: 'IBM Plex Sans', sans-serif;
      background: #EDEAE3; color: #1A1918;
      display: flex; align-items: center; justify-content: center;
      min-height: 100vh; padding: 24px;
    }
    .auth-card { width: 100%; max-width: 340px; }
    .auth-brand {
      font-size: 13px; font-weight: 400; color: #1A1918;
      margin-bottom: 36px; text-align: center;
    }
    .auth-brand span { font-weight: 500; color: #5C6347; }
    .auth-subtitle {
      font-size: 13px; color: #8C8880; text-align: center;
      margin-bottom: 32px; line-height: 1.6;
    }
    .auth-card label {
      display: block; font-size: 13px; font-weight: 400;
      color: #8C8880; margin-bottom: 6px;
    }
    .auth-card input {
      width: 100%; padding: 11px 0;
      border: none; border-bottom: 1px solid #D5D2CB;
      background: transparent;
      font-size: 15px; font-family: inherit; color: #1A1918;
      outline: none; margin-bottom: 24px; transition: border-color .15s;
      border-radius: 0;
    }
    .auth-card input:focus { border-color: #5C6347; }
    .auth-card input.error { border-color: #DC2626; margin-bottom: 6px; }
    /* Chrome autofill fix */
    .auth-card input:-webkit-autofill,
    .auth-card input:-webkit-autofill:hover,
    .auth-card input:-webkit-autofill:focus {
      -webkit-box-shadow: 0 0 0 1000px #EDEAE3 inset !important;
      -webkit-text-fill-color: #1A1918 !important;
      transition: background-color 5000s ease-in-out 0s;
    }
    /* Password toggle */
    .pwd-wrapper { position: relative; }
    .pwd-wrapper input { width: 100%; padding-right: 36px; }
    .pwd-toggle {
      position: absolute; right: 0; top: 50%; transform: translateY(-70%);
      background: none; border: none; cursor: pointer; padding: 4px;
      color: #8C8880; font-size: 18px; line-height: 1;
    }
    .pwd-toggle:hover { color: #1A1918; }
    .auth-btn {
      width: 100%; padding: 13px;
      background: #5C6347; color: #fff;
      border: none; border-radius: 4px;
      font-size: 14px; font-weight: 500;
      font-family: inherit; cursor: pointer;
      transition: opacity .15s; margin-top: 8px;
    }
    .auth-btn:hover { opacity: .85; }
    .auth-btn:disabled { opacity: .5; cursor: not-allowed; }
    .auth-error {
      font-size: 12px; color: #DC2626;
      margin-bottom: 16px; display: none;
    }
    .auth-error.show { display: block; }
    .auth-msg {
      font-size: 13px; text-align: center; margin-top: 16px;
      line-height: 1.6; display: none;
    }
    .auth-msg.success { display: block; color: #5C6347; }
    .auth-msg.error { display: block; color: #DC2626; }
    .auth-footer {
      margin-top: 24px; text-align: center;
      font-size: 12px; color: #8C8880;
    }
    .auth-footer a { color: #5C6347; text-decoration: none; }
    .auth-spinner {
      display: inline-block; width: 14px; height: 14px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: white; border-radius: 50%;
      animation: auth-spin .8s linear infinite; margin-right: 6px; vertical-align: middle;
    }
    @keyframes auth-spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div class="auth-card">
    <div class="auth-brand">Early <span style="font-weight:500">Watch</span></div>
    <slot />
  </div>
</body>
</html>
