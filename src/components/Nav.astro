---
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside class="ew-side">
  <a href={`${base}dashboard`} class="ew-logo">Early <span>Watch</span></a>

  <div class="ew-section">Veille</div>
  <a href={`${base}dashboard`} class:list={['ew-nav', { active: activePage === 'dashboard' }]}>
    <span>Inbox</span>
    <span id="nav-count-inbox" class="ew-count" style="display:none"></span>
  </a>
  <a href={`${base}archives`} class:list={['ew-nav', { active: activePage === 'archives' }]}>
    <span>Archives</span>
  </a>
  <a href={`${base}enforcement`} class:list={['ew-nav', { active: activePage === 'enforcement' }]}>
    <span>Sanctions</span>
  </a>

  <div class="ew-section">Conformité</div>
  <a href={`${base}conformite`} class:list={['ew-nav', { active: activePage === 'conformite' }]}>
    <span>Tableau de bord</span>
  </a>
  <a href={`${base}controle`} class:list={['ew-nav', { active: activePage === 'controle' }]}>
    <span>Contrôle</span>
    <span id="nav-badge-ctrl" class="ew-count" style="display:none"></span>
  </a>
  <a href={`${base}gap-analysis`} class:list={['ew-nav', { active: activePage === 'gap-analysis' }]}>
    <span>Analyse d'écart</span>
  </a>

  <div class="ew-section">Procédures</div>
  <a href={`${base}procedure`} class:list={['ew-nav', { active: activePage === 'procedure' }]}>
    <span>Générateur</span>
  </a>
  <a href={`${base}mes-procedures`} class:list={['ew-nav', { active: activePage === 'mes-procedures' }]}>
    <span>Mes procédures</span>
  </a>
  <a href={`${base}bibliotheque`} class:list={['ew-nav', { active: activePage === 'bibliotheque' }]}>
    <span>Bibliothèque</span>
  </a>

  <div class="ew-section">Référentiel</div>
  <a href={`${base}situations`} class:list={['ew-nav', { active: activePage === 'situations' }]}>
    <span>Fiches réflexes</span>
  </a>
  <a href={`${base}roadmap`} class:list={['ew-nav', { active: activePage === 'roadmap' }]}>
    <span>Feuille de route</span>
  </a>
  <a href={`${base}pays-risque`} class:list={['ew-nav', { active: activePage === 'pays-risque' }]}>
    <span>Pays à risque</span>
  </a>

  <div class="ew-user">
    <div id="nav-avatar" class="ew-avatar">?</div>
    <span id="nav-user-name" style="font-size:12px;color:var(--taupe)">Mon compte</span>
  </div>
  <a href={`${base}settings`} class:list={['ew-settings-link', { active: activePage === 'settings' }]}>
    Paramètres
  </a>
</aside>

<script>
  import { getUser, loadReminderBadge } from '../scripts/api';

  function initNav() {
    const user = getUser();
    if (!user) return;

    // Avatar initiales
    const initials = (user.first_name?.[0] || '') + (user.last_name?.[0] || '');
    const avatarEl = document.getElementById('nav-avatar');
    if (avatarEl) avatarEl.textContent = initials || '?';

    // Nom affiché
    const nameEl = document.getElementById('nav-user-name');
    if (nameEl) {
      const name = [user.first_name, user.last_name].filter(Boolean).join(' ');
      nameEl.textContent = name || 'Mon compte';
    }

    // Badge rappels (Contrôle)
    loadReminderBadge();
  }

  function initNavBadges() {
    // Badge inbox — articles status=nouveau
    const inboxCount = document.getElementById('nav-count-inbox');
    if (inboxCount) {
      const stored = sessionStorage.getItem('ew_inbox_count');
      if (stored && stored !== '0') {
        inboxCount.textContent = stored;
        inboxCount.style.display = '';
      }
    }
  }

  initNav();
  initNavBadges();
  document.addEventListener('astro:after-swap', () => {
    initNav();
    initNavBadges();
  });
</script>
