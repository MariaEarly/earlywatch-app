---
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;
const base = import.meta.env.BASE_URL;

const primary = [
  { href: 'dashboard', label: 'Inbox' },
  { href: 'procedure', label: 'Procedures' },
  { href: 'controle', label: 'Controle', hasBadge: true },
  { href: 'bibliotheque', label: 'Bibliotheque' },
];

const secondary = [
  { href: 'conformite', label: 'Conformite' },
  { href: 'gap-analysis', label: 'Gap Analysis' },
  { href: 'mes-procedures', label: 'Mes Procedures' },
  { href: 'situations', label: 'Fiches Reflexes' },
  { href: 'roadmap', label: 'Roadmap' },
  { href: 'pays-risque', label: 'Pays a risque' },
  { href: 'settings', label: 'Parametres' },
];
---

<div class="header-wrap">
  <header class="header">
    <div class="flex items-center gap-24">
      <a href={`${base}dashboard`} class="logo">Early <span>Watch</span></a>
      <nav class="nav-primary">
        {primary.map(link => (
          <a
            href={`${base}${link.href}`}
            class:list={[{ active: activePage === link.href }]}
          >
            {link.label}
            {link.hasBadge && (
              <span id="nav-badge-ctrl" class="nav-badge" style="display:none"></span>
            )}
          </a>
        ))}
      </nav>
    </div>
    <div class="flex items-center gap-12">
      <span id="nav-tenant" class="badge badge-accent" style="display:none"></span>
      <a id="nav-avatar" href={`${base}account`} class="avatar" style="text-decoration:none">?</a>
    </div>
  </header>
  <nav class="header-sub">
    {secondary.map(link => (
      <a
        href={`${base}${link.href}`}
        class:list={[{ active: activePage === link.href }]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</div>

<script>
  import { getUser, loadReminderBadge } from '../scripts/api';

  function initNav() {
    const user = getUser();
    if (!user) return;

    const initials = (user.first_name?.[0] || '') + (user.last_name?.[0] || '');
    const avatar = document.getElementById('nav-avatar');
    if (avatar) {
      avatar.textContent = initials || '?';
      avatar.title = `${user.email || ''} — Mon compte`;
    }

    const tenant = document.getElementById('nav-tenant');
    if (tenant && user.tenant_id) {
      tenant.textContent = 'DEMO';
      tenant.style.display = 'inline-flex';
    }

    loadReminderBadge();
  }

  // Run on initial load and on Astro page transitions
  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
