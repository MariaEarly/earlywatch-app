---
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside class="sidebar-nav">
  <a href={`${base}dashboard`} class="sidebar-logo">Early <span>Watch</span></a>

  <div class="sidebar-section">Veille</div>
  <a href={`${base}dashboard`} class:list={['nav-item', { active: activePage === 'dashboard' }]}>Inbox</a>
  <a href={`${base}archives`} class:list={['nav-item', { active: activePage === 'archives' }]}>Archives</a>
  <a href={`${base}enforcement`} class:list={['nav-item', { active: activePage === 'enforcement' }]}>Sanctions</a>

  <div class="sidebar-section">Conformite</div>
  <a href={`${base}conformite`} class:list={['nav-item', { active: activePage === 'conformite' }]}>Tableau de bord</a>
  <a href={`${base}controle`} class:list={['nav-item', { active: activePage === 'controle' }]}>
    Controle
    <span id="nav-badge-ctrl" class="nav-badge-urgent" style="display:none"></span>
  </a>
  <a href={`${base}gap-analysis`} class:list={['nav-item', { active: activePage === 'gap-analysis' }]}>Gap Analysis</a>

  <div class="sidebar-section">Procedures</div>
  <a href={`${base}procedure`} class:list={['nav-item', { active: activePage === 'procedure' }]}>Generateur</a>
  <a href={`${base}mes-procedures`} class:list={['nav-item', { active: activePage === 'mes-procedures' }]}>Mes Procedures</a>
  <a href={`${base}bibliotheque`} class:list={['nav-item', { active: activePage === 'bibliotheque' }]}>Bibliotheque</a>

  <div class="sidebar-section">Referenciel</div>
  <a href={`${base}situations`} class:list={['nav-item', { active: activePage === 'situations' }]}>Fiches Reflexes</a>
  <a href={`${base}roadmap`} class:list={['nav-item', { active: activePage === 'roadmap' }]}>Roadmap</a>
  <a href={`${base}pays-risque`} class:list={['nav-item', { active: activePage === 'pays-risque' }]}>Pays a risque</a>

  <div class="sidebar-footer">
    <a href={`${base}settings`} class:list={['nav-item', { active: activePage === 'settings' }]} style="padding-left:0">
      Parametres
    </a>
    <a id="nav-avatar" href={`${base}account`} class="nav-item" style="padding-left:0;margin-top:4px">
      <span class="avatar" style="width:24px;height:24px;font-size:9px;margin-right:8px">?</span>
      <span id="nav-user-name" style="font-size:12px;color:var(--ew-text-muted)">Mon compte</span>
    </a>
  </div>
</aside>

<script>
  import { getUser, loadReminderBadge } from '../scripts/api';

  function initNav() {
    const user = getUser();
    if (!user) return;

    const initials = (user.first_name?.[0] || '') + (user.last_name?.[0] || '');
    const avatarSpan = document.querySelector('#nav-avatar .avatar');
    if (avatarSpan) avatarSpan.textContent = initials || '?';

    const nameSpan = document.getElementById('nav-user-name');
    if (nameSpan) {
      const name = [user.first_name, user.last_name].filter(Boolean).join(' ');
      nameSpan.textContent = name || 'Mon compte';
    }

    loadReminderBadge();
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
